# Docker Compose reads this file from the repository root.
DB_PASS=replace-with-the-current-mysql-root-password
DB_NAME=cotton
DB_HOST_PORT=3306
MYSQL_VOLUME_NAME=cotton_mysql_data

# Public servers must keep production. Use development only with an isolated
# local demo database.
APP_NODE_ENV=production
SEED_DEMO_DATA=false

# Direct development ports default to loopback-only. Set both bind addresses
# to 0.0.0.0 only on a trusted LAN when testing with a physical phone.
APP_HOST_BIND=127.0.0.1
APP_HOST_PORT=3000
COMMUNITY_HOST_BIND=127.0.0.1
COMMUNITY_HOST_PORT=3100

# Leave these blank when both services use the same public domain.
COMMUNITY_BASE_URL=
PLATFORM_BASE_URL=

# Local course uploads. Put large production videos in COS/OSS instead.
KNOWLEDGE_LOCAL_UPLOAD_MAX_MB=250

# 优棉金融棉花期货行情。默认使用新浪财经公开行情并明确提示可能延迟。
# 正式取得授权行情后可设为 custom，并让 HTTPS 接口返回 price、previousSettlement、
# open、high、low、contract、providerTime、source 等 JSON 字段。
FINANCE_QUOTE_PROVIDER=sina
FINANCE_QUOTE_URL=
FINANCE_QUOTE_SOURCE=

# Host paths mounted into the cotton-app container.
WECHAT_PAY_PRIVATE_KEY_HOST_PATH=./apiclient_key.pem
WECHAT_PAY_PUBLIC_KEY_HOST_PATH=./pub_key.pem

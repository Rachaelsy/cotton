# Copy this file to .env.development. The real file is ignored by Git.
DB_PASS=LocalCotton_2026_ChangeMe
DB_NAME=cotton
# Host port only; containers still connect to MySQL on db:3306.
DB_HOST_PORT=3307

APP_NODE_ENV=development
DEV_JWT_SECRET=LocalCottonDevelopmentJwtSecret_ChangeMe_AtLeast32Chars
SEED_DEMO_DATA=false

APP_HOST_BIND=127.0.0.1
APP_HOST_PORT=3000
COMMUNITY_HOST_BIND=127.0.0.1
COMMUNITY_HOST_PORT=3100

COMMUNITY_BASE_URL=
PLATFORM_BASE_URL=
KNOWLEDGE_LOCAL_UPLOAD_MAX_MB=250

WECHAT_PAY_PRIVATE_KEY_HOST_PATH=./apiclient_key.pem
WECHAT_PAY_PUBLIC_KEY_HOST_PATH=./pub_key.pem

.page{min-height:100vh;padding-bottom:54rpx;background:linear-gradient(180deg,#e9f4ee,#f4f7f5 520rpx);color:#173b2f}.hero{padding-right:28rpx;padding-bottom:34rpx;padding-left:28rpx;border-radius:0 0 44rpx 44rpx;background:radial-gradient(circle at 88% 16%,rgba(255,255,255,.16),transparent 27%),linear-gradient(145deg,#075d45,#11805d 70%,#359273);color:#fff;box-shadow:0 17rpx 40rpx rgba(7,91,67,.2)}.nav{display:flex;align-items:center}.nav button,.nav>view{width:72rpx;flex:none}.nav button{margin:0;padding:0;border:0;background:transparent;color:#fff;font-size:52rpx;line-height:64rpx}.nav button::after,.state-card button::after{border:0}.nav>text{flex:1;text-align:center;font-size:31rpx;font-weight:850}.title-row{display:flex;align-items:center;justify-content:space-between;margin-top:32rpx}.title-row>view:first-child{display:flex;min-width:0;flex-direction:column}.title-row>view:first-child small{color:rgba(255,255,255,.7);font-size:21rpx}.title-row>view:first-child text{margin-top:8rpx;font-size:43rpx;font-weight:900}.rank{display:flex;width:96rpx;height:96rpx;flex:none;align-items:center;justify-content:center;border:1rpx solid rgba(255,255,255,.23);border-radius:31rpx;background:rgba(255,255,255,.14);flex-direction:column}.rank strong{font-size:34rpx}.rank small{font-size:17rpx}.hero-score{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx;padding:19rpx 22rpx;border:1rpx solid rgba(255,255,255,.13);border-radius:23rpx;background:rgba(255,255,255,.1)}.hero-score>view{display:flex;align-items:baseline}.hero-score small{font-size:19rpx}.hero-score strong{margin-left:11rpx;font-size:31rpx}.hero-score>text{color:rgba(255,255,255,.7);font-size:18rpx}.section{margin:20rpx 22rpx 0;padding:25rpx;border:1rpx solid #e0e9e4;border-radius:28rpx;background:#fff;box-shadow:0 10rpx 30rpx rgba(25,70,53,.06)}.section-head{display:flex;align-items:center;justify-content:space-between}.section-head>view{display:flex;flex-direction:column}.section-head text{font-size:28rpx;font-weight:900}.section-head small{margin-top:5rpx;color:#89968f;font-size:19rpx}.metric-list{margin-top:22rpx}.metric{margin-top:20rpx}.metric:first-child{margin-top:0}.metric-top{display:flex;align-items:baseline;justify-content:space-between}.metric-top>text{font-size:22rpx;font-weight:750}.metric-top>view{display:flex;align-items:baseline}.metric-top strong{color:#106e4f;font-size:27rpx}.metric-top small{margin-left:4rpx;color:#6e7e76;font-size:17rpx}.metric-top label{margin-left:12rpx;color:#9a711f;font-size:18rpx}.track{height:10rpx;margin-top:9rpx;overflow:hidden;border-radius:999rpx;background:#e9f0ec}.track view{height:100%;border-radius:999rpx;background:linear-gradient(90deg,#51af88,#137655)}.weights{display:flex;flex-wrap:wrap;margin-top:20rpx}.weights text{margin:0 9rpx 9rpx 0;padding:8rpx 12rpx;border-radius:9rpx;background:#edf6f1;color:#356552;font-size:18rpx}.assessment-copy{display:block;margin-top:8rpx;color:#5d6f66;font-size:21rpx;line-height:1.75}.tag-list,.county-list{display:flex;flex-wrap:wrap;margin-top:19rpx}.tag-list text,.county-list text{margin:0 10rpx 10rpx 0;padding:9rpx 13rpx;border-radius:10rpx;background:#e8f5ee;color:#147453;font-size:19rpx}.copy-block{display:flex;margin-top:17rpx;padding-top:17rpx;border-top:1rpx solid #edf1ef;flex-direction:column}.copy-block strong{font-size:21rpx}.copy-block text,.notes{display:block;margin-top:7rpx;color:#5e7067;font-size:21rpx;line-height:1.75}.pending{display:flex;margin-top:19rpx;padding:21rpx;border-radius:18rpx;background:#f6f8f7;flex-direction:column}.pending strong{font-size:22rpx}.pending text{margin-top:7rpx;color:#718078;font-size:20rpx;line-height:1.7}.source{display:flex;margin:21rpx 22rpx 0;padding:23rpx;border:1rpx solid #e5dcc9;border-radius:22rpx;background:#fffbf2;flex-direction:column}.source strong{font-size:22rpx}.source text{margin-top:7rpx;color:#615848;font-size:20rpx}.source small{margin-top:9rpx;color:#837a69;font-size:18rpx;line-height:1.65}.state-
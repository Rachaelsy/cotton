.page{min-height:100vh;padding-bottom:54rpx;background:linear-gradient(180deg,#e9f4ee 0,#f4f7f5 520rpx);color:#173b2f}.hero{padding-right:28rpx;padding-bottom:31rpx;padding-left:28rpx;border-radius:0 0 44rpx 44rpx;background:radial-gradient(circle at 88% 16%,rgba(255,255,255,.16),transparent 26%),linear-gradient(145deg,#075d45,#11805d 68%,#379474);color:#fff;box-shadow:0 17rpx 40rpx rgba(7,91,67,.2)}.nav{display:flex;align-items:center}.nav button,.nav>view{width:72rpx;flex:none}.nav button{margin:0;padding:0;border:0;background:transparent;color:#fff;font-size:52rpx;line-height:64rpx}.nav button::after,.sort-tabs button::after,.state-card button::after{border:0}.nav>text{flex:1;text-align:center;font-size:31rpx;font-weight:850}.hero-copy{display:flex;align-items:center;justify-content:space-between;margin-top:30rpx}.hero-copy>view:first-child{display:flex;min-width:0;flex-direction:column}.hero-copy text{font-size:37rpx;font-weight:900;letter-spacing:1rpx}.hero-copy small{margin-top:9rpx;color:rgba(255,255,255,.75);font-size:22rpx}.hero-mark{display:flex;align-items:center;justify-content:center;width:84rpx;height:84rpx;flex:none;border:1rpx solid rgba(255,255,255,.24);border-radius:28rpx;background:rgba(255,255,255,.15);font-size:31rpx;font-weight:900}.hero-stats{display:flex;margin-top:28rpx;padding:18rpx 0;border:1rpx solid rgba(255,255,255,.14);border-radius:23rpx;background:rgba(255,255,255,.1)}.hero-stats>view{display:flex;flex:1;align-items:center;border-right:1rpx solid rgba(255,255,255,.15);flex-direction:column}.hero-stats>view:last-child{border-right:0}.hero-stats strong{font-size:29rpx}.hero-stats small{margin-top:4rpx;color:rgba(255,255,255,.68);font-size:19rpx}.search-box{display:flex;align-items:center;margin:20rpx 22rpx 0;padding:0 22rpx;border:1rpx solid #dfe9e3;border-radius:22rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(25,70,53,.06)}.search-box>text{color:#1d7658;font-size:34rpx}.search-box input{height:84rpx;min-width:0;flex:1;margin-left:
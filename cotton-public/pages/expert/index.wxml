<view class="page">
  <view class="exp-hero" style="padding-top: {{statusBarHeight}}px">
    <view class="exp-topbar" style="padding-right: {{capsuleSafeRight}}px">
      <view class="exp-back" bindtap="onBack"><text>‹</text></view>
      <view class="exp-title-wrap">
        <text class="exp-title">{{copy.title}}</text>
        <text class="exp-sub">{{copy.subtitle}}</text>
      </view>
      <view class="exp-ask" bindtap="onAskExpert"><text>{{copy.ask}}</text></view>
    </view>
    <text class="exp-slogan">{{copy.slogan}}</text>
    <view class="exp-stats">
      <text>{{experts.length}} {{copy.statsExperts}}</text>
      <text>{{allCourses.length}} {{copy.statsCourses}}</text>
      <text>{{copy.statsQa}}</text>
    </view>
  </view>

  <view class="lecture-tabs">
    <view class="lecture-tab {{activeLectureTab === 'qa' ? 'on' : ''}}" data-tab="qa" bindtap="onLectureTab"><text>精选问答</text><text class="lecture-count">{{qaContents.length}}</text></view>
    <view class="lecture-tab {{activeLectureTab === 'experts' ? 'on' : ''}}" data-tab="experts" bindtap="onLectureTab"><text>在线专家</text><text class="lecture-count">{{experts.length}}</text></view>
    <view class="lecture-tab {{activeLectureTab === 'video' ? 'on' : ''}}" data-tab="video" bindtap="onLectureTab"><text>精选视频</text><text class="lecture-count">{{videoContents.length}}</text></view>
  </view>

  <scroll-view class="exp-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="notice-card">专家内容加载中...</view>
    <view wx:if="{{loadError}}" class="notice-card weak">{{loadError}}</view>

    <view wx:if="{{activeLectureTab === 'qa'}}" class="lecture-panel">
      <view class="ask-banner" bindtap="onAskExpert"><view><text class="ask-title">有生产问题，向专家提问</text></view><text class="ask-action">去提问 ›</text></view>
      <view class="qa-list">
        <view class="qa-item" wx:for="{{qaContents}}" wx:key="id" bindtap="onCourseTap" data-id="{{item.id}}">
          <view class="qa-mark">问</view><view class="qa-main"><text class="qa-title">{{item.title}}</text><text class="qa-answer">{{item.intro || item.content}}</text><view class="qa-meta"><text>{{item.teacher}}</text><text>{{item.category}}</text><text>查看解答 ›</text></view></view>
        </view>
        <view wx:if="{{!loading && !qaContents.length}}" class="empty-state"><text class="empty-icon">问</text><text class="empty-title">暂无精选问答</text><text class="empty-desc">管理员发布后会显示在这里</text></view>
      </view>
      <view class="my-question-wrap" wx:if="{{myQuestions.length}}">
        <view class="section-head"><text class="section-title">我的提问</text><text class="section-more" bindtap="loadMyQuestions">刷新</text></view>
        <view class="question-card" wx:for="{{myQuestions}}" wx:key="id"><view class="question-row"><text class="question-category">{{item.category}}</text><text class="question-status status-{{item.status}}">{{item.statusLabel}}</text></view><text class="question-text">{{item.question}}</text><view class="answer-box" wx:if="{{item.reply}}"><text class="answer-label">专家回复</text><text class="answer-text">{{item.reply}}</text></view></view>
      </view>
    </view>

    <view wx:if="{{activeLectureTab === 'experts'}}" class="lecture-panel expert-list">
      <view class="expert-list-card" wx:for="{{experts}}" wx:key="id" bindtap="onExpertTap" data-id="{{item.id}}">
        <image wx:if="{{item.avatarUrl}}" class="expert-photo" src="{{item.avatarUrl}}" mode="aspectFill"></image>
        <text wx:if="{{!item.avatarUrl}}" class="expert-avatar">{{item.avatar}}</text>
        <view class="expert-info"><view class="expert-name-row"><text class="expert-name">{{item.name}}</text><text class="expert-title-name">{{item.titleName}}</text></view><text class="expert-org">{{item.org}}</text><view class="expert-tags"><text wx:for="{{item.tags}}" wx:key="*this" class="expert-tag">{{item}}</text></view><text class="expert-bio">{{item.bio}}</text></view>
        <text class="expert-online {{item.online ? 'on' : ''}}">{{item.online ? '在线' : '离线'}}</text>
      </view>
      <view wx:if="{{!loading && !experts.length}}" class="empty-state"><text class="empty-icon">专</text><text class="empty-title">暂无在线专家</text><text class="empty-desc">管理员完善专家资料后会显示在这里</text></view>
    </view>

    <view wx:if="{{activeLectureTab === 'video'}}" class="lecture-panel video-list">
      <view class="video-card" wx:for="{{videoContents}}" wx:key="id" bindtap="onCourseTap" data-id="{{item.id}}">
        <view class="video-cover-wrap"><image wx:if="{{item.coverUrl}}" class="video-cover" src="{{item.coverUrl}}" mode="aspectFill"></image><view wx:if="{{!item.coverUrl}}" class="video-cover video-placeholder"><text>棉花专家讲堂</text></view><text class="video-play">▶</text><text class="video-duration">{{item.duration || '视频'}}</text></view>
        <view class="video-copy"><text class="video-title">{{item.title}}</text><text class="video-desc">{{item.intro || item.subtitle}}</text><view class="video-meta"><text>{{item.teacher}}</text><text>{{item.category}}</text><text>立即观看 ›</text></view></view>
      </view>
      <view wx:if="{{!loading && !videoContents.length}}" class="empty-state"><text class="empty-icon">▶</text><text class="empty-title">暂无精选视频</text><text class="empty-desc">管理员上传并发布视频后会显示在这里</text></view>
    </view>
    <view class="bottom-gap"></view>
  </scroll-view>

  <view class="question-modal-mask" wx:if="{{showQuestionModal}}" catchtap="closeQuestionModal" style="padding-top: {{statusBarHeight + 72}}px;">
    <view class="question-modal" catchtap="noop">
      <view class="question-modal-head">
        <text class="question-modal-title">向专家提问</text>
        <text class="question-modal-close" bindtap="closeQuestionModal">×</text>
      </view>
      <view class="question-modal-body">
        <view class="question-category-list">
          <view class="question-category-chip {{questionForm.category === item ? 'on' : ''}}" wx:for="{{questionCategories}}" wx:key="*this" data-category="{{item}}" bindtap="onQuestionCategoryTap">
            <text>{{item}}</text>
          </view>
        </view>
        <picker mode="selector" range="{{plotOptions}}" value="{{plotIndex}}" bindchange="onQuestionPlotChange">
          <view class="question-picker">
            <text>{{plotOptions[plotIndex] || '选择地块'}}</text>
            <text class="question-picker-arrow">›</text>
          </view>
        </picker>
        <input class="question-input" value="{{questionForm.cropStage}}" data-field="cropStage" bindinput="onQuestionInput" placeholder="棉花生育期，如：蕾期、花铃期（选填）" />
        <textarea class="question-textarea" value="{{questionForm.question}}" data-field="question" bindinput="onQuestionInput" maxlength="1000" placeholder="请描述你遇到的问题，例如叶片症状、天气、用药或浇水情况"></textarea>
        <view class="question-image-block">
          <view class="question-image-head">
            <text>现场图片</text>
            <text class="question-image-tip">最多3张，选填</text>
          </view>
          <view class="question-image-list">
            <view class="question-image-item" wx:for="{{questionImages}}" wx:key="url">
              <image src="{{item.src}}" mode="aspectFill" bindtap="previewQuestionImage" data-url="{{item.src}}"></image>
              <text class="question-image-remove" bindtap="removeQuestionImage" data-index="{{index}}">×</text>
            </view>
            <view class="question-image-add" wx:if="{{questionImages.length < 3}}" bindtap="chooseQuestionImages">
              <text>{{uploadingQuestionImages ? '上传中' : '+ 图片'}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="question-modal-actions">
        <button class="question-btn plain" bindtap="closeQuestionModal">取消</button>
        <button class="question-btn primary" loading="{{questionSubmitting}}" bindtap="submitQuestion">提交给管理员</button>
      </view>
    </view>
  </view>
</view>

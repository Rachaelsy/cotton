.page{height:100vh;background:#f3f6f2;color:#173b2e}.nav{display:flex;align-items:center;justify-content:space-between;padding:0 24rpx 18rpx;background:#fff;font-size:31rpx;font-weight:800}.back,.space{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx}.back{border-radius:50%;background:#eef4ee;font-size:45rpx}.tabs{display:flex;padding:0 26rpx;background:#fff;border-top:1rpx solid #f2f3f1}.tabs view{position:relative;flex:1;padding:24rpx;text-align:center;color:#87918b;font-size:24rpx}.tabs .active{color:#187554;font-weight:800}.tabs .active:after{position:absolute;content:'';width:44rpx;height:6rpx;left:50%;bottom:7rpx;transform:translateX(-50%);border-radius:6rpx;background:#187554}.content{height:calc(100vh - 180rpx);padding:24rpx;box-sizing:border-box}.intro,.feedback-card,.policy,.feedback-record,.empty{margin-bottom:20rpx;border-radius:24rpx;background:#fff}.intro{display:flex;flex-direction:column;padding:25rpx}.intro text:first-child{font-size:26rpx;font-weight:800}.intro text:last-child{margin-top:7rpx;color:#87918b;font-size:20rpx}.empty{display:flex;align-items:center;flex-direction:column;padding:80rpx 30rpx;color:#8b958e;text-align:center}.empty view{font-size:68rpx;color:#d1b05f}.empty text:nth-child(2){margin-top:12rpx;color:#3c5147;font-size:26rpx;font-weight:700}.empty text:nth-child(3){margin-top:10rpx;font-size:21rpx}.empty button{margin-top:24rpx;padding:0 34rpx;background:#e8f3ec;color:#187554;border-radius:28rpx;font-size:22rpx;line-height:62rpx}.empty.small{padding:45rpx 24rpx}.policy{display:flex;align-items:center;padding:26rpx}.policy-main{display:flex;flex:1;min-width:0;flex-direction:column}.policy-tag{align-self:flex-start;padding:5rpx 12rpx;border-radius:8rpx;background:#e6f3eb;color:#187554;font-size:18rpx}.policy-title{margin-top:12rpx;font-size:26rpx;font-weight:800;line-height:1.45}.policy-summary{margin-top:8rpx;color:#7d8981;font-size:20rpx;line-height:1.55}.policy-meta{margin-top:12rpx;color:#a0a8a3;font-size:18rpx}.remove{margin-left:16rpx;color:#a45a50;font-size:19rpx}.feedback-card{padding:28rpx}.card-title,.card-sub{display:block}.card-title{font-size:27rpx;font-weight:800}.card-sub{margin-top:8rpx;color:#828e86;font-size:20rpx}.feedback-card textarea{width:100%;height:190rpx;margin-top:22rpx;padding:20rpx;border:1rpx solid #dfe6df;border-radius:16rpx;background:#f8faf7;box-sizing:border-box;font-size:24rpx}.form-foot{display:flex;align-items:center;justify-content:space-between;margin-top:16rpx;color:#a0a8a3;font-size:19rpx}.form-foot button{margin:0;padding:0 28rpx;background:#187554;color:#fff;border-radius:28rpx;font-size:21rpx;line-height:62rpx}.record-title{margin:30rpx 8rpx 14rpx;font-size:26rpx;font-weight:800}.feedback-record{padding:26rpx}.record-head{display:flex;justify-content:space-between}.record-head text:first-child{color:#187554;font-size:20rpx;font-weight:700}.record-head text:last-child{color:#a0a8a3;font-size:18rpx}.record-content{display:block;margin-top:14rpx;font-size:23rpx;line-height:1.65}.reply{margin-top:18rpx;padding:18rpx;border-radius:14rpx;background:#f0f6f2}.reply text{display:block}.reply text:first-child{color:#187554;font-size:19rpx;font-weight:800}.reply text:last-child{margin-top:7rpx;color:#5e6e65;font-size:21rpx;line-height:1.6}

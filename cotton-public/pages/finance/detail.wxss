.finance-detail-page{min-height:100vh;padding-bottom:60rpx;background:#f4f6f4;color:#19352c}.detail-hero{padding:94rpx 30rpx 44rpx;border-radius:0 0 44rpx 44rpx;background:radial-gradient(circle at 92% 10%,rgba(232,188,100,.22),transparent 35%),linear-gradient(145deg,#142f35,#185346 68%,#1c6c53);color:#fff}.detail-nav{display:flex;align-items:center}.detail-nav>text{flex:1;text-align:center;font-size:30rpx;font-weight:800}.detail-nav button{display:flex;width:70rpx;height:58rpx;align-items:center;justify-content:center;margin:0;padding:0;border:0;border-radius:21rpx;background:rgba(255,255,255,.12);color:#fff;font-size:42rpx;line-height:58rpx}.detail-nav .read-button{width:108rpx;font-size:18rpx}.detail-nav .read-button.done{background:rgba(230,190,107,.22);color:#f6d998}.detail-labels{display:flex;align-items:center;margin-top:39rpx}.detail-labels label{margin-right:9rpx;padding:5rpx 11rpx;border-radius:8rpx;background:rgba(255,255,255,.13);font-size:17rpx}.detail-labels label:nth-child(2){background:#e8bd68;color:#233e35}.detail-labels small{margin-left:auto;font-size:18rpx;opacity:.62}.detail-title{display:block;margin-top:18rpx;font-size:38rpx;font-weight:800;line-height:1.45}.detail-summary{display:block;margin-top:13rpx;color:rgba(255,255,255,.7);font-size:21rpx;line-height:1.65}.boundary-card{display:flex;align-items:center;margin:24rpx 26rpx;padding:21rpx;border-radius:22rpx;background:#fff3dc;color:#69542d}.boundary-icon{display:flex;width:47rpx;height:47rpx;flex-shrink:0;align-items:center;justify-content:center;margin-right:14rpx;border-radius:50%;background:#e6b750;color:#fff;font-weight:800}.boundary-card>view:last-child{display:flex;flex-direction:column}.boundary-card text{font-size:21rpx;font-weight:800}.boundary-card small{margin-top:6rpx;font-size:18rpx;line-height:1.55}.key-section,.content-section,.channel-card,.related-section{margin:24rpx 26rpx;padding:27rpx;border-radius:26rpx;background:#fff;box-shadow:0 7rpx 25rpx rgba(27,64,52,.04)}.key-title,.related-title{margin-bottom:17rpx;font-size:27rpx;font-weight:800}.key-row{display:flex;align-items:flex-start;padding:11rpx 0}.key-row>text{display:flex;width:37rpx;height:37rpx;flex-shrink:0;align-items:center;justify-content:center;margin-right:13rpx;border-radius:50%;background:#e1f1e8;color:#177052;font-size:18rpx}.key-row>view{flex:1;padding-top:3rpx;font-size:21rpx;line-height:1.55}.content-title{display:flex;align-items:center;margin-bottom:18rpx}.content-title i{width:8rpx;height:30rpx;margin-right:13rpx;border-radius:6rpx;background:linear-gradient(#1b7254,#e2b44f)}.content-title text{font-size:28rpx;font-weight:800}.paragraph{display:block;margin-top:12rpx;color:#4d6057;font-size:22rpx;line-height:1.8}.bullet-row,.check-row{display:flex;align-items:flex-start;margin-top:12rpx;padding:12rpx 15rpx;border-radius:15rpx;background:#f6f8f6}.bullet-row>text{width:27rpx;flex-shrink:0;color:#1b7154;font-size:28rpx}.bullet-row>view,.check-row>view{flex:1;font-size:21rpx;line-height:1.55}.check-row>text{width:35rpx;flex-shrink:0;color:#217158;font-size:24rpx}.channel-card{border:1rpx solid #dce8e1;background:#edf5f0}.channel-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:17rpx}.channel-head>view{display:flex;flex-direction:column}.channel-head text{font-size:28rpx;font-weight:800}.channel-head small{margin-top:5rpx;color:#718078;font-size:18rpx}.channel-head label{padding:6rpx 10rpx;border-radius:8rpx;background:#fff1d3;color:#936b24;font-size:17rpx}.channel-row{display:flex;align-items:flex-start;padding:13rpx 0;border-bottom:1rpx solid #dce7e1}.channel-row>text{display:flex;width:39rpx;height:39rpx;flex-shrink:0;align-items:center;justify-content:center;margin-right:12rpx;border-radius:12rpx;background:#1b7053;color:#fff;font-size:17rpx}.channel-row>view{flex:1;padding-top:4rpx;font-size:21rpx;line-height:1.55}.channel-card button{margin:22rpx 0 0;border:0;border-radius:18rpx;background:#186d51;color:#fff;font-size:21rpx;line-height:72rpx}.risk-card{display:flex;flex-direction:column;margin:24rpx 26rpx;padding:25rpx;border-left:7rpx solid #dc9d38;border-radius:20rpx;background:#fff6e7;color:#6f5731}.risk-card text{font-size:22rpx;font-weight:800}.risk-card small{margin-top:8rpx;font-size:19rpx;line-height:1.7}.policy-button{display:flex;align-items:center;justify-content:space-between;margin:24rpx 26rpx;padding:24rpx;border-radius:22rpx;background:#1b6f53;color:#fff}.policy-button text{font-size:22rpx;font-weight:700}.policy-button small{font-size:35rpx}.related-card{display:flex;align-items:center;padding:18rpx 0;border-top:1rpx solid #edf1ee}.related-card>view{display:flex;flex:1;min-width:0;flex-direction:column}.related-card label{align-self:flex-start;padding:4rpx 8rpx;border-radius:7rpx;background:#e8f2ed;color:#1c7054;font-size:16rpx}.related-card>view text{margin-top:7rpx;font-size:21rpx;font-weight:700;line-height:1.5}.related-card>text{margin-left:15rpx;color:#85938c;font-size:35rpx}

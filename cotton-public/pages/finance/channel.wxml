<view class="channel-page {{module.tone}}">
  <view class="channel-hero" style="padding-top:{{statusBarHeight + 14}}px">
    <view class="channel-nav"><button bindtap="back">‹</button><text>优棉金融</text><button class="info" bindtap="showBoundary">说明</button></view>
    <view class="channel-mark"><view>{{module.icon}}</view><text>{{module.eyebrow}}</text></view>
    <text class="channel-title">{{module.title}}</text>
    <text class="channel-subtitle">{{module.subtitle}}</text>
  </view>

  <view class="highlight-card">
    <view class="card-head"><text>先了解三件事</text><small>做决定前逐项核对</small></view>
    <view class="highlight-row" wx:for="{{module.highlights}}" wx:key="*this"><text>✓</text><view>{{item}}</view></view>
  </view>

  <view class="section-card">
    <view class="card-head"><text>办理与学习路径</text><small>平台提供信息指引，不代替机构审核</small></view>
    <view class="step-row" wx:for="{{module.steps}}" wx:key="no">
      <text class="step-no">{{item.no}}</text><view><strong>{{item.title}}</strong><small>{{item.text}}</small></view>
    </view>
  </view>

  <view class="section-card">
    <view class="card-head"><text>专题内容</text><small>{{articles.length}} 篇实用知识</small></view>
    <view class="article-row" wx:for="{{articles}}" wx:key="id" bindtap="openArticle" data-id="{{item.id}}">
      <view><label>{{item.badge}}</label><strong>{{item.title}}</strong><small>{{item.readMinutes}} 分钟 · {{item.hasRead?'已读':'未读'}}</small></view><text>›</text>
    </view>
  </view>

  <view class="policy-link" wx:if="{{module.key==='policy'}}" bindtap="openPolicyCenter"><view>政</view><text>前往政策资讯核验最新文件</text><small>›</small></view>
  <view class="notice-card"><text>重要提示</text><small>{{module.notice}}</small></view>
</view>

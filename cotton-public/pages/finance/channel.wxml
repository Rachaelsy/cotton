<view class="article-page {{meta.tone}}">
  <view class="article-hero" style="padding-top:{{statusBarHeight}}px">
    <view class="article-nav"><button bindtap="back">‹</button><text>优棉金融</text><view></view></view>
    <view class="hero-mark"><view>{{meta.icon}}</view><text>{{meta.eyebrow}}</text></view>
    <text class="hero-title">{{article.title || meta.title}}</text>
    <view wx:if="{{!loading && !error}}" class="hero-meta"><text>{{article.issuer || '喀什优棉公共服务平台'}}</text><text>{{article.publishDate}}</text></view>
  </view>
  <view wx:if="{{loading}}" class="state-card">正在加载文章…</view>
  <view wx:if="{{!loading && error}}" class="state-card error"><text>{{error}}</text><button bindtap="loadArticle">重新加载</button></view>
  <view wx:if="{{!loading && !error}}" class="article-shell">
    <view class="article-body"><rich-text nodes="{{bodyNodes}}"></rich-text></view>
    <view class="source-note"><text>信息来源：{{article.issuer || '喀什优棉公共服务平台'}}</text><text>金融科普与入口指引，不构成贷款、保险或投资建议</text><button bindtap="copySource">{{article.originalUrl?'复制原文链接':'复制来源说明'}}</button></view>
    <view class="comments"><view class="comments-title"><i></i><text>评论</text><small>{{comments.length ? comments.length + ' 条' : ''}}</small></view>
      <view wx:if="{{commentsLoading}}" class="comment-empty">评论加载中…</view>
      <view wx:if="{{!commentsLoading && !comments.length}}" class="comment-empty"><view class="empty-icon">评</view><text>暂无评论，欢迎发表观点</text></view>
      <view class="comment" wx:for="{{comments}}" wx:key="id"><view class="avatar">{{item.initial}}</view><view class="comment-main"><view class="comment-meta"><text>{{item.author}}</text><text>{{item.timeText}}</text></view><text class="comment-content">{{item.content}}</text></view></view>
    </view>
  </view>
  <view wx:if="{{!loading && !error}}" class="bottom-bar"><view class="comment-input" bindtap="focusComment"><input value="{{commentText}}" focus="{{commentFocus}}" bindinput="onCommentInput" bindblur="onCommentBlur" bindconfirm="submitComment" confirm-type="send" maxlength="300" placeholder="欢迎发表评论"/><button wx:if="{{commentText}}" loading="{{submittingComment}}" bindtap="submitComment">发送</button></view><view class="action-group"><view class="action" bindtap="focusComment"><text class="action-icon">评</text><small>评论</small></view><view class="action" bindtap="toggleCollect"><text class="action-icon {{collected?'active':''}}">{{collected?'★':'☆'}}</text><small>{{collected?'已收藏':'收藏'}}</small></view><button class="action share" open-type="share"><text class="action-icon">↗</text><small>转发</small></button></view></view>
</view>

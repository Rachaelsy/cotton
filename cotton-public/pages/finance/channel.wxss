.channel-page{min-height:100vh;padding-bottom:58rpx;background:#f3f6f3;color:#18362c}.channel-hero{padding-right:30rpx;padding-bottom:58rpx;padding-left:30rpx;border-radius:0 0 48rpx 48rpx;background:#176d51;color:#fff}.channel-page.blue .channel-hero{background:#295f72}.channel-page.purple .channel-hero{background:#4f526f}.channel-page.gold .channel-hero{background:#6b5938}.channel-nav{display:flex;align-items:center}.channel-nav>text{flex:1;text-align:center;font-size:31rpx;font-weight:800}.channel-nav button{display:flex;width:66rpx;height:58rpx;align-items:center;justify-content:center;margin:0;padding:0;border:1rpx solid rgba(255,255,255,.16);border-radius:20rpx;background:rgba(255,255,255,.1);color:#fff;font-size:39rpx;line-height:58rpx}.channel-nav .info{font-size:19rpx}.channel-mark{display:flex;align-items:center;margin-top:40rpx}.channel-mark view{display:flex;width:58rpx;height:58rpx;align-items:center;justify-content:center;margin-right:14rpx;border-radius:18rpx;background:#e8bd68;color:#244338;font-size:23rpx;font-weight:900}.channel-mark text{font-size:17rpx;letter-spacing:3rpx;opacity:.62}.channel-title{display:block;margin-top:20rpx;font-size:48rpx;font-weight:900}.channel-subtitle{display:block;margin-top:12rpx;color:rgba(255,255,255,.72);font-size:22rpx;line-height:1.6}.highlight-card,.section-card{margin:24rpx;padding:28rpx;border-radius:28rpx;background:#fff;box-shadow:0 8rpx 28rpx rgba(24,65,51,.055)}.highlight-card{margin-top:-25rpx}.card-head{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:20rpx}.card-head text{font-size:28rpx;font-weight:850}.card-head small{color:#8a9790;font-size:18rpx}.highlight-row{display:flex;align-items:flex-start;padding:12rpx 0}.highlight-row>text{display:flex;width:38rpx;height:38rpx;flex-shrink:0;align-items:center;justify-content:center;margin-right:13rpx;border-radius:50%;background:#dff0e7;color:#176e51;font-size:18rpx}.highlight-row>view{flex:1;padding-top:3rpx;font-size:21rpx;line-height:1.55}.step-row{display:flex;align-items:flex-start;padding:20rpx 0;border-top:1rpx solid #edf1ee}.step-row:first-of-type{border-top:0}.step-no{width:55rpx;flex-shrink:0;color:#1a7254;font-size:20rpx;font-weight:900;letter-spacing:1rpx}.step-row>view{display:flex;flex:1;flex-direction:column}.step-row strong{font-size:23rpx}.step-row small{margin-top:7rpx;color:#6f7e76;font-size:20rpx;line-height:1.6}.article-row{display:flex;align-items:center;padding:22rpx 0;border-top:1rpx solid #edf1ee}.article-row>view{display:flex;flex:1;min-width:0;flex-direction:column}.article-row label{align-self:flex-start;padding:5rpx 10rpx;border-radius:8rpx;background:#e4f1ea;color:#1b7154;font-size:16rpx}.article-row strong{margin-top:10rpx;font-size:24rpx;line-height:1.5}.article-row small{margin-top:7rpx;color:#929c97;font-size:18rpx}.article-row>text{margin-left:15rpx;color:#7f8d86;font-size:36rpx}.policy-link{display:flex;align-items:center;margin:24rpx;padding:23rpx;border-radius:23rpx;background:#e6efe9}.policy-link>view{display:flex;width:48rpx;height:48rpx;align-items:center;justify-content:center;margin-right:13rpx;border-radius:15rpx;background:#1a7053;color:#fff;font-weight:800}.policy-link>text{flex:1;font-size:21rpx;font-weight:700}.policy-link>small{font-size:34rpx}.notice-card{display:flex;flex-direction:column;margin:24rpx;padding:24rpx;border-left:7rpx solid #d4a44a;border-radius:20rpx;background:#fff3dc;color:#6b5631}.notice-card text{font-size:21rpx;font-weight:800}.notice-card small{margin-top:8rpx;font-size:18rpx;line-height:1.7}

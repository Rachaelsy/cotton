<view class="finance-page">
  <view class="finance-hero">
    <view class="finance-nav">
      <button bindtap="back">‹</button>
      <view><text>棉花金融</text><small>COTTON FINANCE</small></view>
      <button class="boundary-button" bindtap="showBoundary">说明</button>
    </view>
    <view class="hero-copy">
      <text>懂政策 · 识风险 · 找入口</text>
      <small>面向棉农的公益金融知识与办事指引</small>
    </view>
    <view class="hero-boundary" bindtap="showBoundary">
      <view class="shield">盾</view>
      <view><text>只做科普与入口指引</text><small>不放贷、不代办、不销售保险、不提供期货交易</small></view>
      <text class="hero-arrow">›</text>
    </view>
  </view>

  <view class="progress-card">
    <view><text>金融知识必读</text><small>先了解规则，再做重要决定</small></view>
    <view class="progress-copy"><text>{{readCount}}</text><small>/ {{totalCount}} 篇</small></view>
    <view class="progress-track"><view style="width: {{totalCount ? readCount / totalCount * 100 : 0}}%"></view></view>
  </view>

  <view class="finance-section category-section">
    <view class="section-title"><view><text>知识导航</text><small>从你关心的问题开始</small></view></view>
    <view class="category-grid">
      <view class="category-card" wx:for="{{categories}}" wx:key="key" bindtap="openCategory" data-key="{{item.key}}">
        <view class="category-icon {{item.tone}}">{{item.icon}}</view>
        <view><text>{{item.title}}</text><small>{{item.short}}</small></view>
        <text class="category-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="market-section">
    <view class="market-head"><view><text>行情简讯</text><small>学会辨别信息口径</small></view><label>科普内容 · 非实时行情</label></view>
    <scroll-view class="brief-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="brief-row">
        <view class="brief-card" wx:for="{{marketBriefs}}" wx:key="label">
          <label>{{item.label}}</label><text>{{item.title}}</text><small>{{item.text}}</small>
        </view>
      </view>
    </scroll-view>
    <view class="market-link" bindtap="openArticle" data-id="market-brief-reading"><text>行情阅读入门</text><small>了解现货、期货和基差 ›</small></view>
  </view>

  <view class="finance-section article-section" id="finance-articles">
    <view class="section-title"><view><text>金融知识库</text><small>内容均为一般性公益科普</small></view></view>
    <scroll-view class="tab-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="tab-row">
        <button class="{{activeCategory===item.key?'on':''}}" wx:for="{{tabs}}" wx:key="key" bindtap="chooseCategory" data-key="{{item.key}}">{{item.title}}</button>
      </view>
    </scroll-view>
    <view class="article-list">
      <view class="article-card" wx:for="{{visibleArticles}}" wx:key="id" bindtap="openArticle" data-id="{{item.id}}">
        <view class="article-top"><label>{{item.badge}}</label><small>{{item.readMinutes}} 分钟</small></view>
        <text class="article-title">{{item.title}}</text>
        <text class="article-summary">{{item.summary}}</text>
        <view class="article-foot"><text>{{item.categoryName}}</text><small>{{item.hasRead?'已读':'开始阅读'}} ›</small></view>
      </view>
    </view>
  </view>

  <view class="policy-link" bindtap="openPolicyCenter">
    <view class="policy-icon">政</view>
    <view><text>查看政策资讯</text><small>核对正式政策原文、办理期限与发布单位</small></view>
    <text>›</text>
  </view>

  <view class="finance-disclaimer">
    <text>风险提示</text>
    <small>本模块不构成贷款、保险、证券期货或其他金融产品的推荐与承诺。涉及资金和个人信息时，请通过政府部门、持牌金融机构及监管机构公布的官方渠道核验。</small>
  </view>
</view>

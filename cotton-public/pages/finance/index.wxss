.finance-page{min-height:100vh;padding-bottom:60rpx;background:#f3f6f3;color:#18362c}.finance-hero{padding-right:28rpx;padding-bottom:46rpx;padding-left:28rpx;border-radius:0 0 48rpx 48rpx;background:#155f49;color:#fff}.finance-nav{display:flex;align-items:center}.finance-nav button{display:flex;width:66rpx;height:58rpx;align-items:center;justify-content:center;margin:0;padding:0;border:1rpx solid rgba(255,255,255,.16);border-radius:20rpx;background:rgba(255,255,255,.1);color:#fff;font-size:40rpx;line-height:58rpx}.finance-nav>view{display:flex;flex:1;flex-direction:column;align-items:center}.finance-nav>view text{font-size:32rpx;font-weight:850}.finance-nav>view small{margin-top:3rpx;font-size:17rpx;letter-spacing:3rpx;opacity:.58}.finance-nav .boundary-button{font-size:21rpx}.hero-copy{display:flex;flex-direction:column;margin-top:34rpx}.hero-copy text{font-size:38rpx;font-weight:900;letter-spacing:1rpx}.hero-copy small{margin-top:9rpx;color:rgba(255,255,255,.7);font-size:23rpx}.quote-card{margin-top:27rpx;padding:24rpx;border:1rpx solid rgba(255,255,255,.18);border-radius:27rpx;background:rgba(10,38,31,.28)}.quote-head,.quote-main,.quote-meta{display:flex;align-items:center;justify-content:space-between}.quote-head>view{display:flex;flex-direction:column}.quote-head text{font-size:24rpx;font-weight:800}.quote-head small{margin-top:5rpx;color:rgba(255,255,255,.6);font-size:19rpx}.quote-head label{padding:5rpx 11rpx;border-radius:9rpx;background:rgba(255,255,255,.13);font-size:18rpx}.quote-main{margin-top:18rpx}.quote-price{display:flex;align-items:baseline}.quote-price strong{font-size:52rpx;font-weight:900;letter-spacing:1rpx}.quote-price small{margin-left:8rpx;color:rgba(255,255,255,.62);font-size:19rpx}.quote-change{display:flex;flex-direction:column;align-items:flex-end}.quote-change text{font-size:25rpx;font-weight:850}.quote-change small{margin-top:3rpx;font-size:22rpx}.quote-card.up .quote-change{color:#ffd0bd}.quote-card.down .quote-change{color:#b9ead3}.quote-meta{margin-top:15rpx;color:rgba(255,255,255,.57);font-size:18rpx}.quote-error{margin-top:13rpx;padding:9rpx 12rpx;border-radius:11rpx;background:rgba(255,204,146,.14);color:#ffe2bb;font-size:19rpx}.quote-notice{margin-top:15rpx;padding-top:14rpx;border-top:1rpx solid rgba(255,255,255,.12);color:rgba(255,255,255,.56);font-size:18rpx;line-height:1.55}.progress-card{display:flex;position:relative;align-items:center;margin:0 24rpx;padding:26rpx 25rpx 35rpx;border-radius:0 0 25rpx 25rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(23,65,53,.06)}.progress-card>view:first-child{display:flex;flex:1;flex-direction:column}.progress-card>view:first-child text{font-size:24rpx;font-weight:750}.progress-card>view:first-child small{margin-top:5rpx;color:#8b9791;font-size:20rpx}.progress-copy{display:flex;align-items:baseline;color:#176f52}.progress-copy text{font-size:34rpx;font-weight:900}.progress-copy small{margin-left:4rpx;color:#89958f;font-size:20rpx}.progress-track{position:absolute;right:25rpx;bottom:17rpx;left:25rpx;height:7rpx;overflow:hidden;border-radius:7rpx;background:#e8eeea}.progress-track view{height:100%;border-radius:7rpx;background:#1b7355}.finance-section{margin:24rpx;padding:28rpx;border-radius:29rpx;background:#fff;box-shadow:0 7rpx 25rpx rgba(28,65,53,.045)}.section-title{display:flex;align-items:center;margin-bottom:18rpx}.section-title>view{display:flex;flex-direction:column}.section-title text{font-size:29rpx;font-weight:850}.section-title small{margin-top:5rpx;color:#929d97;font-size:21rpx}.module-card{display:flex;align-items:center;padding:22rpx 0;border-top:1rpx solid #ebf0ec}.module-card:first-child{border-top:0}.module-icon{display:flex;width:68rpx;height:68rpx;flex-shrink:0;align-items:center;justify-content:center;margin-right:16rpx;border-radius:21rpx;background:#dff0e7;color:#176f51;font-size:24rpx;font-weight:900}.module-card.blue .module-icon{background:#e0edf2;color:#2b6578}.module-card.purple .module-icon{background:#e9e8f0;color:#535875}.module-card.gold .module-icon{background:#f3ead8;color:#7f6333}.module-copy{display:flex;flex:1;min-width:0;flex-direction:column}.module-copy text{font-size:26rpx;font-weight:800}.module-arrow{color:#7e8d85;font-size:37rpx}.policy-link{display:flex;align-items:center;margin:24rpx;padding:24rpx;border:1rpx solid #dbe7e0;border-radius:25rpx;background:#eaf3ed}.policy-icon{display:flex;width:58rpx;height:58rpx;flex-shrink:0;align-items:center;justify-content:center;margin-right:15rpx;border-radius:18rpx;background:#1a7053;color:#fff;font-weight:850}.policy-link>view:nth-child(2){display:flex;flex:1;flex-direction:column}.policy-link>view:nth-child(2) text{font-size:25rpx;font-weight:750}.policy-link>view:nth-child(2) small{margin-top:5rpx;color:#728078;font-size:20rpx}.policy-link>text{font-size:35rpx}.finance-disclaimer{display:flex;flex-direction:column;margin:24rpx;padding:24rpx;border-left:7rpx solid #d4a44a;border-radius:21rpx;background:#fff3dc;color:#6b5631}.finance-disclaimer text{font-size:23rpx;font-weight:850}.finance-disclaimer small{margin-top:8rpx;font-size:20rpx;line-height:1.7}

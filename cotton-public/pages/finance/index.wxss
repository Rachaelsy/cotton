.finance-page{min-height:100vh;padding-bottom:58rpx;background:#f4f6f4;color:#19352c}.finance-hero{padding:94rpx 28rpx 42rpx;border-radius:0 0 44rpx 44rpx;background:radial-gradient(circle at 88% 12%,rgba(255,214,133,.2),transparent 32%),linear-gradient(145deg,#152f35,#164e45 60%,#1d6c54);color:#fff}.finance-nav{display:flex;align-items:center}.finance-nav button{display:flex;width:68rpx;height:60rpx;align-items:center;justify-content:center;margin:0;padding:0;border:0;border-radius:22rpx;background:rgba(255,255,255,.12);color:#fff;font-size:42rpx;line-height:60rpx}.finance-nav>view{display:flex;flex:1;flex-direction:column;align-items:center}.finance-nav>view text{font-size:33rpx;font-weight:800}.finance-nav>view small{margin-top:3rpx;font-size:16rpx;letter-spacing:3rpx;opacity:.6}.finance-nav .boundary-button{font-size:20rpx;font-weight:600}.hero-copy{display:flex;flex-direction:column;margin-top:40rpx}.hero-copy text{font-size:40rpx;font-weight:800;letter-spacing:2rpx}.hero-copy small{margin-top:10rpx;color:rgba(255,255,255,.7);font-size:21rpx}.hero-boundary{display:flex;align-items:center;margin-top:29rpx;padding:20rpx;border:1rpx solid rgba(255,255,255,.16);border-radius:22rpx;background:rgba(255,255,255,.09)}.shield{display:flex;width:54rpx;height:54rpx;flex-shrink:0;align-items:center;justify-content:center;margin-right:15rpx;border-radius:17rpx;background:#e9bd62;color:#1b4136;font-size:20rpx;font-weight:800}.hero-boundary>view{display:flex;flex:1;min-width:0;flex-direction:column}.hero-boundary>view text{font-size:23rpx;font-weight:700}.hero-boundary>view small{margin-top:6rpx;overflow:hidden;color:rgba(255,255,255,.65);font-size:18rpx;white-space:nowrap;text-overflow:ellipsis}.hero-arrow{font-size:38rpx;opacity:.6}.progress-card{display:flex;position:relative;align-items:center;margin:-2rpx 24rpx 0;padding:27rpx 25rpx 35rpx;border-radius:0 0 25rpx 25rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(23,65,53,.06)}.progress-card>view:first-child{display:flex;flex:1;flex-direction:column}.progress-card>view:first-child text{font-size:25rpx;font-weight:700}.progress-card>view:first-child small{margin-top:5rpx;color:#8c9892;font-size:18rpx}.progress-copy{display:flex;align-items:baseline;color:#1a7154}.progress-copy text{font-size:35rpx;font-weight:800}.progress-copy small{margin-left:4rpx;color:#89958f;font-size:18rpx}.progress-track{position:absolute;right:25rpx;bottom:17rpx;left:25rpx;height:7rpx;overflow:hidden;border-radius:7rpx;background:#e8eeea}.progress-track view{height:100%;border-radius:7rpx;background:linear-gradient(90deg,#1b7355,#e4b753)}.finance-section{margin:24rpx;padding:28rpx;border-radius:29rpx;background:#fff;box-shadow:0 7rpx 25rpx rgba(28,65,53,.045)}.section-title{display:flex;align-items:center;margin-bottom:24rpx}.section-title>view{display:flex;flex-direction:column}.section-title text{font-size:30rpx;font-weight:800}.section-title small{margin-top:5rpx;color:#929d97;font-size:19rpx}.category-grid{display:flex;flex-wrap:wrap;margin:0 -7rpx}.category-card{display:flex;position:relative;width:50%;box-sizing:border-box;align-items:center;padding:12rpx 7rpx}.category-card>.category-icon{display:flex;width:67rpx;height:67rpx;flex-shrink:0;align-items:center;justify-content:center;margin-right:14rpx;border-radius:21rpx;font-size:24rpx;font-weight:800}.category-card>view:nth-child(2){display:flex;min-width:0;flex-direction:column}.category-card>view:nth-child(2) text{font-size:23rpx;font-weight:700}.category-card>view:nth-child(2) small{margin-top:5rpx;color:#909b95;font-size:17rpx;white-space:nowrap}.category-arrow{position:absolute;right:11rpx;color:#b0b9b4}.category-icon.green{background:#e0f2e9;color:#176f51}.category-icon.blue{background:#e3eef7;color:#367399}.category-icon.cyan{background:#e3f2f1;color:#267a74}.category-icon.purple{background:#ece9f5;color:#62568b}.category-icon.orange{background:#faeadc;color:#a15d2d}.category-icon.gold{background:#f8efd8;color:#977024}.market-section{margin:24rpx;padding:28rpx 0 0;border-radius:29rpx;background:linear-gradient(145deg,#f6efe0,#fbf7ef);box-shadow:0 7rpx 25rpx rgba(66,51,24,.05)}.market-head{display:flex;align-items:flex-start;justify-content:space-between;padding:0 28rpx}.market-head>view{display:flex;flex-direction:column}.market-head text{font-size:30rpx;font-weight:800;color:#493a23}.market-head small{margin-top:5rpx;color:#98866b;font-size:19rpx}.market-head>label{padding:6rpx 10rpx;border-radius:8rpx;background:#fff4d8;color:#8d6826;font-size:16rpx}.brief-scroll{width:100%;margin-top:21rpx;white-space:nowrap}.brief-row{display:flex;width:max-content;padding:0 28rpx 4rpx}.brief-card{display:flex;width:440rpx;box-sizing:border-box;flex-direction:column;margin-right:16rpx;padding:22rpx;border:1rpx solid rgba(155,123,67,.12);border-radius:22rpx;background:rgba(255,255,255,.78);white-space:normal}.brief-card label{align-self:flex-start;padding:4rpx 9rpx;border-radius:7rpx;background:#e6bd69;color:#503b19;font-size:16rpx}.brief-card text{margin-top:12rpx;font-size:24rpx;font-weight:700}.brief-card small{margin-top:8rpx;color:#7f745f;font-size:19rpx;line-height:1.55}.market-link{display:flex;align-items:center;justify-content:space-between;margin-top:20rpx;padding:21rpx 28rpx;border-top:1rpx solid rgba(142,113,64,.12)}.market-link text{font-size:22rpx;font-weight:700}.market-link small{color:#8a6b34;font-size:19rpx}.tab-scroll{width:100%;margin-bottom:18rpx;white-space:nowrap}.tab-row{display:flex;width:max-content}.tab-row button{min-width:88rpx;margin:0 12rpx 0 0;padding:0 20rpx;border:1rpx solid #e1e8e3;border-radius:24rpx;background:#f6f8f6;color:#66736d;font-size:20rpx;line-height:52rpx}.tab-row button.on{border-color:#1a7053;background:#1a7053;color:#fff}.article-card{margin-top:16rpx;padding:24rpx;border:1rpx solid #edf1ee;border-radius:23rpx;background:#fff;box-shadow:0 7rpx 20rpx rgba(23,57,46,.035)}.article-top,.article-foot{display:flex;align-items:center;justify-content:space-between}.article-top label{padding:5rpx 10rpx;border-radius:8rpx;background:#e9f3ee;color:#1d7255;font-size:17rpx}.article-top small{color:#9aa49f;font-size:18rpx}.article-title,.article-summary{display:block}.article-title{margin-top:14rpx;font-size:27rpx;font-weight:800;line-height:1.45}.article-summary{margin-top:9rpx;color:#6e7a74;font-size:20rpx;line-height:1.65}.article-foot{margin-top:18rpx;padding-top:16rpx;border-top:1rpx solid #eef1ef}.article-foot text{color:#87928c;font-size:18rpx}.article-foot small{color:#1b7254;font-size:19rpx}.policy-link{display:flex;align-items:center;margin:24rpx;padding:24rpx;border:1rpx solid #dce7e1;border-radius:27rpx;background:#edf5f0}.policy-icon{display:flex;width:62rpx;height:62rpx;flex-shrink:0;align-items:center;justify-content:center;margin-right:16rpx;border-radius:19rpx;background:#d9ede2;color:#176d50;font-weight:800}.policy-link>view:nth-child(2){display:flex;flex:1;min-width:0;flex-direction:column}.policy-link>view:nth-child(2) text{font-size:24rpx;font-weight:700}.policy-link>view:nth-child(2) small{margin-top:6rpx;color:#718079;font-size:18rpx}.policy-link>text{color:#678076;font-size:35rpx}.finance-disclaimer{display:flex;flex-direction:column;margin:24rpx;padding:24rpx;border-radius:24rpx;background:#fff6e5;color:#765f37}.finance-disclaimer text{font-size:21rpx;font-weight:800}.finance-disclaimer small{margin-top:8rpx;font-size:18rpx;line-height:1.65}

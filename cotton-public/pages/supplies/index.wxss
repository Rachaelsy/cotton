.page{min-height:100vh;padding-bottom:50rpx;background:linear-gradient(180deg,#fbf4e4,#f5f7f3 440rpx);color:#29382f}.hero{padding-right:28rpx;padding-bottom:34rpx;padding-left:28rpx;border-radius:0 0 42rpx 42rpx;background:linear-gradient(145deg,#8a681d,#b58727 60%,#c99a3e);color:#fff;box-shadow:0 15rpx 36rpx rgba(124,88,20,.17)}.nav{display:flex;align-items:center}.nav button,.nav>view{width:72rpx;flex:none}.nav button{margin:0;padding:0;border:0;background:transparent;color:#fff;font-size:52rpx;line-height:64rpx}.nav button::after,.category-tabs button::after{border:0}.nav>text{flex:1;text-align:center;font-size:31rpx;font-weight:850}.hero-content{display:flex;align-items:center;justify-content:space-between;margin-top:29rpx}.hero-content>view:first-child{display:flex;flex-direction:column}.hero-content text{font-size:35rpx;font-weight:900}.hero-content small{margin-top:9rpx;color:rgba(255,255,255,.76);font-size:20rpx}.hero-mark{display:flex;align-items:center;justify-content:center;width:82rpx;height:82rpx;flex:none;border:1rpx solid rgba(255,255,255,.22);border-radius:27rpx;background:rgba(255,255,255,.14);font-size:31rpx;font-weight:900}.category-tabs{display:flex;margin:20rpx 22rpx 0;padding:12rpx;border-radius:22rpx;background:#fff;box-shadow:0 9rpx 27rpx rgba(87,68,28,.07)}.category-tabs button{display:flex;height:88rpx;min-width:0;flex:1;align-items:center;margin:0 4rpx;padding:0;border:0;border-radius:16rpx;background:#faf8f2;color:#7d7563;flex-direction:column;justify-content:center}.category-tabs button text{font-size:24rpx;font-weight:900}.category-tabs button small{margin-top:4rpx;font-size:17rpx}.category-tabs button.on{background:linear-gradient(145deg,#b28225,#936b1b);color:#fff;box-shadow:0 7rpx 17rpx rgba(143,101,22,.22)}.overview{margin:18rpx 22rpx 0;padding:28rpx 25rpx;border:1rpx solid #eee6d6;border-radius:28rpx;background:#fff;box-shadow:0 10rpx 30rpx rgba(87,68,28,.055)}.overview-head{display:flex;align-items:center}.category-icon{display:flex;align-items:center;justify-content:center;width:74rpx;height:74rpx;border-radius:23rpx;background:#fff1cc;color:#98701f;font-size:27rpx;font-weight:900}.overview-head>view:last-child{display:flex;flex-direction:column;margin-left:17rpx}.overview-head text{font-size:29rpx;font-weight:900}.overview-head small{margin-top:4rpx;color:#9c7b38;font-size:18rpx}.intro{display:block;margin-top:20rpx;color:#59665e;font-size:21rpx;line-height:1.72}.types{display:flex;flex-wrap:wrap;margin-top:18rpx}.types text{margin:0 10rpx 10rpx 0;padding:9rpx 13rpx;border-radius:9rpx;background:#fff6df;color:#856421;font-size:18rpx}.section{margin:18rpx 22rpx 0;padding:26rpx 24rpx;border:1rpx solid #e8ede9;border-radius:26rpx;background:#fff;box-shadow:0 9rpx 27rpx rgba(48,70,58,.05)}.section-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:14rpx}.section-head>view{display:flex;flex-direction:column}.section-head text{font-size:26rpx;font-weight:900}.section-head small{margin-top:5rpx;color:#9aa29d;font-size:18rpx}.section-head>label{padding:6rpx 10rpx;border-radius:8rpx;background:#eaf6ef;color:#187454;font-size:15rpx;letter-spacing:2rpx}.check{display:flex;align-items:flex-start;padding:14rpx 0;border-top:1rpx solid #edf0ee}.check>text{display:flex;align-items:center;justify-content:center;width:36rpx;height:36rpx;flex:none;border-radius:50%;background:#e7f5ed;color:#147453;font-size:17rpx;font-weight:900}.check label{margin-left:13rpx;color:#526159;font-size:20rpx;line-height:1.55}.label-grid{display:flex;flex-wrap:wrap}.label-grid>view{display:flex;width:50%;align-items:center;padding:13rpx 0;box-sizing:border-box}.label-grid text{display:flex;align-items:center;justify-content:center;width:36rpx;height:36rpx;border-radius:10rpx;background:#fff1cf;color:#946b1c;font-size:16rpx;font-weight:900}.label-grid label{margin-left:10rpx;color:#56655d;font-size:20rpx}.warning{display:flex;margin:18rpx 22rpx 0;padding:22rpx 24rpx;border:1rpx solid #efd7c5;border-radius:24rpx;background:#fff6ef}.warning>view:first-child{display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;flex:none;border-radius:50%;background:#e8a56e;color:#fff;font-size:24rpx;font-weight:900}.warning>view:last-child{display:flex;flex-direction:column;margin-left:15rpx}.warning text{color:#955729;font-size:22rpx;font-weight:900}.warning small{margin-top:7rpx;color:#7d6758;font-size:19rpx;line-height:1.62}.boundary{margin:18rpx 22rpx 0;padding:20rpx 23rpx;border-radius:20rpx;background:#edf5f0;color:#66756d;font-size:18rpx;line-height:1.65}

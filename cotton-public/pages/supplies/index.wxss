.page{min-height:100vh;padding-bottom:50rpx;background:linear-gradient(180deg,#fbf4e4,#f5f7f3 440rpx);color:#29382f}.hero{padding-right:28rpx;padding-bottom:34rpx;padding-left:28rpx;border-radius:0 0 42rpx 42rpx;background:linear-gradient(145deg,#8a681d,#b58727 60%,#c99a3e);color:#fff;box-shadow:0 15rpx 36rpx rgba(124,88,20,.17)}.nav{display:flex;align-items:center}.nav button,.nav>view{width:72rpx;flex:none}.nav button{margin:0;padding:0;border:0;background:transparent;color:#fff;font-size:52rpx;line-height:64rpx}.nav button::after,.category-tabs button::after{border:0}.nav>text{flex:1;text-align:center;font-size:31rpx;font-weight:850}.hero-content{display:flex;align-items:center;justify-content:space-between;margin-top:29rpx}.hero-content>view:first-child{display:flex;flex-direction:column}.hero-content text{font-size:35rpx;font-weight:900}.hero-content small{margin-top:9rpx;color:rgba(255,255,255,.76);font-size:20rpx}.hero-mark{display:flex;align-items:center;justify-content:center;width:82rpx;height:82rpx;flex:none;border:1rpx solid rgba(255,255,255,.22);border-radius:27rpx;background:rgba(255,255,255,.14);font-size:31rpx;font-weight:900}.category-tabs{display:flex;margin:20rpx 22rpx 0;padding:12rpx;border-radius:22rpx;background:#fff;box-shadow:0 9rpx 27rpx rgba(87,68,28,.07)}.category-tabs button{display:flex;height:88rpx;min-width:0;flex:1;align-items:center;margin:0 4rpx;padding:0;border:0;border-radius:16rpx;background:#faf8f2;color:#7d7563;flex-direction:column;justify-content:center}.category-tabs button text{font-size:24rpx;font-weight:900}.category-tabs button small{margin-top:4rpx;font-size:17rpx}.category-tabs button.on{background:linear-gradient(145deg,#b28225,#936b1b);color:#fff;box-shadow:0 7rpx 17rpx rgba(143,101,22,.22)}.section-head{display:flex;margin:27rpx 24rpx 13rpx}.section-head>view{display:flex;flex-direction:column}.section-head text{font-size:28rpx;font-weight:900}.section-head small{margin-top:5rpx;color:#958b75;font-size:18rpx}.product-list{margin:0 22rpx}.product-card{margin-bottom:16rpx;padding:24rpx;border:1rpx solid #ede5d5;border-radius:27rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(87,68,28,.055)}.product-top{display:flex}.cover{width:184rpx;height:146rpx;flex:none;border-radius:18rpx;background:#f7f1e5}.placeholder{display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,#fff0c9,#fff8e8);color:#997021;font-size:46rpx;font-weight:900}.product-copy{display:flex;min-width:0;flex:1;flex-direction:column;margin-left:19rpx}.tags{display:flex;align-items:center}.tags text,.tags label{margin-right:8rpx;padding:4rpx 9rpx;border-radius:7rpx;background:#fff1cb;color:#936a1b;font-size:15rpx}.tags label{background:#e9f5ee;color:#157453}.product-copy strong{display:-webkit-box;overflow:hidden;margin-top:10rpx;font-size:27rpx;line-height:1.4;-webkit-box-orient:vertical;-webkit-line-clamp:2}.product-copy>small{margin-top:6rpx;color:#746c5d;font-size:18rpx}.brand{margin-top:auto;color:#9a7226;font-size:17rpx}.intro{display:block;margin-top:20rpx;color:#625f56;font-size:20rpx;line-height:1.65}.features{display:flex;flex-wrap:wrap;margin-top:14rpx}.features text{margin:0 9rpx 9rpx 0;padding:7rpx 11rpx;border-radius:8rpx;background:#fff6df;color:#856421;font-size:17rpx}.product-foot{display:flex;align-items:center;justify-content:space-between;margin-top:12rpx;padding-top:14rpx;border-top:1rpx solid #f0ece4;color:#716e65;font-size:17rpx}.product-foot>text{overflow:hidden;max-width:75%;text-overflow:ellipsis;white-space:nowrap}.product-foot small{color:#16805e}.empty{display:flex;align-items:center;flex-direction:column;margin:0 22rpx;padding:70rpx 20rpx;border:1rpx solid #ede5d5;border-radius:27rpx;background:#fff;color:#4b4538;font-size:23rpx;font-weight:800;box-shadow:0 10rpx 28rpx rgba(87,68,28,.05)}.empty small{margin-top:9rpx;color:#9d9688;font-size:18rpx;font-weight:400}.notice{margin:20rpx 22rpx 0;padding:21rpx 23rpx;border:1rpx solid #e7ddcc;border-radius:21rpx;background:#fffaf1;color:#7c725f;font-size:18rpx;line-height:1.65}

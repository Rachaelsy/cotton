<view class="page">
  <view class="nav" style="padding-top:{{statusBarHeight + 8}}px">
    <button bindtap="back">‹</button>
    <text>政策资讯</text>
    <view></view>
  </view>

  <view class="primary-tabs">
    <button wx:for="{{primaryTabs}}" wx:key="id" class="{{activeType === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="selectType">{{item.name}}</button>
  </view>

  <view class="secondary-tabs">
    <view class="secondary-inner">
      <button wx:for="{{sections}}" wx:key="*this" class="{{activeSection === item ? 'on' : ''}}" data-section="{{item}}" bindtap="selectSection">{{item}}</button>
    </view>
  </view>

  <view wx:if="{{demoMode}}" class="demo-tip">云端资讯暂时无法加载，当前展示演示内容。</view>

  <view wx:if="{{loading}}" class="empty">正在加载政策资讯…</view>
  <view wx:if="{{!loading && !visible.length}}" class="empty">
    <text>“{{activeSection}}”栏目暂无文章</text>
  </view>

  <view wx:if="{{!loading && visible.length}}" class="feed">
    <view class="article" wx:for="{{visible}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <view class="article-main">
        <view class="article-copy">
          <text class="article-title">{{item.title}}</text>
          <view class="meta">
            <text>{{item.issuer || '喀什优棉公共服务平台'}}</text>
            <text>{{item.publishDate}}</text>
          </view>
        </view>
        <image wx:if="{{item.coverImage}}" class="cover" src="{{item.coverImage}}" mode="aspectFill" lazy-load="{{true}}"/>
      </view>
      <view class="article-bottom">
        <view>
          <text wx:if="{{item.isFeatured}}" class="featured">重点</text>
          <text>{{activeTypeName}}</text>
          <text>{{item.section}}</text>
        </view>
        <text class="read">阅读全文 ›</text>
      </view>
    </view>
  </view>
</view>

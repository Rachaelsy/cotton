.page{min-height:100vh;padding-bottom:54rpx;background:#f4f7f4;color:#17241f}.hero{padding-right:28rpx;padding-bottom:24rpx;padding-left:28rpx;background:linear-gradient(145deg,#0b7659,#095e49);color:#fff}.hero.industry{background:linear-gradient(145deg,#176f5a,#0b5d4b)}.nav{display:flex;align-items:center;min-height:66rpx}.nav button,.nav-space{width:68rpx;flex:none}.nav button{margin:0;padding:0;border:0;background:transparent;color:#fff;font-size:52rpx;font-weight:300;line-height:62rpx}.nav button::after{border:0}.nav-title{display:flex;align-items:center;flex:1;min-width:0;flex-direction:column}.nav-title text{font-size:32rpx;font-weight:800;letter-spacing:1rpx}.nav-title small{margin-top:3rpx;color:rgba(255,255,255,.72);font-size:19rpx}.search{display:flex;align-items:center;height:68rpx;margin-top:20rpx;padding:0 19rpx;border:1rpx solid rgba(255,255,255,.15);border-radius:12rpx;background:rgba(255,255,255,.14)}.search input{height:68rpx;flex:1;min-width:0;margin:0 12rpx;color:#fff;font-size:24rpx}.search-placeholder{color:rgba(255,255,255,.68)}.search-icon{color:rgba(255,255,255,.86);font-size:29rpx}.clear{padding:12rpx 0 12rpx 12rpx;color:rgba(255,255,255,.88);font-size:29rpx}.tabs{width:100%;border-bottom:1rpx solid #e5eae6;background:#fff;white-space:nowrap}.tabs-inner{display:flex;width:max-content;padding:0 24rpx}.tabs button{position:relative;min-width:106rpx;margin:0 4rpx;padding:0 14rpx;border:0;background:transparent;color:#68736e;font-size:24rpx;font-weight:500;line-height:86rpx}.tabs button::after{border:0}.tabs button.on{color:#087657;font-weight:800}.tabs button.on::after{position:absolute;right:27rpx;bottom:0;left:27rpx;height:5rpx;border:0;border-radius:5rpx;background:#16a276;content:""}.demo-tip{margin:18rpx 24rpx 0;padding:15rpx 18rpx;border:1rpx solid #efe3bd;border-radius:9rpx;background:#fff9e9;color:#74643c;font-size:21rpx}.feed-head{display:flex;align-items:center;justify-content:space-between;padding:28rpx 28rpx 16rpx}.feed-title{display:flex;align-items:center}.feed-title>text{width:7rpx;height:29rpx;margin-right:12rpx;border-radius:6rpx;background:#10936d}.feed-title label{font-size:27rpx;font-weight:900}.feed-head small{color:#98a19d;font-size:20rpx}.feed{margin:0 22rpx;overflow:hidden;border:1rpx solid #e7ece8;border-radius:12rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(20,66,52,.035)}.article{display:flex;align-items:stretch;margin:0 22rpx;padding:27rpx 0;border-bottom:1rpx solid #e8ece9}.article:last-child{border-bottom:0}.article:active{background:#f8faf8}.article-copy{display:flex;flex:1;min-width:0;flex-direction:column}.labels{display:flex;align-items:center;height:28rpx;margin-bottom:10rpx}.labels text{margin-right:9rpx;color:#168061;font-size:19rpx}.labels .featured{padding:3rpx 8rpx;border-radius:4rpx;background:#eef8f3;color:#087657;font-weight:800}.article-title{display:-webkit-box;overflow:hidden;color:#17241f;font-size:29rpx;font-weight:800;line-height:1.47;-webkit-box-orient:vertical;-webkit-line-clamp:3}.meta{display:flex;align-items:center;margin-top:auto;padding-top:16rpx;color:#9aa29e;font-size:20rpx}.meta text{display:block;overflow:hidden;max-width:68%;text-overflow:ellipsis;white-space:nowrap}.meta text+text{margin-left:16rpx}.cover{width:190rpx;height:126rpx;flex:none;margin-left:22rpx;align-self:center;border-radius:9rpx;background:#edf2ef}.empty{display:flex;align-items:center;flex-direction:column;margin:0 22rpx;padding:82rpx 20rpx;border:1rpx solid #e7ece8;border-radius:12rpx;background:#fff}.empty text{color:#3c4843;font-size:25rpx;font-weight:700}.empty small{margin-top:10rpx;color:#9aa29e;font-size:21rpx}

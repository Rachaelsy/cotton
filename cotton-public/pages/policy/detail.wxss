.page{min-height:100vh;padding-bottom:calc(118rpx + env(safe-area-inset-bottom));background:#fff;color:#202124;box-sizing:border-box}.article-hero{position:relative;overflow:hidden;padding-bottom:42rpx;border-radius:0 0 44rpx 44rpx;background:linear-gradient(145deg,#0d5b43 0%,#17805d 62%,#2b9570 100%);color:#fff}.article-hero:after{position:absolute;right:-92rpx;bottom:-122rpx;width:330rpx;height:330rpx;border:1rpx solid rgba(255,255,255,.12);border-radius:50%;content:""}.article-hero.industry{background:linear-gradient(145deg,#125744 0%,#24775c 60%,#9b7a31 145%)}.top-nav{position:relative;z-index:2;display:flex;align-items:center;padding:8rpx 20rpx 10rpx}.top-nav button,.nav-space{width:70rpx}.top-nav button{margin:0;padding:0;border:0;background:transparent;color:#fff;font-size:54rpx;line-height:66rpx}.top-nav>text{flex:1;text-align:center;color:rgba(255,255,255,.88);font-size:24rpx;font-weight:700}.loading{padding:160rpx 30rpx;color:#999;text-align:center}.article-wrap{padding:0 34rpx}.article-head{position:relative;z-index:2;padding:31rpx 38rpx 10rpx}.article-kicker{display:inline-flex;padding:7rpx 16rpx;border:1rpx solid rgba(255,255,255,.2);border-radius:999rpx;background:rgba(255,255,255,.12);font-size:21rpx}.article-title{display:block;margin-top:20rpx;color:#fff;font-size:42rpx;font-weight:850;line-height:1.45;letter-spacing:.5rpx}.source-line{display:flex;align-items:center;flex-wrap:wrap;margin-top:20rpx;color:rgba(255,255,255,.68);font-size:22rpx}.source-line text{margin-right:19rpx}.source-line text:first-child{color:rgba(255,255,255,.9)}.article-body{padding:42rpx 0 36rpx;color:#26282b;font-size:31rpx;line-height:2.05;text-align:justify;word-break:break-all}.paragraph{display:block;margin-bottom:28rpx}.source-note{display:flex;flex-direction:column;padding:23rpx 0 30rpx;border-top:1rpx solid #eeeeef;color:#a0a3a8;font-size:21rpx;line-height:1.6}.source-note text+text{margin-top:4rpx}.source-note button{align-self:flex-start;margin:15rpx 0 0;padding:0 20rpx;border:1rpx solid #d7e4dd;border-radius:9rpx;background:#f5faf7;color:#176b4d;font-size:21rpx;line-height:51rpx}.comments{padding:22rpx 0 60rpx;border-top:14rpx solid #f4f7f5}.comments-title{display:flex;align-items:center;padding:7rpx 0 23rpx}.comments-title i{width:7rpx;height:31rpx;margin-right:13rpx;border-radius:5rpx;background:#16805d}.comments-title>text{font-size:29rpx;font-weight:800}.comments-title small{margin-left:10rpx;color:#a0a3a7;font-size:21rpx}.comment-empty{display:flex;align-items:center;flex-direction:column;padding:65rpx 20rpx;color:#a3a6aa;font-size:23rpx}.empty-icon{display:flex;align-items:center;justify-content:center;width:80rpx;height:80rpx;margin-bottom:17rpx;border-radius:50%;background:#eef5f1;color:#75a38f;font-size:26rpx}.comment{display:flex;padding:25rpx 0;border-top:1rpx solid #f0f0f1}.avatar{display:flex;align-items:center;justify-content:center;width:66rpx;height:66rpx;flex-shrink:0;border-radius:50%;background:#e9f1ec;color:#246b51;font-size:24rpx;font-weight:800}.comment-main{display:flex;flex:1;min-width:0;flex-direction:column;margin-left:17rpx}.comment-meta{display:flex;align-items:center;justify-content:space-between}.comment-meta text:first-child{color:#5c6670;font-size:23rpx}.comment-meta text:last-child{color:#afb2b6;font-size:19rpx}.comment-content{margin-top:10rpx;color:#27292c;font-size:25rpx;line-height:1.65}.bottom-bar{position:fixed;z-index:20;left:0;right:0;bottom:0;display:flex;align-items:center;height:calc(100rpx + env(safe-area-inset-bottom));padding:0 20rpx env(safe-area-inset-bottom);border-top:1rpx solid #e4ebe7;background:rgba(255,255,255,.98);box-shadow:0 -8rpx 24rpx rgba(22,72,54,.07);box-sizing:content-box}.comment-input{display:flex;align-items:center;height:66rpx;flex:1;min-width:0;padding:0 18rpx;border:1rpx solid #e3ebe6;border-radius:999rpx;background:#f3f7f5}.comment-input input{height:66rpx;flex:1;min-width:0;font-size:24rpx}.comment-input button{margin:0 0 0 9rpx;padding:0;background:transparent;color:#167553;font-size:22rpx;line-height:56rpx}.action-group{display:flex;flex:none;align-items:center;justify-content:flex-end;margin-left:13rpx;gap:7rpx}.action{display:flex;width:76rpx;height:72rpx;flex-shrink:0;align-items:center;flex-direction:column;justify-content:center;margin:0;border-radius:16rpx;color:#53635d}.action:active{background:#edf5f1}.action-icon{height:35rpx;color:#365b4d;font-size:29rpx;line-height:35rpx}.action-icon.active{color:#167553}.action small{margin-top:3rpx;font-size:19rpx;white-space:nowrap}.action.share{margin:0;padding:0;border:0;background:transparent;line-height:normal}

/* 固定右侧操作区，覆盖微信原生 button 的自动外边距与伸展规则。 */
.bottom-bar .comment-input{width:0;flex:1 1 auto}
.bottom-bar .action-group{width:252rpx;min-width:252rpx;flex:0 0 252rpx;margin:0 0 0 auto;padding-left:12rpx;gap:6rpx;box-sizing:border-box}
.bottom-bar .action-group .action{width:76rpx!important;min-width:76rpx!important;max-width:76rpx!important;height:76rpx;flex:0 0 76rpx!important;margin:0!important;padding:0!important;border:0!important;box-sizing:border-box}
.bottom-bar .action-group button.action{display:flex!important;background:transparent!important;line-height:normal!important}
.bottom-bar .action-group button.action::after{border:0!important}
.comment-send{flex:none;padding:0 10rpx;color:#aeb8b3;font-size:23rpx;font-weight:800;line-height:58rpx}
.comment-send.ready{color:#167553}

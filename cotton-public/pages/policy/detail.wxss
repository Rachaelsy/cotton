n-items:center;justify-content:center;width:80rpx;height:80rpx;margin-bottom:17rpx;border-radius:50%;background:#f5f5f6;color:#bec1c5;font-size:26rpx}.comment{display:flex;padding:25rpx 0;border-top:1rpx solid #f0f0f1}.avatar{display:flex;align-items:center;justify-content:center;width:66rpx;height:66rpx;flex-shrink:0;border-radius:50%;background:#e9f1ec;color:#246b51;font-size:24rpx;font-weight:800}.comment-main{display:flex;flex:1;min-width:0;flex-direction:column;margin-left:17rpx}.comment-meta{display:flex;align-items:center;justify-content:space-between}.comment-meta text:first-child{color:#5c6670;font-size:21rpx}.comment-meta text:last-child{color:#afb2b6;font-size:17rpx}.comment-content{margin-top:10rpx;color:#27292c;font-size:25rpx;line-height:1.65}.bottom-bar{position:fixed;z-index:20;left:0;right:0;bottom:0;display:flex;align-items:center;height:calc(100rpx + env(safe-area-inset-bottom));padding:0 20rpx env(safe-area-inset-bottom);border-top:1rpx solid #ececee;background:#fff;box-sizing:content-box}.comment-input{display:flex;align-items:center;height:66rpx;flex:1;min-width:0;padding:0 18rpx;border-radius:9rpx;background:#f5f5f6}.comment-input input{height:66rpx;flex:1;min-width:0;font-size:22rpx}.comment-input button{margin:0 0 0 9rpx;padding:0;background:transparent;color:#d9232e;font-size:20rpx;line-height:56rpx}.action{display:flex;width:87rpx;flex-shrink:0;align-items:center;flex-direction:column;justify-content:center;margin-left:5rpx;color:#5f6469}.action-icon{height:35rpx;font-size:29rpx;line-height:35rpx}.action-icon.active{color:#d9232e}.action small{margin-top:5rpx;font-size:17rpx}.action.share{margin-top:0;margin-bottom:0;padding:0;border:0;background:transparent;line-height:normal}

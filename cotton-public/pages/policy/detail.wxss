ht:31rpx;margin-right:13rpx;border-radius:5rpx;background:#1a7254}.section-title text{font-size:29rpx;font-weight:700}.summary,.paragraph{display:block;font-size:23rpx;line-height:1.8}.summary{color:#44584f}.paragraph{margin-top:15rpx;color:#68756f}.check-row,.material-row{display:flex;align-items:flex-start;padding:14rpx 0;border-bottom:1rpx solid #edf0ed}.check-row:last-child,.material-row:last-child{border-bottom:0}.check-row>text{display:flex;width:40rpx;height:40rpx;flex-shrink:0;align-items:center;justify-content:center;margin-right:14rpx;border-radius:50%;background:#e4f3eb;color:#197151;font-size:20rpx}.check-row>view,.material-row>view{flex:1;padding-top:4rpx;font-size:23rpx;line-height:1.55}.step-row{display:flex;position:relative;padding:10rpx 0 23rpx}.step-row>text{display:flex;width:48rpx;height:48rpx;z-index:1;flex-shrink:0;align-items:center;justify-content:center;margin-right:17rpx;border-radius:50%;background:#197151;color:#fff;font-size:20rpx}.step-row>view{display:flex;flex:1;min-width:0;flex-direction:column}.step-row small{color:#909993;font-size:18rpx}.step-row>view text{margin-top:4rpx;font-size:23rpx}.material-row>text{width:35rpx;flex-shrink:0;margin-right:12rpx;color:#1a7254;font-size:26rpx}.source-card{display:flex;flex-direction:column;margin:24rpx 28rpx;padding:27rpx;border:1rpx solid #dfe8e2;border-radius:25rpx;background:#edf5f0}.source-card>text{font-size:20rpx;color:#68766f}.source-card>view{margin-top:8rpx;font-size:25rpx;font-weight:700}.source-card>small{margin-top:7rpx;color:#849089;font-size:19rpx}.source-card button{margin:21rpx 0 0;border:1rpx solid #b9cec2;border-radius:18rpx;background:#fff;color:#176c4f;font-size:21rpx}

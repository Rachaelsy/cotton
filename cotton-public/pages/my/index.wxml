<view class="page">
  <view class="hero" style="padding-top:{{statusBarHeight + 30}}px">
    <view class="hero-orb orb-one"></view><view class="hero-orb orb-two"></view>
    <view class="brand">喀什优棉公共服务平台</view>
    <view class="profile">
      <view class="avatar">{{initial}}</view>
      <view class="profile-copy">
        <text class="name">{{loggedIn ? displayName : '你好，棉农朋友'}}</text>
        <text class="identity">{{loggedIn ? '公益学习用户 · 为每一块棉田服务' : '登录后同步地块与服务数据'}}</text>
        <button wx:if="{{loggedIn}}" plain bindtap="openProfile" style="align-self:flex-start;margin:14rpx 0 0;padding:0 18rpx;border:1rpx solid rgba(255,255,255,.34);border-radius:999rpx;background:rgba(255,255,255,.12);color:#fff;font-size:21rpx;line-height:48rpx">{{profileComplete ? '修改昵称' : '设置昵称'}}</button>
      </view>
      <button wx:if="{{!loggedIn}}" class="login-button" bindtap="login">登录</button>
    </view>
    <view class="summary">
      <view><text class="summary-number">{{plotCount}}</text><text class="summary-label">我的地块</text></view>
      <view><text class="summary-number">{{courseCount}}</text><text class="summary-label">已学课程</text></view>
      <view><text class="summary-number">{{collectedCount}}</text><text class="summary-label">资讯收藏</text></view>
    </view>
  </view>

  <view class="content">
    <view class="section-title"><text>个人服务</text></view>
    <view class="menu-card">
      <view class="menu-row" bindtap="openPage" data-key="verification">
        <view class="menu-icon green">✓</view><view class="menu-copy"><text>实名认证</text></view><text class="menu-status">{{verificationText}}</text><text class="arrow">›</text>
      </view>
      <view class="menu-row" bindtap="openPage" data-key="fields">
        <view class="menu-icon mint">田</view><view class="menu-copy"><text>我的地块</text></view><text class="arrow">›</text>
      </view>
      <view class="menu-row" bindtap="openPage" data-key="learning">
        <view class="menu-icon gold">学</view><view class="menu-copy"><text>我的学习</text></view><text class="arrow">›</text>
      </view>
    </view>

    <view class="section-title second"><text>更多服务</text></view>
    <view class="menu-card">
      <view class="menu-row" bindtap="openPage" data-key="collection">
        <view class="menu-icon peach">藏</view><view class="menu-copy"><text>收藏与评价</text></view><text class="arrow">›</text>
      </view>
      <view class="menu-row" bindtap="openPage" data-key="settings">
        <view class="menu-icon blue">设</view><view class="menu-copy"><text>设置与帮助</text></view><text class="arrow">›</text>
      </view>
      <view class="menu-row" bindtap="openPage" data-key="about">
        <view class="menu-icon gray">公</view><view class="menu-copy"><text>关于我们</text></view><text class="arrow">›</text>
      </view>
    </view>
    <button wx:if="{{loggedIn}}" class="logout" bindtap="logout">退出登录</button>
    <text class="footer">公共知识服务 · 不提供交易撮合</text>
  </view>
</view>

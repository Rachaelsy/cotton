.page{min-height:100vh;background:#f4f7f3;color:#1c372d}.hero{padding:100rpx 34rpx 42rpx;background:linear-gradient(145deg,#103f31,#26775a);color:#fff;border-radius:0 0 42rpx 42rpx}.brand{font-size:21rpx;letter-spacing:3rpx;opacity:.72}.profile{display:flex;align-items:center;gap:22rpx;margin-top:32rpx}.avatar{display:flex;align-items:center;justify-content:center;width:104rpx;height:104rpx;border-radius:50%;background:#f0c66c;color:#234d3d;font-size:38rpx;font-weight:700}.profile>view:last-child{display:flex;flex-direction:column;gap:10rpx}.profile strong{font-size:32rpx}.profile small{font-size:21rpx;opacity:.75}.hero button{margin:28rpx 0 0;background:#fff;color:#176d4f;border:0;border-radius:18rpx;font-size:25rpx}.stats{display:grid;grid-template-columns:repeat(3,1fr);margin:-4rpx 28rpx 26rpx;padding:28rpx;background:#fff;border-radius:0 0 26rpx 26rpx}.stats view{display:flex;flex-direction:column;align-items:center;gap:8rpx}.stats strong{font-size:31rpx;color:#176d4f}.stats small{font-size:20rpx;color:#829089}.menu{margin:26rpx 28rpx;background:#fff;border-radius:26rpx;padding:0 25rpx}.menu>view{display:grid;grid-template-columns:60rpx 1fr 30rpx;align-items:center;gap:14rpx;padding:25rpx 0;border-bottom:1rpx solid #edf0ed}.menu>view:last-child{border-bottom:0}.menu i{display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;border-radius:15rpx;background:#e5f2eb;color:#176d4f;font-style:normal}.menu text{font-size:25rpx}.menu b{font-size:35rpx;color:#9aa39e}.logout{margin:30rpx 28rpx;background:#fff;color:#a24c42;border:0;border-radius:20rpx;font-size:25rpx}

.page{padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}.stats{display:flex;flex-direction:row}.stats>view{flex:1;min-width:0}.menu>view{display:flex;flex-direction:row}.menu i{flex-shrink:0;margin-right:14rpx}.menu text{flex:1;min-width:0}.menu b{flex-shrink:0;margin-left:14rpx}

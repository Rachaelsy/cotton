.page{min-height:100vh;background:#f3f6f2;color:#173b2e;padding-bottom:calc(150rpx + env(safe-area-inset-bottom));box-sizing:border-box}.hero{position:relative;overflow:hidden;padding:0 32rpx 34rpx;background:linear-gradient(145deg,#0b4b38,#16845f);color:#fff;border-radius:0 0 44rpx 44rpx}.hero-orb{position:absolute;border-radius:50%;background:rgba(255,255,255,.08)}.orb-one{width:300rpx;height:300rpx;right:-100rpx;top:-80rpx}.orb-two{width:160rpx;height:160rpx;left:-70rpx;bottom:20rpx}.brand{position:relative;font-size:23rpx;letter-spacing:3rpx;opacity:.78}.profile{position:relative;display:flex;align-items:center;margin-top:28rpx}.avatar{display:flex;align-items:center;justify-content:center;width:96rpx;height:96rpx;flex-shrink:0;border:4rpx solid rgba(255,255,255,.3);border-radius:50%;background:#f4cd71;color:#205541;font-size:34rpx;font-weight:800}.profile-copy{display:flex;flex:1;min-width:0;flex-direction:column;margin-left:20rpx}.name{font-size:33rpx;font-weight:800}.identity{margin-top:10rpx;color:rgba(255,255,255,.72);font-size:23rpx}.login-button{width:112rpx;margin:0 0 0 14rpx;padding:0;background:#fff;color:#126d50;border:0;border-radius:30rpx;font-size:25rpx;line-height:60rpx}.summary{position:relative;display:flex;margin-top:30rpx;padding:22rpx 8rpx;border:1rpx solid rgba(255,255,255,.18);border-radius:24rpx;background:rgba(255,255,255,.1);backdrop-filter:blur(8px)}.summary>view{display:flex;flex:1;flex-direction:column;align-items:center;border-right:1rpx solid rgba(255,255,255,.16)}.summary>view:last-child{border-right:0}.summary-number{font-size:30rpx;font-weight:800}.summary-label{margin-top:5rpx;color:rgba(255,255,255,.7);font-size:22rpx}.content{padding:30rpx 26rpx}.section-title{display:flex;align-items:center;justify-content:space-between;padding:0 8rpx 16rpx}.section-title text:first-child{font-size:28rpx;font-weight:800}.section-note{color:#98a29c;font-size:22rpx}.second{margin-top:30rpx}.menu-card{overflow:hidden;border-radius:26rpx;background:#fff;box-shadow:0 10rpx 32rpx rgba(28,65,48,.055)}.menu-row{display:flex;align-items:center;min-height:106rpx;margin:0 24rpx;border-bottom:1rpx solid #edf0ec}.menu-row:last-child{border-bottom:0}.menu-icon{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;flex-shrink:0;border-radius:18rpx;font-size:25rpx;font-weight:800}.green,.mint{background:#e3f3ea;color:#177152}.gold{background:#fff1ce;color:#9c6a10}.peach{background:#fce9dc;color:#a55d30}.blue{background:#e4f1f6;color:#34738b}.gray{background:#edf0eb;color:#5e7167}.menu-copy{display:flex;flex:1;min-width:0;flex-direction:column;margin-left:18rpx}.menu-copy text{font-size:27rpx;font-weight:700}.menu-status{margin-left:8rpx;color:#1d7b59;font-size:22rpx}.arrow{margin-left:12rpx;color:#a4ada7;font-size:38rpx;font-weight:300}.logout{margin-top:30rpx;background:#fff;color:#a64d44;border:0;border-radius:22rpx;font-size:25rpx;line-height:86rpx}

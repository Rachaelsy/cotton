.page{height:100vh;background:#f3f6f2;color:#173b2e}.nav{display:flex;align-items:center;justify-content:space-between;padding:0 24rpx 18rpx;background:#fff;font-size:31rpx;font-weight:800}.back,.space{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx}.back{border-radius:50%;background:#eef4ee;font-size:45rpx}.content{height:calc(100vh - 100rpx);padding:24rpx;box-sizing:border-box}.hero{display:flex;align-items:center;flex-direction:column;padding:50rpx 28rpx;border-radius:30rpx;background:linear-gradient(145deg,#104d3a,#218765);color:#fff;text-align:center}.logo{display:flex;align-items:center;justify-content:center;width:104rpx;height:104rpx;border-radius:30rpx;background:#f2cb6e;color:#19523e;font-size:39rpx;font-weight:900;box-shadow:0 14rpx 32rpx rgba(0,0,0,.15)}.title{margin-top:22rpx;font-size:33rpx;font-weight:900}.slogan{margin-top:13rpx;color:rgba(255,255,255,.75);font-size:23rpx}.version{margin-top:22rpx;padding:7rpx 18rpx;border-radius:18rpx;background:rgba(255,255,255,.12);font-size:20rpx}.card{margin-top:22rpx;padding:28rpx;border-radius:25rpx;background:#fff}.card-title{display:block;margin-bottom:17rpx;font-size:27rpx;font-weight:800}.paragraph{color:#64736a;font-size:24rpx;line-height:1.85}.services{display:flex}.services view{display:flex;flex:1;align-items:center;flex-direction:column}.services text:first-child{display:flex;align-items:center;justify-content:center;width:60rpx;height:60rpx;border-radius:18rpx;background:#e4f2e9;color:#187554;font-size:23rpx;font-weight:800}.services text:last-child{margin-top:10rpx;color:#66746b;font-size:21rpx}.boundary view{display:flex;align-items:flex-start;margin-top:16rpx;color:#647269;font-size:23rpx;line-height:1.65}.boundary view text:first-child{margin-right:12rpx;color:#187554;font-weight:900}.quick{display:flex;gap:18rpx;margin-top:22rpx}.quick view{display:flex;flex:1;min-width:0;padding:24rpx;border-radius:22rpx;background:#fff}.quick text{color:#1e7a59;font-size:24rpx;font-weight:800}

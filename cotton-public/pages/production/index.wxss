.page{min-height:100vh;padding-bottom:48rpx;background:#f2f6f3;color:#17372c}.hero{padding-right:28rpx;padding-bottom:34rpx;padding-left:28rpx;border-radius:0 0 42rpx 42rpx;background:linear-gradient(145deg,#0b5d45,#13805e 70%,#27936d);color:#fff;box-shadow:0 14rpx 34rpx rgba(17,91,68,.14)}.nav{display:flex;align-items:center}.nav button,.nav>view{width:72rpx;flex:none}.nav button{margin:0;padding:0;border:0;background:transparent;color:#fff;font-size:52rpx;line-height:64rpx}.nav button::after{border:0}.nav>text{flex:1;text-align:center;font-size:31rpx;font-weight:800}.hero-main{display:flex;align-items:center;margin-top:28rpx}.hero-icon{display:flex;align-items:center;justify-content:center;width:94rpx;height:94rpx;flex:none;border:1rpx solid rgba(255,255,255,.24);border-radius:30rpx;background:rgba(255,255,255,.15);font-size:35rpx;font-weight:900}.hero-main>view:last-child{display:flex;min-width:0;flex-direction:column;margin-left:22rpx}.hero-main text{font-size:34rpx;font-weight:850}.hero-main small{margin-top:8rpx;color:rgba(255,255,255,.76);font-size:20rpx;line-height:1.5}.tabs{display:flex;margin:20rpx 22rpx 0;padding:6rpx;border-radius:18rpx;background:#fff;box-shadow:0 9rpx 25rpx rgba(26,65,51,.07)}.tabs button{height:66rpx;min-width:0;flex:1;margin:0;border:0;border-radius:13rpx;background:transparent;color:#718078;font-size:22rpx;line-height:66rpx}.tabs button::after{border:0}.tabs button.on{background:#e7f5ee;color:#147252;font-weight:850}.section{margin:20rpx 22rpx 0;padding:26rpx 24rpx 8rpx;border-radius:26rpx;background:#fff;box-shadow:0 9rpx 28rpx rgba(26,65,51,.055)}.section-title{display:flex;align-items:flex-end;justify-content:space-between;padding-bottom:18rpx}.section-title text{font-size:28rpx;font-weight:850}.section-title small{color:#98a29d;font-size:18rpx}.service-item{display:flex;align-items:center;padding:22rpx 0;border-top:1rpx solid #edf1ee}.item-icon{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;flex:none;border-radius:20rpx;background:#e3f3eb;color:#167452;font-size:23rpx;font-weight:850}.item-copy{display:flex;min-width:0;flex:1;flex-direction:column;margin-left:18rpx}.item-copy text{font-size:24rpx;font-weight:750}.item-copy small{margin-top:6rpx;color:#86928c;font-size:19rpx;line-height:1.45}.arrow{margin-left:12rpx;color:#a1aea8;font-size:36rpx}.tips{padding-bottom:22rpx}.tip{display:flex;align-items:center;padding:14rpx 0}.tip>text{display:flex;align-items:center;justify-content:center;width:40rpx;height:40rpx;flex:none;border-radius:50%;background:#fff2ce;color:#936916;font-size:18rpx;font-weight:800}.tip label{margin-left:15rpx;color:#4c6057;font-size:21rpx}.boundary{display:flex;margin:20rpx 22rpx 0;padding:23rpx 24rpx;border:1rpx solid #e6ddd0;border-radius:22rpx;background:#fffaf2;flex-direction:column}.boundary text{color:#836126;font-size:22rpx;font-weight:800}.boundary small{margin-top:8rpx;color:#827765;font-size:19rpx;line-height:1.6}

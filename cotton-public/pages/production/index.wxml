<view class="page">
  <view class="hero" style="padding-top:{{statusBarHeight + 12}}px">
    <view class="nav"><button bindtap="back">‹</button><text>加工服务</text><view></view></view>
    <view class="hero-main"><view class="hero-icon">{{service.icon}}</view><view><text>{{service.name}}</text><small>{{service.intro}}</small></view></view>
  </view>

  <view class="section">
    <view class="section-title"><text>服务分类</text><small>选择需要了解的服务</small></view>
    <view class="service-item" wx:for="{{service.items}}" wx:key="title" data-index="{{index}}" bindtap="openItem">
      <view class="item-icon">{{item.icon}}</view>
      <view class="item-copy"><text>{{item.title}}</text><small>{{item.desc}}</small></view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="section tips">
    <view class="section-title"><text>服务提示</text><small>交易或预约前请注意</small></view>
    <view class="tip" wx:for="{{service.tips}}" wx:key="*this"><text>{{index + 1}}</text><label>{{item}}</label></view>
  </view>

  <view class="boundary"><text>公益服务说明</text><small>当前页面提供生产服务信息和入口指引，不直接提供交易、收款或履约担保。服务机构接入后将展示资质核验状态。</small></view>
</view>

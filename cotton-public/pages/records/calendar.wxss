.page{min-height:100vh;background:#f4f7f3;color:#1d382e}.head{display:grid;grid-template-columns:80rpx 1fr 80rpx;align-items:center;padding:94rpx 30rpx 32rpx;background:linear-gradient(145deg,#166849,#25805e);color:#fff}.head button{margin:0;padding:0;background:rgba(255,255,255,.15);color:#fff;width:62rpx;line-height:60rpx;border-radius:50%;font-size:44rpx}.head view{display:flex;flex-direction:column;text-align:center}.head strong{font-size:34rpx}.head small{font-size:23rpx;opacity:.7;margin-top:6rpx}.calendar,.records{margin:28rpx;background:#fff;border-radius:28rpx;padding:28rpx}.month{display:flex;align-items:center;justify-content:space-between}.month button{margin:0;background:#edf5f0;color:#176d4f;width:62rpx;line-height:58rpx;border-radius:50%;font-size:36rpx}.month strong{font-size:30rpx}.weeks,.days{display:grid;grid-template-columns:repeat(7,1fr);text-align:center}.weeks{margin-top:26rpx;color:#849089;font-size:23rpx}.weeks text{padding:12rpx 0}.day{position:relative;height:78rpx;display:flex;align-items:center;justify-content:center;border-radius:20rpx;font-size:24rpx}.day.has{font-weight:700;color:#176d4f}.day.selected{background:#176d4f;color:#fff}.day i{position:absolute;width:8rpx;height:8rpx;border-radius:50%;background:#d4a03c;bottom:8rpx}.list-title{font-size:28rpx;font-weight:700;margin-bottom:20rpx}.empty{padding:55rpx 0;text-align:center;color:#929c96;font-size:25rpx}.record{display:grid;grid-template-columns:24rpx 1fr;gap:16rpx;padding:22rpx 0;border-top:1rpx solid #edf0ed}.dot{width:16rpx;height:16rpx;border-radius:50%;background:#d4a03c;margin-top:9rpx}.record view{display:flex;flex-direction:column;gap:7rpx}.record strong{font-size:26rpx}.record text,.record small{font-size:24rpx;color:#77837d}

.head{display:flex;flex-direction:row}.head button{flex-shrink:0;margin-right:18rpx}.head>view{flex:1;min-width:0}.head>text{width:62rpx;flex-shrink:0}.weeks,.days{display:flex;flex-direction:row;flex-wrap:wrap}.weeks text,.day{width:14.2857%;box-sizing:border-box}.record{display:flex;flex-direction:row}.dot{flex-shrink:0;margin-right:16rpx}.record>view{flex:1;min-width:0}

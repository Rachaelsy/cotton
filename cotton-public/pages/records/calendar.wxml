<view class="page"><view class="head"><button bindtap="back">‹</button><view><strong>农事日历</strong><small>按日期回看田间工作</small></view><text></text></view>
<view class="calendar"><view class="month"><button bindtap="prev">‹</button><strong>{{label}}</strong><button bindtap="next">›</button></view><view class="weeks"><text wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">{{item}}</text></view><view class="days"><view wx:for="{{days}}" wx:key="key" class="day {{item.has?'has':''}} {{selectedDate===item.date?'selected':''}}" data-date="{{item.date}}" bindtap="choose"><text wx:if="{{!item.empty}}">{{item.day}}</text><i wx:if="{{item.has}}"></i></view></view></view>
<view class="records"><view class="list-title">{{selectedDate || '选择日期查看记录'}}</view><view class="empty" wx:if="{{selectedDate && !selectedRecords.length}}">当天暂无农事记录</view><view class="record" wx:for="{{selectedRecords}}" wx:key="id"><view class="dot"></view><view><strong>{{item.activity_type || item.type || '农事活动'}}</strong><text>{{item.plot_name || '未指定地块'}}</text><small>{{item.description || item.notes || '暂无备注'}}</small></view></view></view></view>

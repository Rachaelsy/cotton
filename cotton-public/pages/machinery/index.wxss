.page{min-height:100vh;padding-bottom:50rpx;background:linear-gradient(180deg,#eaf5f0,#f4f7f5 420rpx);color:#17352b}.hero{padding-right:28rpx;padding-bottom:30rpx;padding-left:28rpx;border-radius:0 0 42rpx 42rpx;background:linear-gradient(145deg,#075a44,#0e7a59 66%,#278f6c);color:#fff;box-shadow:0 15rpx 36rpx rgba(9,91,67,.17)}.nav{display:flex;align-items:center}.nav button,.nav>view{width:72rpx;flex:none}.nav button{margin:0;padding:0;border:0;background:transparent;color:#fff;font-size:52rpx;line-height:64rpx}.nav button::after,.view-tabs button::after,.work-tabs button::after{border:0}.nav>text{flex:1;text-align:center;font-size:31rpx;font-weight:850}.hero-content{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx}.hero-content>view:first-child{display:flex;min-width:0;flex-direction:column}.hero-content text{font-size:35rpx;font-weight:900}.hero-content small{margin-top:9rpx;color:rgba(255,255,255,.75);font-size:20rpx}.hero-mark{display:flex;align-items:center;justify-content:center;width:82rpx;height:82rpx;flex:none;margin-left:18rpx;border:1rpx solid rgba(255,255,255,.22);border-radius:27rpx;background:rgba(255,255,255,.14);font-size:31rpx;font-weight:900}.summary{display:flex;margin-top:27rpx;padding:18rpx 0;border:1rpx solid rgba(255,255,255,.13);border-radius:22rpx;background:rgba(255,255,255,.1)}.summary>view{display:flex;flex:1;align-items:center;border-right:1rpx solid rgba(255,255,255,.14);flex-direction:column}.summary>view:last-child{border-right:0}.summary strong{font-size:27rpx}.summary small{margin-top:4rpx;color:rgba(255,255,255,.68);font-size:17rpx}.view-tabs{display:flex;margin:20rpx 22rpx 0;padding:6rpx;border-radius:18rpx;background:#fff;box-shadow:0 9rpx 26rpx rgba(25,70,53,.07)}.view-tabs button{height:68rpx;min-width:0;flex:1;margin:0;border:0;border-radius:13rpx;background:transparent;color:#74827b;font-size:23rpx;line-height:68rpx}.view-tabs button.on{background:#e6f5ed;color:#0f7553;font-weight:850}.work-tabs{display:flex;margin:16rpx 22rpx 0;padding:12rpx;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(25,70,53,.055)}.work-tabs button{display:flex;height:86rpx;min-width:0;flex:1;align-items:center;margin:0 4rpx;padding:0;border:0;border-radius:16rpx;background:#f6f9f7;color:#708078;flex-direction:column;justify-content:center}.work-tabs button>text{font-size:23rpx;font-weight:850}.work-tabs button small{margin-top:4rpx;font-size:17rpx}.work-tabs button.on{background:linear-gradient(145deg,#16815f,#0c6a4e);color:#fff;box-shadow:0 7rpx 16rpx rgba(12,106,78,.2)}.feature-card{margin:18rpx 22rpx 0;padding:28rpx 25rpx;border:1rpx solid #e4ede8;border-radius:28rpx;background:#fff;box-shadow:0 10rpx 30rpx rgba(25,70,53,.06)}.feature-head{display:flex;align-items:center}.feature-icon{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;border-radius:23rpx;background:#e1f2e9;color:#117354;font-size:27rpx;font-weight:900}.feature-head>view:last-child{display:flex;flex-direction:column;margin-left:17rpx}.feature-head text{font-size:28rpx;font-weight:850}.feature-head small{margin-top:4rpx;color:#ae7c21;font-size:18rpx}.intro{display:block;margin-top:20rpx;color:#52675e;font-size:21rpx;line-height:1.7}.sub-title{margin-top:24rpx;padding-left:11rpx;border-left:6rpx solid #15916b;font-size:23rpx;font-weight:850}.chips{display:flex;flex-wrap:wrap;margin-top:13rpx}.chips text{margin:0 10rpx 10rpx 0;padding:9rpx 13rpx;border-radius:9rpx;background:#eff6f2;color:#3c6756;font-size:18rpx}.point{display:flex;align-items:flex-start;margin-top:15rpx}.point text{display:flex;align-items:center;justify-content:center;width:34rpx;height:34rpx;flex:none;border-radius:50%;background:#e4f4ec;color:#137653;font-size:17rpx;font-weight:900}.point label{margin-left:12rpx;color:#4d6158;font-size:20rpx;line-height:1.55}.model-list{margin:18rpx 22rpx 0}.model-card{display:flex;margin-bottom:14rpx;padding:24rpx;border:1rpx solid #e4ede8;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(25,70,53,.05)}.model-icon{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;flex:none;border-radius:23rpx;background:linear-gradient(145deg,#dff2e9,#edf8f3);color:#137552;font-size:25rpx;font-weight:900}.model-copy{display:flex;min-width:0;flex:1;flex-direction:column;margin-left:18rpx}.model-copy>view{display:flex;align-items:center}.model-copy text{font-size:25rpx;font-weight:850}.model-copy label{margin-left:10rpx;padding:4rpx 9rpx;border-radius:7rpx;background:#fff2d2;color:#966a18;font-size:16rpx}.model-copy small{margin-top:9rpx;color:#64746d;font-size:19rpx;line-height:1.55}.model-copy strong{margin-top:9rpx;color:#168060;font-size:17rpx;font-weight:650}.notice{display:flex;margin:20rpx 22rpx 0;padding:23rpx 24rpx;border:1rpx solid #e7ddcc;border-radius:22rpx;background:#fffaf1;flex-direction:column}.notice text{color:#836025;font-size:21rpx;font-weight:850}.notice small{margin-top:8rpx;color:#7c725f;font-size:18rpx;line-height:1.65}

.page{min-height:100vh;padding-bottom:50rpx;background:linear-gradient(180deg,#eaf5f0,#f4f7f5 420rpx);color:#17352b}.hero{padding-right:28rpx;padding-bottom:30rpx;padding-left:28rpx;border-radius:0 0 42rpx 42rpx;background:linear-gradient(145deg,#075a44,#0e7a59 66%,#278f6c);color:#fff;box-shadow:0 15rpx 36rpx rgba(9,91,67,.17)}.nav{display:flex;align-items:center}.nav button,.nav>view{width:72rpx;flex:none}.nav button{margin:0;padding:0;border:0;background:transparent;color:#fff;font-size:52rpx;line-height:64rpx}.nav button::after,.category-tabs button::after{border:0}.nav>text{flex:1;text-align:center;font-size:31rpx;font-weight:850}.hero-content{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx}.hero-content>view:first-child{display:flex;min-width:0;flex-direction:column}.hero-content text{font-size:35rpx;font-weight:900}.hero-content small{margin-top:9rpx;color:rgba(255,255,255,.75);font-size:22rpx}.hero-mark{display:flex;align-items:center;justify-content:center;width:82rpx;height:82rpx;flex:none;margin-left:18rpx;border:1rpx solid rgba(255,255,255,.22);border-radius:27rpx;background:rgba(255,255,255,.14);font-size:31rpx;font-weight:900}.summary{display:flex;margin-top:27rpx;padding:18rpx 0;border:1rpx solid rgba(255,255,255,.13);border-radius:22rpx;background:rgba(255,255,255,.1)}.summary>view{display:flex;flex:1;align-items:center;border-right:1rpx solid rgba(255,255,255,.14);flex-direction:column}.summary>view:last-child{border-right:0}.summary strong{font-size:27rpx}.summary small{margin-top:4rpx;color:rgba(255,255,255,.68);font-size:19rpx}.category-tabs{display:flex;margin:20rpx 22rpx 0;padding:11rpx;border-radius:22rpx;background:#fff;box-shadow:0 9rpx 26rpx rgba(25,70,53,.07)}.category-tabs button{display:flex;height:86rpx;min-width:0;flex:1;align-items:center;margin:0 4rpx;padding:0;border:0;border-radius:16rpx;background:#f6f9f7;color:#708078;flex-direction:column;justify-content:center}.category-tabs button text{font-size:25rpx;font-weight:850}.category-tabs button small{margin-top:4rpx;font-size:18rpx}.category-tabs button.on{background:linear-gradient(145deg,#16815f,#0c6a4e);color:#fff;box-shadow:0 7rpx 16rpx rgba(12,106,78,.2)}.section-head{display:flex;margin:27rpx 24rpx 13rpx}.section-head>view{display:flex;flex-direction:column}.section-head text{font-size:28rpx;font-weight:900}.section-head small{margin-top:5rpx;color:#89968f;font-size:20rpx}.product-list{margin:0 22rpx}.product-card{margin-bottom:16rpx;padding:24rpx;border:1rpx solid #e2ebe6;border-radius:27rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(25,70,53,.06)}.product-top{display:flex}.cover{width:184rpx;height:146rpx;flex:none;border-radius:18rpx;background:#edf4f0}.placeholder{display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,#daf0e6,#edf8f3);color:#167553;font-size:46rpx;font-weight:900}.product-copy{display:flex;min-width:0;flex:1;flex-direction:column;margin-left:19rpx}.tags{display:flex;align-items:center}.tags text,.tags label{margin-right:8rpx;padding:4rpx 9rpx;border-radius:7rpx;background:#e8f5ee;color:#147453;font-size:17rpx}.tags label{background:#fff2d2;color:#936a1b}.product-copy strong{display:-webkit-box;overflow:hidden;margin-top:10rpx;font-size:27rpx;line-height:1.4;-webkit-box-orient:vertical;-webkit-line-clamp:2}.product-copy>small{margin-top:6rpx;color:#64756d;font-size:20rpx}.brand{margin-top:auto;color:#23805f;font-size:19rpx}.intro{display:block;margin-top:20rpx;color:#55675e;font-size:22rpx;line-height:1.65}.features{display:flex;flex-wrap:wrap;margin-top:14rpx}.features text{margin:0 9rpx 9rpx 0;padding:7rpx 11rpx;border-radius:8rpx;background:#f0f6f3;color:#3e6757;font-size:19rpx}.product-foot{display:flex;align-items:center;justify-content:space-between;margin-top:12rpx;padding-top:14rpx;border-top:1rpx solid #edf1ee;color:#66776e;font-size:19rpx}.product-foot>text{overflow:hidden;max-width:75%;text-overflow:ellipsis;white-space:nowrap}.product-foot small{color:#a07a30}.empty{display:flex;align-items:center;flex-direction:column;margin:0 22rpx;padding:70rpx 20rpx;border:1rpx solid #e2ebe6;border-radius:27rpx;background:#fff;color:#354a41;font-size:25rpx;font-weight:800;box-shadow:0 10rpx 28rpx rgba(25,70,53,.05)}.empty small{margin-top:9rpx;color:#929e98;font-size:20rpx;font-weight:400}.notice{margin:20rpx 22rpx 0;padding:21rpx 23rpx;border:1rpx solid #e7ddcc;border-radius:21rpx;background:#fffaf1;color:#7c725f;font-size:20rpx;line-height:1.65}

<view class="page"><view class="nav" style="padding-top:{{statusBarHeight}}px"><view class="back" bindtap="back">‹</view><text>设置与帮助</text><view class="space"></view></view><scroll-view class="content" scroll-y>
  <view class="section-title">通用设置</view><view class="card"><view class="row" bindtap="openSettings"><view class="icon green">权</view><view class="copy"><text>系统权限管理</text></view><text class="arrow">›</text></view><view class="row" bindtap="clearCache"><view class="icon blue">清</view><view class="copy"><text>清理临时缓存</text></view><text class="arrow">›</text></view><view class="row" bindtap="openFeedback"><view class="icon gold">问</view><view class="copy"><text>问题与建议</text></view><text class="arrow">›</text></view></view>
  <view class="section-title">常见问题</view><view class="card faq"><view class="faq-item" wx:for="{{faq}}" wx:key="q" data-index="{{index}}" bindtap="toggleFaq"><view class="faq-question"><text>{{item.q}}</text><text>{{openFaq===index?'−':'＋'}}</text></view><text wx:if="{{openFaq===index}}" class="faq-answer">{{item.a}}</text></view></view>
  <button wx:if="{{loggedIn}}" class="logout" bindtap="logout">退出登录</button><button wx:if="{{!loggedIn}}" class="login" bindtap="login">登录 / 注册</button><text class="hint">涉及生产决策时，请结合当地官方信息与田间实际。</text>
</scroll-view></view>

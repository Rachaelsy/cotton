.page{height:100vh;background:#f3f6f2;color:#173b2e}.nav{display:flex;align-items:center;justify-content:space-between;padding:0 24rpx 18rpx;background:#fff;font-size:31rpx;font-weight:800}.back,.space{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx}.back{border-radius:50%;background:#eef4ee;font-size:45rpx}.content{height:calc(100vh - 100rpx);padding:24rpx;box-sizing:border-box}.section-title{margin:12rpx 8rpx 14rpx;color:#65736b;font-size:21rpx}.card{overflow:hidden;margin-bottom:28rpx;border-radius:24rpx;background:#fff}.row{display:flex;align-items:center;min-height:108rpx;margin:0 24rpx;border-bottom:1rpx solid #edf0ed}.row:last-child{border-bottom:0}.icon{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;border-radius:18rpx;font-size:22rpx;font-weight:800}.green{background:#e4f3ea;color:#187554}.blue{background:#e6f1f5;color:#397489}.gold{background:#fff0cd;color:#9a6c18}.copy{display:flex;flex:1;flex-direction:column;margin-left:17rpx}.copy text:first-child{font-size:25rpx;font-weight:700}.copy text:last-child{margin-top:7rpx;color:#8c958f;font-size:20rpx}.arrow{color:#a2aba5;font-size:38rpx}.faq-item{padding:26rpx;border-bottom:1rpx solid #edf0ed}.faq-item:last-child{border-bottom:0}.faq-question{display:flex;align-items:center;justify-content:space-between;font-size:24rpx;font-weight:700}.faq-question text:last-child{color:#187554;font-size:31rpx}.faq-answer{display:block;margin-top:16rpx;color:#6f7d74;font-size:21rpx;line-height:1.75}.logout,.login{margin-top:12rpx;border-radius:22rpx;font-size:25rpx;line-height:84rpx}.logout{background:#fff;color:#a64d44}.login{background:#187554;color:#fff}.hint{display:block;padding:24rpx;text-align:center;color:#9aa39d;font-size:19rpx;line-height:1.6}

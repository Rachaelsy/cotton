.page{height:100vh;overflow:hidden;background:#f3f7f4;color:#173b2e}.header{position:relative;padding:24rpx 28rpx 34rpx;background:linear-gradient(145deg,#07563f 0%,#11795a 65%,#2b956f 100%);border-radius:0 0 46rpx 46rpx;color:#fff;box-shadow:0 14rpx 36rpx rgba(12,83,61,.17)}.header::after{position:absolute;right:-70rpx;bottom:-90rpx;width:280rpx;height:280rpx;border:1rpx solid rgba(255,255,255,.12);border-radius:50%;content:""}.header-row{display:flex;align-items:center;min-height:68rpx}.back{display:flex;width:58rpx;height:58rpx;align-items:center;justify-content:center;margin-right:14rpx;border:1rpx solid rgba(255,255,255,.2);border-radius:19rpx;background:rgba(255,255,255,.1);font-size:48rpx;line-height:1}.header-copy{display:flex;flex-direction:column}.header-copy text{font-size:34rpx;font-weight:850}.header-copy small{margin-top:4rpx;color:rgba(255,255,255,.68);font-size:20rpx}.date-card{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;margin-top:25rpx;padding:22rpx 24rpx;border:1rpx solid rgba(255,255,255,.17);border-radius:24rpx;background:rgba(255,255,255,.11)}.date-card>view:first-child{display:flex;flex-direction:column}.date-card small{color:rgba(255,255,255,.68);font-size:19rpx}.date-card strong{margin-top:5rpx;font-size:27rpx}.date-actions{display:flex;align-items:center;gap:10rpx}.today,.calendar{padding:11rpx 16rpx;border-radius:999rpx;font-size:20rpx}.today{background:rgba(255,255,255,.14)}.calendar{background:#fff;color:#126c50;font-weight:750}.summary{position:relative;z-index:1;display:flex;margin-top:22rpx}.summary view{display:flex;width:33.33%;align-items:center;flex-direction:column;border-right:1rpx solid rgba(255,255,255,.14)}.summary view:last-child{border-right:0}.summary strong{font-size:37rpx}.summary small{margin-top:4rpx;color:rgba(255,255,255,.68);font-size:19rpx}.content-scroll{height:calc(100vh - 540rpx)}.content{padding:26rpx 24rpx}.group{overflow:hidden;margin-bottom:22rpx;border:1rpx solid rgba(30,113,80,.09);border-radius:28rpx;background:#fff;box-shadow:0 9rpx 28rpx rgba(25,74,56,.06)}.group-head{display:flex;align-items:center;padding:22rpx 24rpx;background:linear-gradient(100deg,#eaf7f0,#f7fbf8)}.plot-symbol{display:flex;width:56rpx;height:56rpx;align-items:center;justify-content:center;flex:none;border-radius:18rpx;background:#d8efe4;color:#147252;font-size:25rpx;font-weight:900}.plot-copy{display:flex;min-width:0;flex:1;flex-direction:column;margin-left:15rpx}.plot-copy strong{font-size:27rpx}.plot-copy text{margin-top:4rpx;color:#7b9087;font-size:19rpx}.group-head>label{padding:6rpx 12rpx;border-radius:999rpx;background:#fff;color:#247658;font-size:19rpx}.task{display:flex;padding:22rpx 24rpx 0}.task:last-child{padding-bottom:23rpx}.task-line{display:flex;width:42rpx;flex:none;align-items:center;flex-direction:column}.task-number{display:flex;width:38rpx;height:38rpx;align-items:center;justify-content:center;border-radius:13rpx;background:#e0f2e8;color:#167252;font-size:20rpx;font-weight:850}.task-line .line{width:2rpx;flex:1;margin-top:8rpx;background:#e5eee9}.task:last-child .line{display:none}.task.important .task-number{background:#fff0cf;color:#986918}.task.urgent .task-number{background:#fde7e0;color:#ad503b}.task-main{min-width:0;flex:1;padding:0 0 22rpx 14rpx;border-bottom:1rpx solid #edf1ee}.task:last-child .task-main{padding-bottom:0;border-bottom:0}.task-title{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.task-title strong{font-size:26rpx;line-height:1.45}.task-title label{flex:none;padding:4rpx 10rpx;border-radius:999rpx;background:#edf5f1;color:#5d786c;font-size:18rpx}.task.important .task-title label{background:#fff5df;color:#956b22}.task.urgent .task-title label{background:#fff0eb;color:#a64d39}.task-content{display:block;margin-top:9rpx;color:#60736a;font-size:22rpx;line-height:1.65}.task-time{display:flex;align-items:center;margin-top:10rpx;color:#267d5e;font-size:20rpx}.task-time text{margin-right:7rpx}.state{display:flex;min-height:440rpx;align-items:center;justify-content:center;flex-direction:column;padding:36rpx;border-radius:28rpx;background:#fff;text-align:center;box-shadow:0 8rpx 26rpx rgba(24,73,55,.05)}.state-icon{display:flex;width:84rpx;height:84rpx;align-items:center;justify-content:center;border-radius:28rpx;background:#e3f3ea;color:#177354;font-size:31rpx;font-weight:900}.state-icon.error{background:#fdeae4;color:#ad523d}.state-icon.loading{animation:breathe 1.3s ease-in-out infinite}.state strong{margin-top:24rpx;font-size:28rpx}.state>text{margin-top:10rpx;color:#8a9892;font-size:21rpx;line-height:1.6}.state-button{margin-top:25rpx;padding:15rpx 34rpx;border-radius:999rpx;background:#167553;color:#fff;font-size:22rpx;font-weight:750}.state-button.pale{background:#e8f4ee;color:#167553}.speech{position:fixed;right:28rpx;bottom:calc(32rpx + env(safe-area-inset-bottom));display:flex;align-items:center;padding:12rpx 19rpx 12rpx 12rpx;border:5rpx solid rgba(255,255,255,.94);border-radius:999rpx;background:#117454;color:#fff;box-shadow:0 10rpx 28rpx rgba(10,80,57,.28)}.speech.active{background:#d4773e}.speech-icon{display:flex;width:46rpx;height:46rpx;align-items:center;justify-content:center;margin-right:9rpx;border-radius:50%;background:rgba(255,255,255,.15);font-size:20rpx}.speech text{font-size:21rpx;font-weight:800}.bottom-space{height:120rpx}@keyframes breathe{0%,100%{transform:scale(1)}50%{transform:scale(.9);opacity:.7}}

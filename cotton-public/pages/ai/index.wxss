/* pages/ai/index.wxss — 简洁对话式 AI 助手 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f7f9f6;
  color: #17382d;
}

.ai-nav {
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.98);
  border-bottom: 1rpx solid #e7ece8;
}
.ai-nav-inner {
  min-height: 92rpx;
  padding: 10rpx 28rpx 14rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.brand-mark,
.assistant-mark,
.empty-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #fff;
  background: linear-gradient(145deg, #0c7958, #1b9b70);
}
.brand-mark {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 18rpx rgba(15, 124, 89, 0.18);
}
.brand-mark-text { font-size: 23rpx; font-weight: 900; letter-spacing: 1rpx; }
.ai-nav-center { flex: 1; min-width: 0; }
.ai-name { display: block; font-size: 31rpx; line-height: 1.2; font-weight: 800; color: #14382c; }
.ai-status-row { margin-top: 7rpx; display: flex; align-items: center; gap: 8rpx; }
.ai-status-dot { width: 11rpx; height: 11rpx; border-radius: 50%; background: #39a978; }
.ai-status-dot.speaking { background: #338ab1; }
.ai-status-dot.recording { background: #d15b50; }
.ai-status-text { font-size: 22rpx; color: #718078; }
.ai-more-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f6f3;
}
.ai-more-icon { font-size: 30rpx; font-weight: 800; color: #607067; letter-spacing: -4rpx; }

.chat-scroll { flex: 1; height: 0; width: 100%; }
.chat-inner { min-height: 100%; padding: 28rpx 28rpx 24rpx; box-sizing: border-box; }
.empty-state {
  min-height: 720rpx;
  padding: 120rpx 58rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
}
.empty-logo {
  width: 112rpx;
  height: 112rpx;
  border-radius: 34rpx;
  box-shadow: 0 18rpx 36rpx rgba(13, 122, 87, 0.19);
}
.empty-logo-text { font-size: 34rpx; font-weight: 900; letter-spacing: 2rpx; }
.empty-title { margin-top: 34rpx; font-size: 38rpx; font-weight: 850; color: #15392d; }
.empty-description { margin-top: 20rpx; font-size: 28rpx; line-height: 1.75; color: #52635b; }
.empty-tip { margin-top: 24rpx; font-size: 23rpx; line-height: 1.6; color: #9aa49e; }
.chat-date-line { text-align: center; margin: 0 0 24rpx; }
.chat-date-text { padding: 5rpx 17rpx; border-radius: 999rpx; font-size: 21rpx; color: #98a29c; background: #edf1ed; }

.msg-row { display: flex; margin: 12rpx 0 34rpx; }
.user-row { justify-content: flex-end; }
.ai-row { align-items: flex-start; gap: 16rpx; }
.msg-body { min-width: 0; }
.user-body { max-width: 82%; }
.ai-body { flex: 1; max-width: calc(100% - 72rpx); }
.assistant-mark { width: 56rpx; height: 56rpx; border-radius: 18rpx; }
.assistant-mark-text { font-size: 19rpx; font-weight: 900; }
.message-meta { display: flex; align-items: center; gap: 12rpx; margin: 1rpx 0 11rpx; }
.assistant-name { font-size: 25rpx; font-weight: 800; color: #24463a; }
.message-time { font-size: 20rpx; color: #a1aaa5; }
.bubble-text { font-size: 29rpx; line-height: 1.72; word-break: break-word; }
rich-text.bubble-text { display: block; }
.ai-answer { padding: 0 4rpx; color: #263c34; }
.user-bubble {
  padding: 19rpx 25rpx;
  border-radius: 25rpx 25rpx 7rpx 25rpx;
  background: #147d5c;
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(16, 112, 82, 0.12);
}
.bubble-img { width: 360rpx; max-width: 100%; margin-bottom: 9rpx; border-radius: 17rpx; display: block; }

.message-actions { display: flex; margin-top: 14rpx; }
.replay-answer {
  min-height: 48rpx;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #65726b;
  background: #eef2ee;
}
.replay-answer.active { color: #176d54; background: #dff1e9; }
.replay-answer-icon { font-size: 22rpx; }
.replay-answer-text { font-size: 22rpx; font-weight: 700; }
.jump-card {
  margin-top: 16rpx;
  padding: 19rpx;
  border: 1rpx solid #dce7e0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 15rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(30, 67, 51, 0.06);
}
.jump-icon { width: 62rpx; height: 62rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 31rpx; background: #ecf5f0; }
.jump-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3rpx; }
.jump-kicker { font-size: 20rpx; color: #5c8c77; }
.jump-title { font-size: 27rpx; font-weight: 800; color: #183b2e; }
.jump-desc { font-size: 22rpx; line-height: 1.4; color: #7c8881; }
.jump-enter { flex-shrink: 0; font-size: 23rpx; font-weight: 800; color: #157656; }
.typing-line { width: 82rpx; margin-top: 13rpx; display: flex; align-items: center; gap: 8rpx; }
.tdot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #7d8c84; }
.scroll-anchor { height: 16rpx; }

.chat-bottom {
  flex-shrink: 0;
  padding: 12rpx 22rpx calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(247, 249, 246, 0.98);
  border-top: 1rpx solid #e4eae5;
}
.composer-shell {
  padding: 10rpx 12rpx 11rpx;
  border: 1rpx solid #dce4de;
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(28, 59, 45, 0.08);
}
.composer-tools { min-height: 35rpx; padding: 0 7rpx 4rpx; display: flex; justify-content: flex-end; }
.voice-answer-toggle { display: flex; align-items: center; gap: 7rpx; font-size: 20rpx; color: #87928c; }
.voice-answer-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: #c3cbc6; }
.voice-answer-toggle.on { color: #147a59; }
.voice-answer-toggle.on .voice-answer-dot { background: #18a477; box-shadow: 0 0 0 5rpx rgba(24, 164, 119, 0.11); }
.voice-answer-state { color: inherit; }
.input-row { display: flex; align-items: center; gap: 11rpx; }
.mode-btn { width: 66rpx; height: 66rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: #eef4f0; }
.keyboard-icon { font-size: 27rpx; font-weight: 900; color: #167858; }
.microphone-icon { position: relative; width: 28rpx; height: 36rpx; border: 3rpx solid #167858; border-top: 0; border-radius: 0 0 15rpx 15rpx; box-sizing: border-box; }
.microphone-head { position: absolute; left: 7rpx; top: -5rpx; width: 9rpx; height: 25rpx; border: 3rpx solid #167858; border-radius: 9rpx; background: transparent; }
.microphone-stem { position: absolute; left: 10rpx; bottom: -9rpx; width: 3rpx; height: 9rpx; background: #167858; box-shadow: -6rpx 8rpx 0 -1rpx #167858, 6rpx 8rpx 0 -1rpx #167858; }
.txt-input { flex: 1; height: 68rpx; padding: 0 8rpx; font-size: 28rpx; color: #1d372e; background: transparent; }
.send-btn { width: 66rpx; height: 66rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: #147d5c; }
.send-btn.off { background: #d9dfdb; }
.send-icon { margin-top: -2rpx; font-size: 38rpx; line-height: 1; font-weight: 500; color: #fff; }
.voice-wrap { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.voice-btn { min-height: 66rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; background: #eef4f0; }
.voice-btn.recording { color: #fff; background: #d55e53; }
.voice-btn-text { font-size: 27rpx; font-weight: 750; color: #1c6f55; }
.voice-btn.recording .voice-btn-text { color: #fff; }
.voice-live-text { padding: 0 10rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 21rpx; color: #68766f; }
.ai-disclaimer { display: block; margin-top: 9rpx; text-align: center; font-size: 19rpx; line-height: 1.3; color: #a3aca7; }

/* pages/ai/index.wxss · 小棉 AI 助手 */
.page{position:relative;display:flex;flex-direction:column;height:100vh;overflow:hidden;background:linear-gradient(180deg,#f4faf6 0%,#f8fbf8 48%,#f1f8f3 100%);color:#102f2b}.ambient{position:absolute;border-radius:50%;filter:blur(28rpx);pointer-events:none}.ambient-one{width:420rpx;height:420rpx;left:-190rpx;top:150rpx;background:rgba(173,229,194,.18)}.ambient-two{width:380rpx;height:380rpx;right:-170rpx;bottom:260rpx;background:rgba(135,217,174,.13)}
.ai-nav{position:relative;z-index:3;flex-shrink:0;background:linear-gradient(180deg,rgba(245,251,247,.98),rgba(245,251,247,.86))}.ai-nav-inner{min-height:128rpx;padding:18rpx 30rpx 20rpx;display:flex;align-items:center;gap:20rpx;box-sizing:border-box}.ai-nav-center{flex:1;min-width:0}.ai-name{display:block;font-size:38rpx;line-height:1.22;font-weight:800;letter-spacing:1rpx;color:#0c3733}.ai-status-row{margin-top:10rpx;display:flex;align-items:center;gap:10rpx}.ai-status-dot{width:15rpx;height:15rpx;border-radius:50%;background:#18aa5b;box-shadow:0 0 0 7rpx rgba(24,170,91,.08)}.ai-status-dot.speaking{background:#168c6a}.ai-status-dot.recording{background:#e0544d}.ai-status-text{font-size:24rpx;color:#718188;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cotton-bot{position:relative;flex-shrink:0}.cotton-bot-large{width:92rpx;height:96rpx}.cotton-bot-small{width:62rpx;height:66rpx;margin-top:4rpx}.cotton-petal{position:absolute;border:5rpx solid #128155;background:#fff;box-sizing:border-box;box-shadow:0 4rpx 10rpx rgba(16,105,71,.08)}.petal-top{left:25%;top:2%;width:50%;height:57%;border-radius:52% 52% 44% 44%}.petal-left{left:3%;top:25%;width:54%;height:55%;border-radius:55% 42% 48% 55%}.petal-right{right:3%;top:25%;width:54%;height:55%;border-radius:42% 55% 55% 48%}.cotton-face{position:absolute;z-index:2;left:23%;top:31%;width:54%;height:40%;border-radius:45%;background:#fff}.eye{position:absolute;top:27%;width:6rpx;height:9rpx;border-radius:50%;background:#123c38}.eye-left{left:25%}.eye-right{right:25%}.smile{position:absolute;left:43%;top:52%;width:13%;height:12%;border-bottom:3rpx solid #123c38;border-radius:0 0 9rpx 9rpx}.bot-leaf{position:absolute;z-index:3;bottom:0;width:37%;height:28%;background:linear-gradient(145deg,#31ad69,#087a4f)}.leaf-left{left:24%;border-radius:90% 8% 90% 8%;transform:rotate(28deg)}.leaf-right{right:19%;border-radius:8% 90% 8% 90%;transform:rotate(-27deg)}.cotton-bot-small .cotton-petal{border-width:3rpx}.cotton-bot-small .eye{width:4rpx;height:6rpx}.cotton-bot-small .smile{border-bottom-width:2rpx}
.chat-scroll{position:relative;z-index:1;flex:1;height:0;width:100%}.chat-inner{min-height:100%;padding:24rpx 26rpx 34rpx;box-sizing:border-box}.chat-date-line{text-align:center;margin:6rpx 0 30rpx}.chat-date-text{padding:8rpx 24rpx;border-radius:999rpx;font-size:22rpx;color:#7c8a91;background:rgba(227,235,230,.88)}
.msg-row{display:flex;margin:12rpx 0 34rpx}.user-row{justify-content:flex-end;align-items:center;gap:16rpx}.ai-row{align-items:flex-start;gap:15rpx}.msg-body{min-width:0}.user-body{max-width:72%}.ai-body{flex:1;max-width:calc(100% - 77rpx)}.message-meta{display:flex;align-items:center;gap:12rpx;margin:1rpx 0 12rpx}.assistant-name{font-size:26rpx;font-weight:800;color:#123b36}.message-time{font-size:21rpx;color:#8d9aa1}.bubble-text{font-size:28rpx;line-height:1.75;word-break:break-word}rich-text.bubble-text{display:block}.user-bubble{padding:20rpx 27rpx;border-radius:28rpx 28rpx 8rpx 28rpx;background:linear-gradient(135deg,#079063,#0caa75);color:#fff;box-shadow:0 12rpx 26rpx rgba(7,137,93,.16)}.bubble-img{width:360rpx;max-width:100%;margin-bottom:9rpx;border-radius:18rpx;display:block}.user-avatar{position:relative;width:58rpx;height:58rpx;flex-shrink:0;border-radius:50%;background:linear-gradient(145deg,#daf4e5,#edf9f1)}.user-head{position:absolute;left:20rpx;top:13rpx;width:18rpx;height:18rpx;border-radius:50%;background:#1c9c68}.user-shoulders{position:absolute;left:13rpx;bottom:10rpx;width:32rpx;height:17rpx;border-radius:20rpx 20rpx 7rpx 7rpx;background:#1c9c68}
.ai-answer{color:#203d38}.answer-card,.welcome-card{padding:24rpx;border:1rpx solid rgba(222,232,226,.92);border-radius:26rpx;background:rgba(255,255,255,.94);box-shadow:0 16rpx 40rpx rgba(25,75,55,.07)}.welcome-card{padding:22rpx}.answer-heading{margin-bottom:18rpx;padding:18rpx 20rpx;border-radius:18rpx;background:linear-gradient(100deg,#edf8f1,#f7fbf8);font-size:31rpx;font-weight:800;color:#0b5a43}.welcome-copy{display:block;font-size:26rpx;line-height:1.65;color:#233e3a}.guide-list{margin-top:20rpx}.guide-item{min-height:82rpx;margin-top:14rpx;padding:0 18rpx 0 12rpx;border:1rpx solid #dce6e1;border-radius:18rpx;display:flex;align-items:center;background:#fff;box-sizing:border-box}.guide-number{width:54rpx;height:54rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:22rpx;font-weight:800;color:#0c664b;background:linear-gradient(145deg,#e9f8ef,#dff3e7)}.guide-label{flex:1;margin-left:15rpx;font-size:26rpx;font-weight:700;color:#173631}.guide-arrow{font-size:44rpx;font-weight:300;color:#87969d}.welcome-play{width:180rpx;margin-top:20rpx;padding:11rpx 18rpx;border-radius:999rpx;display:flex;align-items:center;gap:12rpx;color:#147b58;background:#edf8f2;font-size:23rpx;font-weight:700;box-sizing:border-box}.speaker-icon,.mini-speaker{position:relative;width:28rpx;height:28rpx;flex-shrink:0}.speaker-icon::before,.mini-speaker::before{content:"";position:absolute;left:0;top:9rpx;width:8rpx;height:11rpx;background:currentColor;border-radius:2rpx}.speaker-icon::after,.mini-speaker::after{content:"";position:absolute;left:6rpx;top:5rpx;border-top:9rpx solid transparent;border-bottom:9rpx solid transparent;border-right:11rpx solid currentColor}.speaker-icon view,.mini-speaker view{position:absolute;right:0;top:6rpx;width:8rpx;height:15rpx;border-right:3rpx solid currentColor;border-radius:0 50% 50% 0}.quick-prompts{margin-top:18rpx;display:flex;flex-wrap:wrap;gap:12rpx}.quick-prompt{padding:14rpx 22rpx;border:2rpx solid #149365;border-radius:999rpx;background:rgba(255,255,255,.5);font-size:24rpx;font-weight:650;color:#135a46}
.message-actions{display:flex;margin-top:19rpx;padding-top:18rpx;border-top:1rpx solid #edf1ee}.replay-answer{min-height:48rpx;padding:7rpx 16rpx;border-radius:999rpx;display:flex;align-items:center;gap:9rpx;color:#147b58;background:#edf8f2}.replay-answer.active{color:#fff;background:#18845f}.replay-answer-text{font-size:22rpx;font-weight:700}.jump-card{margin-top:15rpx;padding:19rpx;border:1rpx solid #dce7e0;border-radius:22rpx;display:flex;align-items:center;gap:15rpx;background:#fff;box-shadow:0 9rpx 25rpx rgba(30,67,51,.06)}.jump-icon{width:60rpx;height:60rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:30rpx;background:#ecf6f0}.jump-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:3rpx}.jump-kicker{font-size:20rpx;color:#5c8c77}.jump-title{font-size:26rpx;font-weight:800;color:#183b2e}.jump-desc{font-size:22rpx;line-height:1.4;color:#7c8881}.jump-enter{flex-shrink:0;font-size:23rpx;font-weight:800;color:#157656}.typing-line{width:92rpx;height:58rpx;padding:0 20rpx;border-radius:20rpx;display:flex;align-items:center;gap:9rpx;background:#fff;box-shadow:0 10rpx 25rpx rgba(25,75,55,.06);box-sizing:border-box}.tdot{width:9rpx;height:9rpx;border-radius:50%;background:#72a995;animation:pulse 1.2s infinite}.tdot:nth-child(2){animation-delay:.2s}.tdot:nth-child(3){animation-delay:.4s}@keyframes pulse{0%,60%,100%{opacity:.35;transform:translateY(0)}30%{opacity:1;transform:translateY(-5rpx)}}.scroll-anchor{height:18rpx}
.chat-bottom{position:relative;z-index:4;flex-shrink:0;padding:10rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));background:rgba(246,251,247,.96);border-top:1rpx solid rgba(219,230,223,.9);box-shadow:0 -12rpx 36rpx rgba(47,83,66,.04)}.voice-status-bar{min-height:54rpx;padding:0 6rpx 10rpx;display:flex;align-items:center;justify-content:space-between;gap:14rpx}.voice-hint{min-width:0;display:flex;align-items:center;gap:12rpx;font-size:21rpx;color:#87949a}.voice-hint text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.tiny-mic{position:relative;width:17rpx;height:24rpx;border:3rpx solid #7e8f96;border-top:0;border-radius:0 0 12rpx 12rpx;box-sizing:border-box}.tiny-mic:before{content:"";position:absolute;left:4rpx;top:-5rpx;width:5rpx;height:17rpx;border:3rpx solid #7e8f96;border-radius:7rpx}.voice-answer-toggle{flex-shrink:0;display:flex;align-items:center;gap:8rpx;color:#61736d;font-size:21rpx}.voice-answer-toggle.on{color:#087c55}.mini-speaker{width:25rpx;height:25rpx}.switch{position:relative;width:58rpx;height:34rpx;border-radius:999rpx;background:#cfd8d3;transition:.2s}.switch-knob{position:absolute;left:4rpx;top:4rpx;width:26rpx;height:26rpx;border-radius:50%;background:#fff;box-shadow:0 2rpx 8rpx rgba(0,0,0,.14);transition:.2s}.voice-answer-toggle.on .switch{background:#07925f}.voice-answer-toggle.on .switch-knob{left:28rpx}
.composer-shell{padding:9rpx;border:1rpx solid #bfe8d2;border-radius:34rpx;background:#fff;box-shadow:0 9rpx 27rpx rgba(28,83,58,.06)}.input-row{display:flex;align-items:center;gap:10rpx}.mode-btn{width:68rpx;height:68rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:linear-gradient(145deg,#e9f9f0,#dff5e8)}.keyboard-icon{font-size:24rpx;font-weight:800;color:#0c8a5c}.microphone-icon{position:relative;width:28rpx;height:36rpx;border:3rpx solid #0b9361;border-top:0;border-radius:0 0 15rpx 15rpx;box-sizing:border-box}.microphone-head{position:absolute;left:7rpx;top:-5rpx;width:9rpx;height:25rpx;border:3rpx solid #0b9361;border-radius:9rpx}.microphone-stem{position:absolute;left:10rpx;bottom:-9rpx;width:3rpx;height:9rpx;background:#0b9361;box-shadow:-6rpx 8rpx 0 -1rpx #0b9361,6rpx 8rpx 0 -1rpx #0b9361}.txt-input{flex:1;height:68rpx;padding:0 8rpx;font-size:27rpx;color:#173831;background:transparent}.send-btn{width:68rpx;height:68rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:linear-gradient(145deg,#0b9a68,#08774f);box-shadow:0 8rpx 18rpx rgba(8,130,87,.19)}.send-btn.off{background:#d9e1dc;box-shadow:none}.send-icon{margin-top:-5rpx;font-size:45rpx;line-height:1;font-weight:500;color:#fff}.voice-wrap{flex:1;min-width:0;display:flex;flex-direction:column;gap:5rpx}.voice-btn{min-height:68rpx;border-radius:25rpx;display:flex;align-items:center;justify-content:center;background:#eff7f2}.voice-btn.recording{background:#d95750}.voice-btn-text{font-size:27rpx;font-weight:750;color:#147557}.voice-btn.recording .voice-btn-text{color:#fff}.voice-live-text{padding:0 10rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:20rpx;color:#68766f}.ai-disclaimer{display:block;margin-top:10rpx;text-align:center;font-size:19rpx;line-height:1.3;color:#9aa7a2}
@media (max-height:700px){.ai-nav-inner{min-height:106rpx;padding-top:10rpx;padding-bottom:12rpx}.cotton-bot-large{width:76rpx;height:79rpx}.chat-inner{padding-top:16rpx}.voice-status-bar{display:none}.ai-disclaimer{display:none}}

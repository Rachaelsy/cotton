page{background:#f5f9f6;color:#193b2b}.page{padding:32rpx 28rpx 80rpx}.heading{font-size:38rpx;font-weight:700;margin-bottom:20rpx}.meta{margin:28rpx 0;color:#248056;font-size:26rpx}.hint{display:block;color:#84958a;font-size:25rpx;line-height:1.8;margin:18rpx 0}.bar{height:8rpx;background:#dfeae3;border-radius:8rpx;overflow:hidden}.bar view{height:100%;background:#168056}.card{margin:24rpx 0;padding:30rpx;background:white;border-radius:24rpx;line-height:1.8}.card>text{display:block}.title{font-size:32rpx;font-weight:600;white-space:pre-wrap}.option{display:flex;gap:20rpx;margin-top:22rpx;padding:24rpx;border:2rpx solid #e4ebe6;border-radius:18rpx;font-size:28rpx}.option.selected{border-color:#168056;background:#edf7ef}.actions{display:flex;gap:20rpx}.actions button{flex:1;background:#168056;color:white;font-size:28rpx}.actions button[disabled]{background:#c8d9cd}.score{text-align:center}.score>text{font-size:64rpx;font-weight:800;color:#168056}.verdict{color:#af7b24;margin:16rpx 0}.directory{background:transparent;color:#507b63;margin-top:30rpx;font-size:26rpx}.directory:after{border:0}

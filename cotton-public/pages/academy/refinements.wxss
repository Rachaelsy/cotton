.academy-page .academy-hero{height:250rpx}
.academy-page .hero-copy{padding:26rpx 30rpx}
.academy-page .hero-title{margin-top:24rpx;font-size:36rpx}
.academy-page .series-card{height:auto;background:#fff;border:1rpx solid #e4ece6;box-shadow:0 6rpx 18rpx rgba(25,60,40,.04)}
.academy-page .series-cover{position:relative;display:block;width:100%;height:190rpx}
.academy-page .series-card-copy{position:relative;padding:20rpx;color:#193d2e}
.academy-page .series-title{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;white-space:normal;min-height:76rpx;font-size:28rpx;line-height:1.4;text-shadow:none}
.academy-page .series-summary{color:#7b887f;font-size:22rpx}
.academy-page .series-bottom{color:#48755e;font-size:21rpx;margin-top:18rpx}
.series-page .series-hero{height:280rpx}
.series-page .lesson-copy strong{white-space:normal;line-height:1.5}
.series-page .start-learning{margin:24rpx;background:#18734e;color:#fff;border-radius:18rpx;font-size:28rpx;line-height:84rpx}
.academy-status{padding:48rpx 28rpx;text-align:center;color:#6b7b71;font-size:27rpx;line-height:1.7}
.course-page .course-nav{position:relative;min-height:88rpx;background:#fff;color:#193d2e}
.course-page .course-nav>text{color:#193d2e;text-shadow:none}
.course-page .course-back,.course-page .course-nav button{background:#edf5ef;color:#193d2e}
.course-page .video-stage{height:422rpx}
.academy-status text{display:block}
.academy-status button,.empty-state button,.empty button{margin:24rpx auto 0;background:#eaf4ed;color:#186747;font-size:26rpx;width:260rpx}
.lesson-controls{display:flex;gap:20rpx;padding:20rpx 26rpx}
.lesson-controls button{flex:1;background:#edf5ef;color:#17684b;font-size:25rpx;border-radius:14rpx}
.lesson-controls button[disabled]{color:#a4b1a9;background:#f1f3f1}
.inline-directory{margin:0 26rpx 24rpx;padding:12rpx 20rpx;border:1rpx solid #e2ece4;border-radius:18rpx;background:white;max-height:500rpx;overflow:auto}
.directory-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:24rpx 8rpx;border-bottom:1rpx solid #eef2ef;font-size:25rpx;line-height:1.6}
.directory-row text:first-child{flex:1}.directory-row text:last-child{font-size:21rpx;color:#85958a}.directory-row.selected{color:#147347;font-weight:700}
.course-page .video-summary{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}

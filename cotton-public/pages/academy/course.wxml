<view class="page"><view class="cover"><image src="{{course.cover}}" mode="aspectFill"/><view class="play" wx:if="{{course.type==='视频'}}">▶</view></view><view class="summary"><view><strong>{{course.title}}</strong><small>{{course.type}} · {{course.level}} · {{course.duration}}</small></view><label>+{{course.reward}}分</label></view><view class="teacher"><view class="avatar">师</view><view><strong>{{course.teacher}}</strong><small>喀什优棉公益平台特邀农技专家</small></view></view><view class="content"><h2>课程内容</h2><p>{{course.intro}}</p></view><view class="content"><h2>本课要点</h2><view class="point" wx:for="{{course.points}}" wx:key="*this"><i>{{index+1}}</i><text>{{item}}</text></view></view><button class="complete {{completed?'done':''}}" bindtap="complete">{{completed?'✓ 本课已完成':'完成本课 · 获得学习积分'}}</button></view>

<view class="academy-page">
  <view class="academy-nav" style="padding-top:{{navTop}}px">
    <view class="nav-action" bindtap="back">‹</view>
    <strong>优棉学堂</strong>
    <view class="nav-action nav-placeholder"></view>
  </view>

  <view class="level-tabs">
    <view wx:for="{{levels}}" wx:key="key" class="level-tab {{activeLevel===item.key?'active':''}}" data-key="{{item.key}}" bindtap="switchLevel">{{item.name}}</view>
  </view>

  <view class="series-head">
    <strong>{{activeLevel==='basic'?'初级系列课程':activeLevel==='intermediate'?'中级系列课程':'高级系列课程'}}</strong>
    <text>点击课程查看完整目录</text>
  </view>

  <view class="series-grid" wx:if="{{series.length}}">
    <view class="series-card" wx:for="{{series}}" wx:key="id" data-id="{{item.id}}" bindtap="openSeries">
      <view class="series-cover">
        <image src="{{item.cover}}" mode="aspectFill"></image>
        <view class="cover-shade"></view>
        <text class="lesson-count">共{{item.lessonCount}}节</text>
        <view class="series-level">{{activeLevel==='basic'?'入门':activeLevel==='intermediate'?'进阶':'提升'}}</view>
      </view>
      <strong class="series-title">{{item.title}}</strong>
      <text class="series-summary">{{item.summary}}</text>
      <view class="series-meta"><text>{{item.teacher}}</text><text>{{item.durationText}}</text></view>
      <view class="series-progress" wx:if="{{item.progress>0}}"><view style="width:{{item.progress}}%"></view></view>
      <text class="progress-copy" wx:if="{{item.progress>0}}">已完成 {{item.completed}}/{{item.lessonCount}}</text>
    </view>
  </view>
  <view class="empty" wx:elif="{{!loading}}">该级别暂时没有系列课程</view>

  <view class="academy-note">课程用于农业科普学习，具体田间措施应结合地块情况和属地农技指导。</view>
</view>

<view class="academy-page">
  <view class="academy-nav" style="padding-top:{{navTop}}px">
    <view class="nav-action" bindtap="back">‹</view>
    <text class="nav-title">优棉学堂</text>
    <view class="nav-action nav-placeholder"></view>
  </view>

  <view class="academy-hero">
    <image class="hero-image" src="/images/cotton-seedling-inspection-v1.jpg" mode="aspectFill"></image>
    <view class="hero-shade"></view>
    <view class="hero-copy">
      <view class="hero-badge"><view class="badge-leaf">◆</view><text>喀什优棉 · 农技课堂</text></view>
      <text class="hero-title">学种棉，来优棉学堂</text>
      <text class="hero-subtitle">实用农技课程，助力科学种植</text>
    </view>
  </view>

  <view class="level-tabs">
    <view wx:for="{{levels}}" wx:key="key" class="level-tab {{activeLevel===item.key?'active':''}}" data-key="{{item.key}}" bindtap="switchLevel">
      <text>{{item.name}}</text>
    </view>
  </view>

  <view class="series-head">
    <view class="series-heading"><view class="heading-bar"></view><text>{{activeLevel==='basic'?'初级专题课程':activeLevel==='intermediate'?'中级专题课程':'高级专题课程'}}</text></view>
    <text class="series-guide">选择专题开始学习</text>
  </view>

  <view class="empty-state" wx:if="{{loading}}"><text>课程加载中…</text></view>
  <view class="empty-state" wx:elif="{{error}}"><text>{{error}}</text><button bindtap="loadSeries">重新加载</button></view>
  <view class="series-grid" wx:elif="{{series.length}}">
    <view class="series-card" wx:for="{{series}}" wx:key="id" data-id="{{item.id}}" bindtap="openSeries">
      <image class="series-cover" src="{{item.cover}}" mode="aspectFill"></image>
      <view class="series-card-copy">
        <text class="series-title">{{item.title}}</text>
        <text class="series-summary">{{item.summary}}</text>
        <view class="series-bottom"><text>{{item.lessonCount}} 节 · {{item.durationText}}</text><text class="series-arrow">›</text></view>
      </view>
      <view wx:if="{{item.progress>0}}" class="series-progress"><view style="width:{{item.progress}}%"></view></view>
    </view>
  </view>

  <view class="empty-state" wx:elif="{{!loading}}">
    <view class="empty-illustration">
      <view class="book-page left"><view></view><view></view><view></view></view>
      <view class="book-page right"><view></view><view></view><view></view></view>
      <view class="book-spine"></view>
    </view>
    <text class="empty-title">暂无已发布课程</text>
    <text class="empty-copy">请选择其他课程级别查看</text>
  </view>

  <view class="bottom-space"></view>
</view>

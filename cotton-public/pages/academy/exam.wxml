<view class="page"><view class="head"><small>优棉学堂 · 初级</small><strong>阶段考试</strong><p>共 {{questions.length}} 题，80 分及以上通过并解锁中级课程</p></view><view class="question" wx:for="{{questions}}" wx:key="id"><h2>{{index+1}}. {{item.title}}</h2><view wx:for="{{item.options}}" wx:for-item="option" wx:for-index="oi" wx:key="*this" class="option {{selected[item.id]===oi?'chosen':''}}" data-q="{{item.id}}" data-i="{{oi}}" bindtap="choose"><i>{{['A','B','C'][oi]}}</i><text>{{option}}</text></view></view><view class="result" wx:if="{{submitted}}"><strong>{{score}} 分 · {{passed?'考试通过':'暂未通过'}}</strong><text>{{passed?'中级课程已解锁':'复习初级课程后可重新考试'}}</text></view><button class="submit" wx:if="{{!submitted}}" bindtap="submit">提交试卷</button><button class="submit" wx:elif="{{!passed}}" bindtap="retry">重新考试</button><button class="submit" wx:else bindtap="backAcademy">返回课程体系</button></view>

<view class="page"><view class="head"><small>优棉学堂 · 初级课程</small><strong>学习自测</strong><p>共 {{questions.length}} 题，80 分及以上通过；用于巩固学习内容，不限制其他课程浏览。</p></view><view class="question" wx:for="{{questions}}" wx:key="id"><h2>{{index+1}}. {{item.title}}</h2><view wx:for="{{item.options}}" wx:for-item="option" wx:for-index="oi" wx:key="*this" class="option {{selected[item.id]===oi?'chosen':''}}" data-q="{{item.id}}" data-i="{{oi}}" bindtap="choose"><i>{{['A','B','C'][oi]}}</i><text>{{option}}</text></view></view><view class="result" wx:if="{{submitted}}"><strong>{{score}} 分 · {{passed?'自测通过':'暂未通过'}}</strong><text>{{passed?'你已掌握本阶段的主要知识点':'复习初级课程后可以再次练习'}}</text></view><button class="submit" wx:if="{{!submitted}}" bindtap="submit">提交答案</button><button class="submit" wx:elif="{{!passed}}" bindtap="retry">重新练习</button><button class="submit" wx:else bindtap="backAcademy">返回课程中心</button></view>

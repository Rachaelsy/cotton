@import "./refinements.wxss";
.academy-page{min-height:100vh;padding:0 26rpx 64rpx;background:linear-gradient(180deg,#fff 0%,#fbfdf9 65%,#f7faf4 100%);box-sizing:border-box;color:#17231d}.academy-nav{display:flex;height:94rpx;margin:0 -26rpx;padding-right:28rpx;padding-left:28rpx;align-items:center;justify-content:space-between;background:#fff;box-sizing:content-box}.nav-action{display:flex;width:66rpx;height:66rpx;align-items:center;justify-content:center;color:#111;font-size:58rpx;font-weight:300;line-height:1}.nav-placeholder{visibility:hidden}.nav-title{color:#111;font-size:36rpx;font-weight:900;letter-spacing:1rpx}.academy-hero{position:relative;height:286rpx;overflow:hidden;border-radius:30rpx;background:#176c49;box-shadow:0 12rpx 32rpx rgba(22,92,62,.12)}.hero-image{position:absolute;width:100%;height:100%}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,96,57,.96) 0%,rgba(10,103,62,.8) 43%,rgba(9,67,43,.08) 78%)}.hero-copy{position:relative;z-index:2;padding:41rpx 34rpx;color:#fff}.hero-badge{display:flex;width:260rpx;height:48rpx;padding:0 16rpx;align-items:center;border:1rpx solid rgba(255,255,255,.14);border-radius:999rpx;background:rgba(255,255,255,.18);box-sizing:border-box;font-size:22rpx;font-weight:700}.badge-leaf{display:flex;width:29rpx;height:29rpx;margin-right:10rpx;align-items:center;justify-content:center;border-radius:80% 10% 80% 10%;background:#fff;color:#16834f;font-size:13rpx;transform:rotate(-15deg)}.hero-title{display:block;margin-top:32rpx;font-size:40rpx;font-weight:900;line-height:1.25;letter-spacing:1rpx;text-shadow:0 3rpx 12rpx rgba(0,40,22,.18)}.hero-subtitle{display:block;margin-top:15rpx;color:rgba(255,255,255,.92);font-size:25rpx;line-height:1.5}.level-tabs{display:flex;height:78rpx;margin-top:26rpx;padding:4rpx;border:1rpx solid #e5eae6;border-radius:25rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(34,67,47,.06);box-sizing:border-box}.level-tab{position:relative;display:flex;min-width:0;flex:1;align-items:center;justify-content:center;border-radius:22rpx;color:#202722;font-size:27rpx;font-weight:700}.level-tab+.level-tab:before{position:absolute;left:0;width:1rpx;height:36rpx;background:#e5e8e5;content:""}.level-tab.active{background:linear-gradient(135deg,#24945b,#0c7145);box-shadow:0 8rpx 18rpx rgba(22,124,75,.18);color:#fff}.level-tab.active:before,.level-tab.active+.level-tab:before{display:none}.free-badge{position:absolute;top:-2rpx;right:13rpx;padding:3rpx 10rpx;border-radius:999rpx;background:#fff0a9;color:#76610b;font-size:17rpx;font-weight:800}.series-head{display:flex;margin-top:35rpx;align-items:center;justify-content:space-between}.series-heading{display:flex;align-items:center;color:#17221c;font-size:32rpx;font-weight:900}.heading-bar{width:9rpx;height:38rpx;margin-right:14rpx;border-radius:99rpx;background:linear-gradient(180deg,#20a15d,#087647)}.series-guide{color:#7b837e;font-size:22rpx}.series-grid{display:grid;margin-top:22rpx;grid-template-columns:1fr 1fr;gap:22rpx 20rpx}.series-card{position:relative;height:276rpx;overflow:hidden;border-radius:24rpx;background:#dfe9e1;box-shadow:0 8rpx 22rpx rgba(28,60,39,.09)}.series-cover{position:absolute;width:100%;height:100%}.cover-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(4,20,11,.02) 25%,rgba(4,20,11,.82) 100%)}.series-card-copy{position:absolute;right:0;bottom:0;left:0;padding:22rpx 20rpx;color:#fff}.series-title{display:block;overflow:hidden;font-size:29rpx;font-weight:900;text-overflow:ellipsis;white-space:nowrap;text-shadow:0 2rpx 8rpx rgba(0,0,0,.28)}.series-summary{display:block;overflow:hidden;margin-top:7rpx;color:rgba(255,255,255,.9);font-size:20rpx;text-overflow:ellipsis;white-space:nowrap}.series-bottom{display:flex;margin-top:10rpx;align-items:center;justify-content:space-between;font-size:20rpx}.series-arrow{font-size:43rpx;font-weight:300;line-height:.7}.series-progress{position:absolute;right:0;bottom:0;left:0;height:6rpx;background:rgba(255,255,255,.25)}.series-progress view{height:100%;background:#f4c54f}.empty-state{display:flex;height:350rpx;margin-top:22rpx;align-items:center;justify-content:center;flex-direction:column;border:1rpx solid #e8ede9;border-radius:28rpx;background:rgba(255,255,255,.82);box-shadow:0 8rpx 28rpx rgba(30,62,41,.05)}.empty-illustration{position:relative;width:142rpx;height:92rpx;margin-bottom:22rpx}.book-page{position:absolute;top:0;width:70rpx;height:82rpx;padding:24rpx 13rpx 0;border:4rpx solid #94baa5;background:#edf6f0;box-sizing:border-box}.book-page.left{left:2rpx;border-radius:15rpx 3rpx 12rpx 16rpx;transform:skewY(7deg)}.book-page.right{right:2rpx;border-radius:3rpx 15rpx 16rpx 12rpx;transform:skewY(-7deg)}.book-page view{height:4rpx;margin-bottom:8rpx;border-radius:8rpx;background:#afcbbb}.book-spine{position:absolute;left:69rpx;bottom:3rpx;width:5rpx;height:73rpx;border-radius:8rpx;background:#78a88d}.empty-title{color:#46544c;font-size:27rpx;font-weight:800}.empty-copy{margin-top:9rpx;color:#a0a8a3;font-size:21rpx}.academy-benefit{display:flex;min-height:84rpx;margin-top:28rpx;padding:0 24rpx;align-items:center;border:1rpx solid #f5e3ad;border-radius:22rpx;background:linear-gradient(90deg,#fff8dd,#fff3cb);color:#b96011;box-sizing:border-box;font-size:22rpx;font-weight:700}.benefit-book{position:relative;width:43rpx;height:38rpx;margin-right:18rpx;flex:none}.benefit-book:before,.benefit-book:after{position:absolute;top:0;width:20rpx;height:34rpx;border-radius:7rpx 3rpx 5rpx 7rpx;background:#f3a000;content:""}.benefit-book:before{left:0}.benefit-book:after{right:0;transform:scaleX(-1)}.benefit-book view{position:absolute;z-index:2;top:2rpx;left:20rpx;width:3rpx;height:32rpx;background:#fff6d8}.academy-benefit>text:first-of-type{flex:1}.benefit-arrow{margin-left:12rpx;font-size:42rpx;font-weight:300}.bottom-space{height:20rpx}
.academy-hero{background:#dfe9e1}.academy-hero .hero-image{z-index:1;top:0;left:0;display:block;opacity:1}.academy-hero .hero-shade{z-index:2;background:linear-gradient(90deg,rgba(2,63,37,.72) 0%,rgba(3,73,42,.48) 42%,rgba(3,51,31,.08) 76%,rgba(3,51,31,0) 100%)}.academy-hero .hero-copy{z-index:3}
.login-badge{position:absolute;top:-13rpx;right:8rpx;padding:2rpx 9rpx;border:1rpx solid #dce7df;border-radius:999rpx;background:#f4f8f5;color:#668075;font-size:15rpx;font-weight:600;line-height:25rpx}.level-tab.active .login-badge{border-color:rgba(255,255,255,.5);background:rgba(255,255,255,.9);color:#176c49}

.page{min-height:100vh;background:#f3f5f1;color:#1b352c;padding-bottom:50rpx}.hero{padding:104rpx 36rpx 42rpx;background:linear-gradient(145deg,#123f32,#24745a);color:#fff;border-radius:0 0 46rpx 46rpx}.hero>small{font-size:24rpx;opacity:.7;letter-spacing:3rpx}.hero h1{font-size:50rpx;margin:12rpx 0}.hero p{font-size:25rpx;opacity:.8}.score{display:grid;grid-template-columns:1fr 1fr;margin-top:32rpx;background:rgba(255,255,255,.12);border-radius:24rpx}.score view{display:flex;flex-direction:column;padding:24rpx 28rpx;gap:8rpx}.score view+view{border-left:1rpx solid rgba(255,255,255,.16)}.score small{font-size:22rpx;opacity:.7}.score strong{font-size:32rpx;color:#f2ca72}.path{padding:32rpx 28rpx}.level{display:grid;grid-template-columns:64rpx 1fr;gap:18rpx;position:relative;padding-bottom:28rpx}.level:before{content:'';position:absolute;left:31rpx;top:62rpx;bottom:-8rpx;width:3rpx;background:#cbdcd4}.level:last-child:before{display:none}.node{z-index:1;display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;background:#177352;color:#fff;border-radius:50%;font-size:24rpx;font-weight:700}.panel{background:#fff;border-radius:26rpx;padding:28rpx;box-shadow:0 8rpx 25rpx rgba(33,72,56,.06)}.title{display:flex;justify-content:space-between;gap:12rpx}.title strong{font-size:29rpx}.title text{color:#177352;font-size:23rpx}.panel>p{font-size:24rpx;color:#7d8983;margin:12rpx 0 22rpx}.lesson{display:grid;grid-template-columns:66rpx 1fr auto;align-items:center;gap:12rpx;padding:20rpx 0;border-top:1rpx solid #edf0ed}.lesson label{color:#277856;background:#e5f2eb;padding:5rpx;border-radius:8rpx;font-size:20rpx;text-align:center}.lesson label.video{color:#a5682f;background:#faeadb}.lesson strong{font-size:24rpx}.lesson small{font-size:22rpx;color:#8a948f}.panel button{margin-top:18rpx;background:#d49c39;color:#fff;border:0;border-radius:16rpx;font-size:25rpx}.locked{opacity:.66}.locked .node{background:#89958f}.locked .panel{background:#f9faf8}

.score{display:flex;flex-direction:row}.score>view{flex:1;min-width:0}.level{display:flex;flex-direction:row}.node{flex-shrink:0;margin-right:18rpx}.panel{flex:1;min-width:0}.lesson{display:flex;flex-direction:row}.lesson label{width:66rpx;flex-shrink:0;margin-right:12rpx}.lesson strong{flex:1;min-width:0}.lesson small{flex-shrink:0;margin-left:12rpx}

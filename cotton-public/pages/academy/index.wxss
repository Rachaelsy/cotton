.academy-page{min-height:100vh;padding-bottom:80rpx;background:#fff;color:#17221c}.academy-nav{display:flex;align-items:center;justify-content:space-between;height:88rpx;padding-right:28rpx;padding-left:28rpx;background:#fff}.academy-nav>strong{font-size:34rpx;letter-spacing:1rpx}.nav-action{display:flex;width:64rpx;height:64rpx;align-items:center;justify-content:center;color:#17221c;font-size:54rpx;font-weight:300}.nav-placeholder{visibility:hidden}
.level-tabs{position:sticky;z-index:3;top:0;display:flex;align-items:center;justify-content:space-around;padding:20rpx 28rpx 24rpx;border-bottom:1rpx solid #edf0ed;background:rgba(255,255,255,.96)}.level-tab{position:relative;padding:15rpx 28rpx;border-radius:999rpx;color:#6f7772;font-size:27rpx}.level-tab.active{background:#e7f3ec;color:#146247;font-weight:800}.level-tab.active::after{position:absolute;right:30rpx;bottom:4rpx;left:30rpx;height:4rpx;border-radius:99rpx;background:#1b7655;content:""}
.series-head{display:flex;align-items:flex-end;justify-content:space-between;padding:36rpx 32rpx 22rpx}.series-head strong{font-size:31rpx}.series-head text{color:#99a19c;font-size:20rpx}.series-grid{display:grid;grid-template-columns:1fr 1fr;gap:38rpx 22rpx;padding:0 28rpx}.series-card{min-width:0}.series-cover{position:relative;height:224rpx;overflow:hidden;border-radius:16rpx;background:#e5ebe7;box-shadow:0 8rpx 20rpx rgba(24,55,42,.08)}.series-cover image{width:100%;height:100%}.cover-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(3,22,14,.02),rgba(3,22,14,.48))}.lesson-count{position:absolute;right:14rpx;bottom:13rpx;color:#fff;font-size:22rpx;font-weight:700;text-shadow:0 2rpx 7rpx rgba(0,0,0,.4)}.series-level{position:absolute;top:13rpx;left:13rpx;padding:6rpx 12rpx;border-radius:7rpx;background:rgba(20,98,71,.92);color:#fff;font-size:18rpx;font-weight:700}.series-title{display:block;margin-top:16rpx;overflow:hidden;font-size:28rpx;line-height:1.4;text-overflow:ellipsis;white-space:nowrap}.series-summary{display:-webkit-box;margin-top:7rpx;overflow:hidden;color:#727d76;font-size:20rpx;line-height:1.55;-webkit-box-orient:vertical;-webkit-line-clamp:2}.series-meta{display:flex;align-items:center;justify-content:space-between;margin-top:10rpx;color:#9aa29d;font-size:18rpx}.series-progress{height:6rpx;margin-top:12rpx;overflow:hidden;border-radius:99rpx;background:#e7ece9}.series-progress view{height:100%;border-radius:99rpx;background:#1d7655}.progress-copy{display:block;margin-top:7rpx;color:#257454;font-size:18rpx}.empty{padding:150rpx 0;color:#98a19b;font-size:23rpx;text-align:center}.academy-note{margin:60rpx 52rpx 0;color:#a0a8a3;font-size:19rpx;line-height:1.7;text-align:center}

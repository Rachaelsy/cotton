.course-page{min-height:100vh;background:#f5f7f6;color:#16251e}
.course-nav{position:relative;z-index:10;background:#fff}
.course-nav-inner{position:relative;display:flex;height:92rpx;align-items:center;justify-content:space-between;padding:0 30rpx}
.course-nav-inner>text{position:absolute;right:120rpx;left:120rpx;color:#101713;font-size:34rpx;font-weight:800;text-align:center}
.course-back{display:flex;width:64rpx;height:64rpx;align-items:center;justify-content:center;color:#101713;font-size:56rpx;font-weight:300;line-height:1}
.course-nav-space{width:64rpx;height:64rpx}
.page-status{min-height:420rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40rpx;background:#fff;color:#738078;font-size:26rpx;text-align:center}
.page-status button{width:250rpx;margin:28rpx auto 0;border-radius:99rpx;background:#eaf4ee;color:#176c4b;font-size:25rpx}

.video-stage{position:relative;height:426rpx;overflow:hidden;background:#071912}
.video-stage>video,.video-cover{width:100%;height:100%}
.video-fallback{position:absolute;z-index:2;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(3,25,25,.66);color:#fff;text-align:center}
.retry-ring{display:flex;width:62rpx;height:62rpx;align-items:center;justify-content:center;margin-bottom:16rpx;border:4rpx solid rgba(255,255,255,.95);border-radius:50%;font-size:38rpx;line-height:1}
.video-fallback strong{font-size:31rpx}.video-fallback>text{margin-top:10rpx;color:rgba(255,255,255,.78);font-size:23rpx}
.video-fallback button{width:196rpx;margin:26rpx 0 0;border:2rpx solid rgba(255,255,255,.92);border-radius:99rpx;background:rgba(255,255,255,.1);color:#fff;font-size:25rpx;font-weight:700;line-height:64rpx}.video-fallback button::after{display:none}

.course-info-card{padding:32rpx 32rpx 30rpx;background:#fff}
.video-labels{display:flex;align-items:center;gap:18rpx}.video-labels text{padding:8rpx 16rpx;border-radius:10rpx;background:#e8f4ed;color:#17704e;font-size:22rpx;font-weight:800}.video-labels label{color:#8a9490;font-size:23rpx;font-weight:600}
.video-title{display:block;margin-top:22rpx;color:#111a16;font-size:39rpx;font-weight:900;line-height:1.42}
.course-author{display:flex;align-items:center;margin-top:16rpx;color:#8a9690;font-size:23rpx}.course-author i{margin:0 10rpx;font-style:normal}.course-author strong{color:#66746d;font-weight:500}

.lesson-controls{display:flex;gap:18rpx;margin-top:30rpx}.lesson-controls button{min-width:0;height:78rpx;flex:1;margin:0;padding:0 12rpx;border-radius:25rpx;background:#f0f4f2;color:#7f8a85;font-size:25rpx;font-weight:700;line-height:78rpx}.lesson-controls button::after{display:none}.lesson-controls button[disabled]{background:#f1f4f2;color:#aab2ae}.lesson-controls .complete-button{flex:1.5;background:linear-gradient(135deg,#178359,#106c48);color:#fff;box-shadow:0 10rpx 22rpx rgba(21,119,81,.2)}.lesson-controls .complete-button.done{background:#e5f1e9;color:#327257;box-shadow:none}.complete-icon{display:inline-flex;width:34rpx;height:34rpx;align-items:center;justify-content:center;margin-right:10rpx;border-radius:50%;background:#fff;color:#14754f;font-size:23rpx;line-height:34rpx;vertical-align:-5rpx}.complete-button.done .complete-icon{background:#327257;color:#fff}

.content-zone{padding:24rpx}.directory-card,.knowledge-card,.comment-section{margin-bottom:24rpx;padding:28rpx;border-radius:22rpx;background:#fff;box-shadow:0 7rpx 22rpx rgba(30,73,52,.045)}
.directory-head{display:flex;align-items:center;justify-content:space-between}.directory-head>strong{color:#166d4b;font-size:30rpx}.directory-head>view{color:#849089;font-size:22rpx}.directory-head>view text{margin-left:5rpx;font-size:34rpx;vertical-align:-2rpx}.series-title{display:block;margin-top:18rpx;color:#26332d;font-size:25rpx;font-weight:700}
.directory-list{margin-top:22rpx}.directory-row{display:flex;min-height:82rpx;align-items:center;gap:16rpx;padding:10rpx 16rpx;border-bottom:1rpx solid #edf2ef}.directory-row:last-child{border-bottom:0}.directory-row.selected{border:0;border-radius:16rpx;background:linear-gradient(90deg,#eff9f3,#f7fbf8)}
.lesson-number{display:flex;width:52rpx;height:52rpx;flex-shrink:0;align-items:center;justify-content:center;border-radius:10rpx;background:#e5f4eb;color:#16724e;font-size:22rpx;font-weight:900}.lesson-copy{display:flex;flex:1;min-width:0;align-items:center;gap:10rpx}.lesson-copy strong{overflow:hidden;color:#334039;font-size:23rpx;text-overflow:ellipsis;white-space:nowrap}.directory-row.selected .lesson-copy strong{color:#16724e}.lesson-copy small{flex-shrink:0;padding:3rpx 8rpx;border-radius:6rpx;background:#fff0d6;color:#a66d15;font-size:17rpx}.lesson-state{flex-shrink:0;color:#88938d;font-size:20rpx}.directory-row.selected .lesson-state{color:#176f4d;font-weight:700}.directory-error{padding:44rpx 0 20rpx;color:#89948e;font-size:22rpx;text-align:center}

.knowledge-card>strong{display:block;margin-bottom:14rpx;color:#176e4c;font-size:28rpx}.knowledge-card>view{display:flex;align-items:flex-start;padding:10rpx 0}.knowledge-card i{display:flex;width:34rpx;height:34rpx;flex-shrink:0;align-items:center;justify-content:center;margin:2rpx 14rpx 0 0;border-radius:50%;background:#edf6f0;color:#176e4c;font-size:17rpx;font-style:normal;font-weight:800}.knowledge-card text{color:#59665f;font-size:22rpx;line-height:1.6}

.comment-head{display:flex;align-items:baseline}.comment-head strong{color:#1c2822;font-size:31rpx}.comment-head text{margin-left:12rpx;color:#929c97;font-size:21rpx}.comment-loading{padding:70rpx 0;color:#8d9791;font-size:22rpx;text-align:center}.comment-empty{display:flex;min-height:270rpx;flex-direction:column;align-items:center;justify-content:center}
.comment-empty-icon{position:relative;display:flex;width:68rpx;height:54rpx;align-items:center;justify-content:center;margin-bottom:22rpx;border:3rpx solid #99a39e;border-radius:50%;color:#99a39e}.comment-empty-icon::after{position:absolute;bottom:-10rpx;left:12rpx;width:17rpx;height:17rpx;border-bottom:3rpx solid #99a39e;border-left:3rpx solid #99a39e;background:#fff;content:'';transform:rotate(-28deg)}.comment-empty-icon text{margin-top:-8rpx;font-size:22rpx;letter-spacing:4rpx}.comment-empty>strong{color:#303d36;font-size:25rpx}.comment-empty>text{margin-top:10rpx;color:#9ba49f;font-size:21rpx}
.comment-item{display:flex;padding:28rpx 0;border-bottom:1rpx solid #edf1ee}.comment-item:last-child{border-bottom:0}.comment-avatar{width:68rpx;height:68rpx;flex-shrink:0;border-radius:50%;background:#e3eee7}.comment-avatar.fallback{display:flex;align-items:center;justify-content:center;background:#dcece3;color:#17694b;font-size:25rpx;font-weight:800}.comment-main{display:flex;flex:1;min-width:0;flex-direction:column;margin-left:18rpx}.comment-author{display:flex;align-items:center;justify-content:space-between}.comment-author strong{color:#607068;font-size:21rpx}.comment-author text{color:#a1aaa4;font-size:18rpx}.reply-target{margin-top:9rpx;color:#34775e;font-size:19rpx}.comment-body{margin-top:9rpx;font-size:24rpx;line-height:1.65;word-break:break-all}.comment-actions{display:flex;justify-content:flex-end;gap:30rpx;margin-top:13rpx;color:#8d9791;font-size:19rpx}.comment-actions .liked{color:#d48624}

.comment-bottom-space{height:132rpx}.replying{position:fixed;z-index:20;right:0;bottom:calc(94rpx + env(safe-area-inset-bottom));left:0;display:flex;align-items:center;justify-content:space-between;padding:12rpx 30rpx;background:#eef5f0;color:#507060;font-size:19rpx}.comment-bar{position:fixed;z-index:20;right:0;bottom:0;left:0;display:flex;align-items:center;padding:14rpx 28rpx calc(14rpx + env(safe-area-inset-bottom));border-top:1rpx solid #e7ece9;background:rgba(255,255,255,.97);box-shadow:0 -8rpx 28rpx rgba(27,60,44,.06)}.comment-bar input{height:68rpx;flex:1;padding:0 26rpx;border-radius:99rpx;background:#f1f4f2;font-size:22rpx}.comment-bar button{width:112rpx;margin:0 0 0 16rpx;padding:0;border-radius:99rpx;background:#14754f;color:#fff;font-size:22rpx;font-weight:800;line-height:68rpx}.comment-bar button::after{display:none}
.course-info-card .video-title{display:block;margin:22rpx 0 16rpx;font-size:36rpx;font-weight:700;line-height:1.5;letter-spacing:1rpx}
.course-info-card .course-author{margin-top:12rpx;color:#86928b;font-size:23rpx}
.content-zone{padding:22rpx 24rpx}
.directory-card,.knowledge-card,.comment-section{padding:26rpx;border-radius:20rpx;box-shadow:none}
.directory-head>strong,.comment-head strong{font-size:28rpx;font-weight:700}
.series-title{color:#87928c;font-size:23rpx;font-weight:400;line-height:1.6}
.directory-row{padding:20rpx 12rpx;gap:14rpx}
.directory-row.selected{background:#edf6f0}
.lesson-copy strong{white-space:normal;font-size:24rpx;font-weight:500;line-height:1.5}
.lesson-state{font-size:19rpx}
.comment-empty{min-height:220rpx}

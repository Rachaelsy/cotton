.page{min-height:100vh;background:#f4f7f3;padding-bottom:140rpx;color:#1d372e}.cover{position:relative;height:430rpx}.cover image{width:100%;height:100%}.play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center;width:100rpx;height:100rpx;border-radius:50%;background:rgba(255,255,255,.9);color:#176d4f;font-size:42rpx}.summary,.teacher,.content{margin:24rpx 28rpx;background:#fff;border-radius:26rpx;padding:28rpx}.summary{display:flex;justify-content:space-between;align-items:center}.summary view,.teacher>view:last-child{display:flex;flex-direction:column;gap:9rpx}.summary strong{font-size:32rpx}.summary small,.teacher small{color:#86918b;font-size:21rpx}.summary label{background:#fff1d4;color:#a7741d;padding:8rpx 14rpx;border-radius:12rpx;font-size:22rpx}.teacher{display:flex;align-items:center;gap:18rpx}.avatar{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;border-radius:50%;background:#e4f2eb;color:#176d4f;font-weight:700}.teacher strong{font-size:25rpx}.content h2{font-size:29rpx;margin:0 0 18rpx}.content p{font-size:25rpx;line-height:1.8;color:#52625b}.point{display:grid;grid-template-columns:48rpx 1fr;gap:14rpx;align-items:center;padding:16rpx 0}.point i{display:flex;align-items:center;justify-content:center;width:44rpx;height:44rpx;border-radius:50%;background:#e4f2eb;color:#176d4f;font-style:normal}.point text{font-size:24rpx}.complete{position:fixed;left:28rpx;right:28rpx;bottom:28rpx;background:#177352;color:#fff;border:0;border-radius:22rpx;font-size:27rpx}.complete.done{background:#8a948f}

.point{display:flex;flex-direction:row}.point i{flex-shrink:0;margin-right:14rpx}.point text{flex:1;min-width:0}.complete{bottom:calc(28rpx + env(safe-area-inset-bottom))}

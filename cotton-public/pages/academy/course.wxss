.course-page{min-height:100vh;background:#fff;color:#18231a}.course-nav{position:absolute;z-index:5;top:0;right:0;left:0;display:flex;align-items:center;justify-content:space-between;padding-right:24rpx;padding-left:24rpx;color:#fff}.course-nav>text{font-size:26rpx;font-weight:800;text-shadow:0 2rpx 8rpx rgba(0,0,0,.35)}.course-back{display:flex;width:62rpx;height:62rpx;align-items:center;justify-content:center;border-radius:50%;background:rgba(0,0,0,.34);font-size:44rpx}.course-nav button{width:76rpx;margin:0;padding:0;border:0;background:rgba(0,0,0,.34);color:#fff;font-size:20rpx;line-height:54rpx;border-radius:99rpx}.course-nav button::after{display:none}.video-stage{position:relative;height:560rpx;background:#000}.video-stage>video,.video-stage>image{width:100%;height:100%}.video-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.08),rgba(0,0,0,.52))}.video-play{position:absolute;top:50%;left:50%;display:flex;width:88rpx;height:88rpx;align-items:center;justify-content:center;transform:translate(-50%,-50%);border:2rpx solid rgba(255,255,255,.8);border-radius:50%;background:rgba(255,255,255,.18);color:#fff;font-size:30rpx}
.video-info{padding:28rpx 28rpx 24rpx;border-bottom:1rpx solid #edf0ed}.video-labels{display:flex;align-items:center;gap:12rpx}.video-labels text,.video-labels label{padding:6rpx 12rpx;border-radius:8rpx;font-size:18rpx;font-weight:700}.video-labels text{background:#e7f2eb;color:#17694b}.video-labels label{background:#fff1d8;color:#9b671a}.video-title{display:block;margin-top:15rpx;font-size:35rpx;line-height:1.4}.video-summary{display:block;margin-top:12rpx;color:#69766f;font-size:22rpx;line-height:1.7}.video-actions{display:flex;align-items:center;justify-content:space-between;margin-top:22rpx}.video-actions>view{display:flex;flex-direction:column}.video-actions small{color:#929b95;font-size:18rpx}.video-actions strong{margin-top:3rpx;font-size:21rpx}.video-actions button{width:150rpx;margin:0;padding:0;background:#17694b;color:#fff;font-size:21rpx;font-weight:700;line-height:62rpx;border-radius:99rpx}.video-actions button.done{background:#e6eee9;color:#4d6d5d}
.directory-link{display:flex;align-items:center;padding:22rpx 28rpx;border-bottom:12rpx solid #f4f6f3;background:#fafbfa}.directory-icon{display:flex;width:52rpx;height:52rpx;align-items:center;justify-content:center;border-radius:13rpx;background:#e6f1ea;color:#17694b;font-size:30rpx}.directory-link>view:nth-child(2){display:flex;flex:1;min-width:0;flex-direction:column;margin-left:16rpx}.directory-link small{color:#929b95;font-size:18rpx}.directory-link strong{margin-top:3rpx;overflow:hidden;font-size:23rpx;text-overflow:ellipsis;white-space:nowrap}.directory-link>text{color:#7e8b83;font-size:42rpx}
.knowledge-strip{padding:10rpx 28rpx 22rpx;border-bottom:12rpx solid #f4f6f3}.knowledge-strip>view{display:flex;align-items:center;padding:10rpx 0}.knowledge-strip i{display:flex;width:34rpx;height:34rpx;flex-shrink:0;align-items:center;justify-content:center;margin-right:12rpx;border-radius:50%;background:#edf4ef;color:#17694b;font-size:17rpx;font-style:normal;font-weight:800}.knowledge-strip text{color:#536159;font-size:21rpx}
.comment-section{padding:28rpx}.comment-head{display:flex;align-items:baseline}.comment-head strong{font-size:31rpx}.comment-head text{margin-left:10rpx;color:#939c96;font-size:20rpx}.comment-loading,.comment-empty{padding:66rpx 0;color:#8d9791;font-size:21rpx;text-align:center}.comment-empty{display:flex;flex-direction:column}.comment-empty strong{color:#56635b;font-size:24rpx}.comment-empty text{margin-top:8rpx}.comment-item{display:flex;padding:27rpx 0;border-bottom:1rpx solid #edf0ed}.comment-avatar{width:70rpx;height:70rpx;flex-shrink:0;border-radius:50%;background:#e3eee7}.comment-avatar.fallback{display:flex;align-items:center;justify-content:center;background:#dcece3;color:#17694b;font-size:25rpx;font-weight:800}.comment-main{display:flex;flex:1;min-width:0;flex-direction:column;margin-left:18rpx}.comment-author{display:flex;align-items:center;justify-content:space-between}.comment-author strong{color:#65726a;font-size:21rpx}.comment-author text{color:#a1aaa4;font-size:18rpx}.reply-target{margin-top:9rpx;color:#34775e;font-size:19rpx}.comment-body{margin-top:9rpx;font-size:24rpx;line-height:1.65;word-break:break-all}.comment-actions{display:flex;justify-content:flex-end;gap:30rpx;margin-top:13rpx;color:#8d9791;font-size:19rpx}.comment-actions .liked{color:#d48624}.comment-bottom-space{height:150rpx}.replying{position:fixed;z-index:7;right:0;bottom:calc(96rpx + env(safe-area-inset-bottom));left:0;display:flex;align-items:center;justify-content:space-between;padding:12rpx 30rpx;background:#eef5f0;color:#507060;font-size:19rpx}.comment-bar{position:fixed;z-index:7;right:0;bottom:0;left:0;display:flex;align-items:center;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));border-top:1rpx solid #e3e8e4;background:rgba(255,255,255,.97);box-shadow:0 -6rpx 24rpx rgba(25,53,41,.07)}.comment-bar input{height:68rpx;flex:1;padding:0 23rpx;border-radius:99rpx;background:#f2f4f2;font-size:22rpx}.comment-bar button{width:112rpx;margin:0 0 0 14rpx;padding:0;background:#17694b;color:#fff;font-size:21rpx;font-weight:700;line-height:66rpx;border-radius:99rpx}

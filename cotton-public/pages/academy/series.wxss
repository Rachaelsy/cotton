.series-page{min-height:100vh;padding-bottom:70rpx;background:#f5f7f5;color:#18231d}.series-nav{display:flex;align-items:center;justify-content:space-between;height:88rpx;padding-right:26rpx;padding-left:26rpx;background:#fff}.series-nav>strong{font-size:31rpx}.nav-back{display:flex;width:62rpx;height:62rpx;align-items:center;justify-content:center;font-size:52rpx}.series-nav button{width:70rpx;margin:0;padding:0;border:0;background:transparent;color:#257054;font-size:20rpx;line-height:58rpx}.series-nav button::after{display:none}
.series-hero{position:relative;height:370rpx;overflow:hidden;background:#173d30}.series-hero>image{width:100%;height:100%}.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(3,20,13,.08),rgba(3,20,13,.8))}.hero-copy{position:absolute;right:32rpx;bottom:30rpx;left:32rpx;display:flex;flex-direction:column;color:#fff}.hero-copy text{color:#e5bd69;font-size:21rpx;font-weight:700}.hero-copy strong{margin-top:8rpx;font-size:39rpx;line-height:1.35}.hero-copy label{margin-top:10rpx;color:rgba(255,255,255,.75);font-size:21rpx}
.series-intro{margin:22rpx 24rpx 0;padding:27rpx;border:1rpx solid #e4e9e5;border-radius:22rpx;background:#fff}.series-intro>strong{font-size:28rpx}.series-intro>text{display:block;margin-top:12rpx;color:#69766e;font-size:22rpx;line-height:1.75}.series-intro>view{display:flex;align-items:center;justify-content:space-between;margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #edf0ed}.series-intro>view text{color:#929b95;font-size:20rpx}.series-intro>view strong{font-size:21rpx}
.directory-head{display:flex;align-items:flex-end;justify-content:space-between;padding:36rpx 28rpx 16rpx}.directory-head strong{font-size:31rpx}.directory-head text{color:#959e98;font-size:19rpx}.lesson-list{margin:0 24rpx;overflow:hidden;border:1rpx solid #e5eae6;border-radius:22rpx;background:#fff}.lesson-item{display:flex;align-items:center;min-height:126rpx;padding:20rpx 22rpx}.lesson-item+.lesson-item{border-top:1rpx solid #edf0ed}.lesson-index{display:flex;width:54rpx;height:54rpx;flex-shrink:0;align-items:center;justify-content:center;border-radius:50%;background:#edf3ef;color:#246b50;font-size:21rpx;font-weight:800}.lesson-index.done{background:#1c7253;color:#fff}.lesson-copy{display:flex;flex:1;min-width:0;flex-direction:column;margin-left:18rpx}.lesson-copy small{color:#a2732c;font-size:18rpx}.lesson-copy strong{margin-top:5rpx;overflow:hidden;font-size:25rpx;text-overflow:ellipsis;white-space:nowrap}.lesson-copy>text{margin-top:5rpx;color:#8b958f;font-size:19rpx}.lesson-copy label{color:#237052}.lesson-play{display:flex;width:52rpx;height:52rpx;align-items:center;justify-content:center;margin-left:12rpx;border-radius:50%;background:#17684b;color:#fff;font-size:18rpx}.empty{padding:100rpx 0;color:#929c96;text-align:center}

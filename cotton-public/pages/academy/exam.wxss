.page{min-height:100vh;background:#f4f7f3;color:#1c372d;padding-bottom:45rpx}.head{display:flex;flex-direction:column;padding:90rpx 34rpx 38rpx;background:linear-gradient(145deg,#123f32,#24745a);color:#fff}.head small{font-size:23rpx;opacity:.72}.head strong{font-size:44rpx;margin-top:10rpx}.head p{font-size:25rpx;opacity:.78}.question{margin:26rpx 28rpx;padding:28rpx;background:#fff;border-radius:26rpx}.question h2{font-size:27rpx;line-height:1.5;margin:0 0 22rpx}.option{display:flex;align-items:center;gap:16rpx;margin-top:14rpx;padding:20rpx;border:1rpx solid #e5ebe7;border-radius:18rpx}.option i{display:flex;align-items:center;justify-content:center;width:46rpx;height:46rpx;border-radius:50%;background:#edf3ef;color:#607068;font-style:normal;font-size:22rpx}.option text{font-size:24rpx}.option.chosen{border-color:#177352;background:#edf7f2}.option.chosen i{background:#177352;color:#fff}.result{display:flex;flex-direction:column;gap:10rpx;margin:26rpx 28rpx;padding:28rpx;background:#fff2d9;border-radius:22rpx;color:#8a611b}.result strong{font-size:30rpx}.result text{font-size:24rpx}.submit{margin:28rpx;background:#177352;color:#fff;border:0;border-radius:22rpx;font-size:27rpx}

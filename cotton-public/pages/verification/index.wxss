.page{height:100vh;background:#f4f7f3;color:#173a2d}.nav{display:flex;align-items:center;justify-content:space-between;padding:0 24rpx 18rpx;background:#fff;font-size:31rpx;font-weight:800}.back,.space{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx}.back{border-radius:50%;background:#eef4ee;font-size:45rpx}.content{height:calc(100vh - 100rpx);padding:24rpx;box-sizing:border-box}.notice,.form-card,.state,.reject{margin-bottom:22rpx;border-radius:24rpx;background:#fff}.notice{display:flex;align-items:center;padding:26rpx}.shield{display:flex;align-items:center;justify-content:center;width:62rpx;height:62rpx;flex-shrink:0;margin-right:18rpx;border-radius:18rpx;background:#e1f2e8;color:#177352;font-weight:900}.notice>view:last-child{display:flex;flex-direction:column}.notice text:first-child{font-size:25rpx;font-weight:800}.notice text:last-child{margin-top:7rpx;color:#7c8981;font-size:20rpx;line-height:1.6}.form-card{padding:30rpx}.label{display:block;margin:22rpx 0 10rpx;font-size:24rpx;font-weight:800}.label:first-child{margin-top:0}.form-card input{height:84rpx;padding:0 22rpx;border:1rpx solid #dbe4dc;border-radius:14rpx;background:#f8faf7;font-size:25rpx}.photos{display:flex;gap:16rpx}.photo{flex:1;min-width:0}.photo image,.photo-empty{width:100%;height:205rpx;border-radius:16rpx;background:#f0f4ef}.photo-empty{display:flex;align-items:center;justify-content:center;flex-direction:column;border:2rpx dashed #b5c2b7;box-sizing:border-box;color:#738178;font-size:22rpx}.photo-empty text:first-child{margin-bottom:8rpx;color:#338365;font-size:44rpx}.consent{display:flex;align-items:flex-start;margin-top:26rpx;color:#6f7c73;font-size:21rpx;line-height:1.55}.consent checkbox{transform:scale(.8);margin-right:4rpx}.primary{margin-top:28rpx;background:#187554!important;color:#fff!important;border-radius:16rpx;font-size:27rpx;font-weight:800}.state{padding:80rpx 30rpx;text-align:center}.state-icon{display:flex;align-items:center;justify-content:center;width:100rpx;height:100rpx;margin:0 auto 24rpx;border-radius:50%;font-size:36rpx;font-weight:800}.pending{background:#fff1ce;color:#a86f0b}.approved{background:#e1f3e8;color:#187554}.state-title,.state-sub{display:block}.state-title{font-size:31rpx;font-weight:800}.state-sub{margin-top:14rpx;color:#7c8881;font-size:23rpx}.reject{padding:26rpx;color:#a34c41}.reject text{display:block;margin-bottom:8rpx}.reject-title{font-weight:800}.reject button{margin-top:14rpx;background:#fff3f1;color:#a34c41;font-size:23rpx}

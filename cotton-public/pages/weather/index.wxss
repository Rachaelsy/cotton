.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: #17362d;
  background: #f3f6f1;
}

.weather-head {
  position: relative;
  z-index: 30;
  flex-shrink: 0;
  padding: 0 28rpx 22rpx;
  background: linear-gradient(145deg, #0f614b 0%, #168067 58%, #2a9279 100%);
  box-shadow: 0 12rpx 32rpx rgba(13, 78, 61, 0.16);
}

.location-picker-wrap {
  position: relative;
  width: 430rpx;
  max-width: 86%;
}

.location-picker-trigger {
  height: 72rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 21rpx;
  background: rgba(5, 57, 44, 0.25);
  box-shadow: 0 7rpx 20rpx rgba(0, 45, 33, 0.09);
}

.location-picker-trigger.open {
  border-color: rgba(255, 255, 255, 0.46);
  background: rgba(5, 57, 44, 0.4);
}

.picker-marker {
  width: 43rpx;
  height: 43rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: #13694f;
  background: #effaf5;
  font-size: 24rpx;
  font-weight: 900;
}

.picker-current {
  min-width: 0;
  flex: 1;
  margin-left: 13rpx;
  display: flex;
  flex-direction: column;
}

.picker-caption {
  color: rgba(255, 255, 255, 0.6);
  font-size: 17rpx;
  line-height: 1.25;
}

.picker-value {
  margin-top: 2rpx;
  overflow: hidden;
  color: #fff;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-chevron {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 31rpx;
  line-height: 1;
  transform: rotate(0deg);
  transition: transform 0.18s ease;
}

.picker-chevron.up {
  transform: rotate(180deg);
}

.location-dropdown {
  position: fixed;
  z-index: 41;
  left: 28rpx;
  width: 560rpx;
  max-width: 92vw;
  max-height: 560rpx;
  box-sizing: border-box;
  padding: 14rpx;
  overflow-y: auto;
  border: 1rpx solid rgba(20, 84, 65, 0.1);
  border-radius: 25rpx;
  background: #fff;
  box-shadow: 0 22rpx 58rpx rgba(16, 54, 43, 0.24);
}

.dropdown-heading {
  padding: 9rpx 11rpx 14rpx;
  color: #8a9892;
  font-size: 19rpx;
  font-weight: 700;
}

.dropdown-option {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 13rpx 14rpx;
  border-radius: 19rpx;
}

.dropdown-option + .dropdown-option {
  margin-top: 5rpx;
}

.dropdown-option.active {
  background: #eef8f3;
}

.option-icon {
  width: 55rpx;
  height: 55rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  font-size: 25rpx;
  font-weight: 900;
}

.option-icon.location {
  color: #24708a;
  background: #e9f4f8;
}

.option-icon.field {
  color: #197158;
  background: #e6f5ed;
}

.option-copy {
  min-width: 0;
  flex: 1;
  margin-left: 15rpx;
  display: flex;
  flex-direction: column;
}

.option-title {
  overflow: hidden;
  color: #173c31;
  font-size: 24rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.option-desc {
  margin-top: 4rpx;
  overflow: hidden;
  color: #88958f;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.option-check {
  width: 39rpx;
  height: 39rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fff;
  background: #19755b;
  font-size: 22rpx;
  font-weight: 900;
}

.picker-mask {
  position: fixed;
  z-index: 40;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(13, 34, 28, 0.26);
}

.nav-row {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  box-sizing: border-box;
}

.nav-copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
}

.nav-title {
  color: #fff;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.25;
}

.nav-subtitle {
  max-width: 430rpx;
  margin-top: 5rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.76);
  font-size: 21rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.back-button {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.12);
  font-size: 23rpx;
  font-weight: 700;
}

.source-scroll {
  display: block;
  width: 100%;
  height: 62rpx;
  overflow: hidden;
  white-space: nowrap;
}

.source-row {
  height: 62rpx;
  white-space: nowrap;
}

.source-pill {
  height: 56rpx;
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  margin-right: 14rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.82);
  background: rgba(5, 62, 47, 0.24);
  font-size: 23rpx;
  font-weight: 650;
  vertical-align: top;
}

.source-pill.selected {
  color: #135d49;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(0, 46, 34, 0.14);
}

.source-pin {
  margin-right: 9rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.page-scroll {
  height: 0;
  flex: 1;
}

.content {
  padding-top: 22rpx;
}

.state-card {
  margin: 28rpx;
  padding: 64rpx 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid rgba(19, 93, 73, 0.08);
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 12rpx 34rpx rgba(26, 65, 52, 0.07);
  text-align: center;
}

.state-icon {
  color: #24836b;
  font-size: 72rpx;
}

.loading-orbit {
  width: 90rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 8rpx solid #d9eee6;
  border-top-color: #168067;
  border-radius: 50%;
  color: #e2a737;
  font-size: 40rpx;
}

.state-title {
  margin-top: 24rpx;
  color: #163b30;
  font-size: 31rpx;
  font-weight: 800;
}

.state-desc {
  margin-top: 10rpx;
  color: #73867e;
  font-size: 23rpx;
  line-height: 1.6;
}

.retry-button,
.mini-retry {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #16775f;
  font-size: 23rpx;
  font-weight: 800;
}

.retry-button {
  margin-top: 24rpx;
  padding: 14rpx 34rpx;
  border-radius: 999rpx;
}

.hero-card {
  position: relative;
  margin: 0 24rpx;
  padding: 30rpx;
  overflow: hidden;
  border-radius: 34rpx;
  color: #fff;
  background: linear-gradient(148deg, #114d65 0%, #176e75 50%, #2b9279 100%);
  box-shadow: 0 18rpx 42rpx rgba(17, 80, 82, 0.22);
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 224, 137, 0.17);
}

.glow-one {
  top: -130rpx;
  right: -80rpx;
  width: 340rpx;
  height: 340rpx;
}

.glow-two {
  right: 180rpx;
  bottom: -180rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(121, 217, 205, 0.12);
}

.hero-meta,
.hero-weather,
.hero-facts,
.hero-footer {
  position: relative;
  z-index: 1;
}

.hero-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-location,
.source-badge {
  display: flex;
  align-items: center;
  min-width: 0;
  font-size: 21rpx;
  font-weight: 700;
}

.hero-location {
  max-width: 390rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-dot,
.live-dot {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  margin-right: 9rpx;
  border-radius: 50%;
  background: #f5c45d;
}

.source-badge {
  flex-shrink: 0;
  padding: 8rpx 15rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.86);
  background: rgba(255, 255, 255, 0.1);
  font-size: 19rpx;
}

.live-dot {
  width: 10rpx;
  height: 10rpx;
  background: #77e1a5;
}

.hero-weather {
  min-height: 194rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 6rpx 8rpx;
}

.temperature-wrap {
  display: flex;
  align-items: flex-start;
}

.temperature {
  font-size: 124rpx;
  font-weight: 300;
  letter-spacing: -8rpx;
  line-height: 1;
}

.degree {
  margin: 8rpx 0 0 8rpx;
  font-size: 50rpx;
  font-weight: 300;
}

.condition-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.condition-icon {
  font-size: 76rpx;
  line-height: 1;
}

.condition-text {
  margin-top: 9rpx;
  font-size: 27rpx;
  font-weight: 800;
}

.high-low {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.hero-facts {
  display: flex;
  align-items: stretch;
  padding: 18rpx 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.11);
  border-radius: 24rpx;
  background: rgba(6, 47, 51, 0.24);
}

.hero-fact {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fact-icon {
  font-size: 28rpx;
  line-height: 1;
}

.fact-value {
  max-width: 180rpx;
  margin-top: 7rpx;
  overflow: hidden;
  font-size: 23rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fact-label {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 18rpx;
}

.fact-divider {
  width: 1rpx;
  margin: 7rpx 0;
  background: rgba(255, 255, 255, 0.16);
}

.hero-footer {
  margin-top: 18rpx;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 20rpx;
  line-height: 1.5;
}

.hero-footer > text:first-child {
  flex: 1;
}

.updated-time {
  flex-shrink: 0;
  color: rgba(255, 255, 255, 0.52);
}

.inline-error,
.location-notice {
  margin: 18rpx 24rpx 0;
  display: flex;
  align-items: center;
  border-radius: 20rpx;
}

.inline-error {
  gap: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #f0c7a0;
  background: #fff4e8;
}

.inline-error-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.inline-error-title {
  color: #873f12;
  font-size: 23rpx;
  font-weight: 800;
}

.inline-error-desc {
  margin-top: 5rpx;
  color: #a26235;
  font-size: 20rpx;
  line-height: 1.45;
}

.mini-retry {
  width: 92rpx;
  height: 50rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
}

.location-notice {
  gap: 12rpx;
  padding: 17rpx 20rpx;
  color: #6d5728;
  background: #fff7df;
  font-size: 21rpx;
  line-height: 1.5;
}

.notice-icon {
  color: #c18b21;
  font-size: 28rpx;
  font-weight: 900;
}

.section-card {
  margin: 20rpx 24rpx 0;
  padding: 26rpx;
  border: 1rpx solid rgba(21, 91, 72, 0.06);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(31, 72, 58, 0.055);
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.section-head > view {
  display: flex;
  flex-direction: column;
}

.section-eyebrow {
  color: #c18d2a;
  font-size: 17rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.section-title {
  margin-top: 5rpx;
  color: #173c31;
  font-size: 30rpx;
  font-weight: 850;
}

.section-time {
  max-width: 250rpx;
  overflow: hidden;
  color: #8a9a93;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.decision-grid {
  display: flex;
  gap: 12rpx;
}

.decision-item {
  min-width: 0;
  flex: 1;
  padding: 19rpx 14rpx;
  display: flex;
  flex-direction: column;
  border: 1rpx solid transparent;
  border-radius: 20rpx;
}

.decision-item.green { color: #176f55; background: #ecf8f2; border-color: #d9eee5; }
.decision-item.amber { color: #94621a; background: #fff7e7; border-color: #f5e5bd; }
.decision-item.red { color: #a64a37; background: #fff0eb; border-color: #f4d9d1; }
.decision-item.blue { color: #326b82; background: #edf6f8; border-color: #d9eaf0; }

.decision-icon {
  font-size: 34rpx;
}

.decision-label {
  margin-top: 11rpx;
  color: #73857d;
  font-size: 18rpx;
}

.decision-value {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
}

.alert-card {
  margin: 20rpx 24rpx 0;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border: 1rpx solid;
  border-radius: 25rpx;
}

.alert-card.safe { color: #176b50; border-color: #cbe8db; background: linear-gradient(135deg, #e8f7f0, #f3fbf7); }
.alert-card.danger { color: #96521b; border-color: #edc99d; background: linear-gradient(135deg, #fff0dc, #fff8ec); }
.alert-card.unknown { color: #7c662f; border-color: #e9dcae; background: #fff9e8; }

.alert-icon-box {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 31rpx;
  font-weight: 900;
}

.alert-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.alert-title {
  font-size: 25rpx;
  font-weight: 850;
}

.alert-desc {
  margin-top: 5rpx;
  display: -webkit-box;
  overflow: hidden;
  color: #728078;
  font-size: 20rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.alert-arrow {
  flex-shrink: 0;
  font-size: 38rpx;
}

.hourly-scroll {
  width: 100%;
  white-space: nowrap;
}

.hourly-row {
  display: flex;
  gap: 12rpx;
  padding-bottom: 3rpx;
}

.hourly-item {
  width: 106rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  padding: 17rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid #edf1ed;
  border-radius: 21rpx;
  background: #f7f9f6;
}

.hourly-item.now {
  border-color: transparent;
  color: #fff;
  background: linear-gradient(160deg, #176f59, #26947a);
  box-shadow: 0 8rpx 20rpx rgba(23, 111, 89, 0.18);
}

.hour-time { color: #7e9088; font-size: 19rpx; }
.hour-icon { margin-top: 12rpx; font-size: 38rpx; line-height: 1; }
.hour-temp { margin-top: 10rpx; color: #193c32; font-size: 27rpx; font-weight: 850; }
.hour-rain { margin-top: 7rpx; color: #3e87a0; font-size: 18rpx; }
.hour-wind { max-width: 94rpx; margin-top: 5rpx; overflow: hidden; color: #87958f; font-size: 17rpx; text-overflow: ellipsis; white-space: nowrap; }
.hourly-item.now .hour-time,
.hourly-item.now .hour-temp,
.hourly-item.now .hour-rain,
.hourly-item.now .hour-wind { color: rgba(255, 255, 255, 0.9); }

.forecast-list {
  display: flex;
  flex-direction: column;
}

.forecast-day {
  min-height: 82rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  border-bottom: 1rpx solid #edf1ed;
}

.forecast-day:last-child { border-bottom: 0; }
.forecast-day.today { margin: 0 -10rpx; padding: 0 10rpx; border-radius: 16rpx; background: #f0f8f4; }
.forecast-name { width: 90rpx; flex-shrink: 0; color: #546b62; font-size: 22rpx; font-weight: 700; }
.forecast-day.today .forecast-name { color: #147259; font-weight: 900; }
.forecast-icon { width: 48rpx; flex-shrink: 0; font-size: 34rpx; text-align: center; }
.temperature-range { min-width: 0; flex: 1; }
.range-track { position: relative; height: 9rpx; border-radius: 999rpx; background: #edf1ec; }
.range-fill { position: absolute; top: 0; height: 9rpx; border-radius: 999rpx; background: linear-gradient(90deg, #55b9a5, #f1bb52, #e58147); }
.range-numbers { margin-top: 6rpx; display: flex; justify-content: space-between; }
.low-temp { color: #578497; font-size: 19rpx; font-weight: 700; }
.high-temp { color: #bd6640; font-size: 19rpx; font-weight: 800; }
.forecast-wind { width: 116rpx; flex-shrink: 0; color: #819088; font-size: 18rpx; line-height: 1.35; text-align: right; }

.detail-grid,
.stats-grid {
  display: flex;
  gap: 12rpx;
}

.detail-item,
.stat-item {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 20rpx;
  background: #f6f8f5;
}

.detail-item { padding: 20rpx 10rpx; }
.detail-icon { font-size: 31rpx; }
.detail-value { max-width: 170rpx; margin-top: 7rpx; overflow: hidden; color: #1d493c; font-size: 24rpx; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }
.detail-label { margin-top: 5rpx; color: #84928c; font-size: 18rpx; }
.field-tip { margin-top: 17rpx; padding: 18rpx 20rpx; border-left: 6rpx solid #e4aa3c; border-radius: 0 16rpx 16rpx 0; color: #66583a; background: #fff9e9; font-size: 21rpx; line-height: 1.55; }

.advice-list { display: flex; flex-direction: column; }
.advice-item { padding: 16rpx 0; display: flex; align-items: flex-start; gap: 17rpx; border-bottom: 1rpx solid #edf1ed; }
.advice-item:last-child { padding-bottom: 0; border-bottom: 0; }
.advice-item:first-child { padding-top: 0; }
.advice-icon { width: 68rpx; height: 68rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 19rpx; font-size: 32rpx; }
.advice-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.advice-title { color: #23473c; font-size: 25rpx; font-weight: 850; }
.advice-desc { margin-top: 6rpx; color: #708078; font-size: 21rpx; line-height: 1.55; }

.stat-item { padding: 22rpx 8rpx; }
.stat-value { color: #16715a; font-size: 28rpx; font-weight: 900; }
.stat-label { margin-top: 7rpx; color: #819089; font-size: 17rpx; line-height: 1.35; text-align: center; }
.stats-note { margin-top: 15rpx; display: block; color: #8b826e; font-size: 19rpx; line-height: 1.5; }
.empty-data { min-height: 100rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; color: #819089; background: #f6f8f5; font-size: 22rpx; }
.bottom-space { height: 44rpx; }

.modal-mask {
  position: fixed;
  z-index: 30;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(12, 30, 25, 0.5);
}

.alert-sheet {
  position: fixed;
  z-index: 31;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 74vh;
  box-sizing: border-box;
  padding: 0 30rpx 42rpx;
  overflow-y: auto;
  border-radius: 34rpx 34rpx 0 0;
  background: #fff;
  box-shadow: 0 -12rpx 44rpx rgba(0, 0, 0, 0.15);
}

.sheet-handle { width: 78rpx; height: 8rpx; margin: 17rpx auto 0; border-radius: 999rpx; background: #d7dfda; }
.sheet-head { padding: 24rpx 0 21rpx; display: flex; align-items: center; border-bottom: 1rpx solid #edf1ed; }
.sheet-title-wrap { min-width: 0; flex: 1; display: flex; align-items: center; gap: 16rpx; }

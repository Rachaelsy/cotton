<view class="page">
  <view class="weather-head" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-row" style="padding-right: {{capsuleSafeRight}}px">
      <view class="nav-copy">
        <text class="nav-title">{{copy.title}}</text>
        <text class="nav-subtitle">{{locationLabel}}</text>
      </view>
      <view class="back-button" bindtap="onBack">{{common.back}}</view>
    </view>

    <view class="location-picker-wrap">
      <view class="location-picker-trigger {{showLocationPicker ? 'open' : ''}}" bindtap="onToggleLocationPicker">
        <view class="picker-marker">⌖</view>
        <view class="picker-current">
          <text class="picker-caption">{{copy.weatherLocation}}</text>
          <text class="picker-value">{{selectedSourceLabel}}</text>
        </view>
        <text class="picker-chevron {{showLocationPicker ? 'up' : ''}}">⌄</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showLocationPicker}}" class="picker-mask" bindtap="onCloseLocationPicker"></view>
  <view wx:if="{{showLocationPicker}}" class="location-dropdown" style="top: {{pickerTop}}px" catchtap="noop">
    <view class="dropdown-heading">{{copy.chooseWeatherLocation}}</view>
    <view
      class="dropdown-option {{item.selected ? 'active' : ''}}"
      wx:for="{{fields}}"
      wx:key="id"
      catchtap="onChooseWeatherSource"
      data-index="{{index}}"
    >
      <view class="option-icon {{index === 0 ? 'location' : 'field'}}">{{index === 0 ? '⌖' : '田'}}</view>
      <view class="option-copy">
        <text class="option-title">{{item.label}}</text>
        <text class="option-desc">{{index === 0 ? copy.currentLocationDesc : copy.fieldLocationDesc}}</text>
      </view>
      <text wx:if="{{item.selected}}" class="option-check">✓</text>
    </view>
  </view>

  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="state-card loading-card">
      <view class="loading-orbit"><text>☀</text></view>
      <text class="state-title">{{copy.loadingTitle}}</text>
      <text class="state-desc">{{copy.loadingDesc}}</text>
    </view>

    <view wx:elif="{{loadError && !fields.length}}" class="state-card">
      <text class="state-icon">☁</text>
      <text class="state-title">{{copy.loadFailTitle}}</text>
      <text class="state-desc">{{loadError}}</text>
      <view class="retry-button" bindtap="onRetry">{{common.retry}}</view>
    </view>

    <view wx:else class="content">
      <view class="hero-card">
        <view class="hero-glow glow-one"></view>
        <view class="hero-glow glow-two"></view>

        <view class="hero-meta">
          <view class="hero-location">
            <text class="location-dot"></text>
            <text>{{selectedFieldLabel}}</text>
          </view>
          <view class="source-badge" bindtap="onSourceTap">
            <text class="live-dot"></text>
            <text>{{sourceInfo.label}}</text>
          </view>
        </view>

        <view class="hero-weather">
          <view class="temperature-wrap">
            <text class="temperature">{{weather.temp}}</text>
            <text wx:if="{{weather.temp !== '--'}}" class="degree">°</text>
          </view>
          <view class="condition-wrap">
            <text class="condition-icon">{{weather.icon}}</text>
            <text class="condition-text">{{weather.desc}}</text>
            <text class="high-low">{{weather.high}}° / {{weather.low}}°</text>
          </view>
        </view>

        <view class="hero-facts">
          <view class="hero-fact"><text class="fact-icon">💧</text><text class="fact-value">{{weather.humidity}}%</text><text class="fact-label">{{copy.humidity}}</text></view>
          <view class="fact-divider"></view>
          <view class="hero-fact"><text class="fact-icon">💨</text><text class="fact-value">{{weather.wind}}</text><text class="fact-label">{{copy.wind}}</text></view>
          <view class="fact-divider"></view>
          <view class="hero-fact"><text class="fact-icon">🌧</text><text class="fact-value">{{weather.rain}}mm</text><text class="fact-label">{{copy.rain}}</text></view>
        </view>

        <view class="hero-footer">
          <text>{{forecastSummary}}</text>
          <text class="updated-time">{{copy.updated}} {{updatedAt}}</text>
        </view>
      </view>

      <view wx:if="{{weatherDataError}}" class="inline-error">
        <view class="inline-error-copy">
          <text class="inline-error-title">{{copy.weatherDataFailTitle}}</text>
          <text class="inline-error-desc">{{weatherDataError}}</text>
        </view>
        <view class="mini-retry" bindtap="onRetry">{{common.retry}}</view>
      </view>

      <view wx:if="{{apiNotice}}" class="location-notice">
        <text class="notice-icon">⌖</text>
        <text>{{apiNotice}}</text>
      </view>

      <view class="section-card decision-card">
        <view class="section-head">
          <view><text class="section-eyebrow">WEATHER INSIGHT</text><text class="section-title">{{copy.fieldDecision}}</text></view>
          <text class="section-time">{{copy.next24Hours}}</text>
        </view>
        <view class="decision-grid">
          <view class="decision-item {{item.tone}}" wx:for="{{weatherHighlights}}" wx:key="label">
            <text class="decision-icon">{{item.icon}}</text>
            <text class="decision-label">{{item.label}}</text>
            <text class="decision-value">{{item.value}}</text>
          </view>
        </view>
      </view>

      <view class="alert-card {{alert ? 'danger' : (warningAvailable ? 'safe' : 'unknown')}}" bindtap="onAlertTap">
        <view class="alert-icon-box">{{alert ? alert.icon : (warningAvailable ? '✓' : '!')}}</view>
        <view class="alert-copy">
          <text class="alert-title">{{alert ? alert.title + (alert.level ? ' · ' + alert.level : '') : (warningAvailable ? copy.todayTip : copy.warningUnavailable)}}</text>
          <text class="alert-desc">{{alert ? alert.sub : (warningAvailable ? summary : copy.warningUnavailableDesc)}}</text>
        </view>
        <text class="alert-arrow">›</text>
      </view>

      <view class="section-card hourly-card">
        <view class="section-head">
          <view><text class="section-eyebrow">24 HOURS</text><text class="section-title">{{copy.next24Hours}}</text></view>
          <text class="section-time">{{selectedFieldLabel}}</text>
        </view>
        <view wx:if="{{!hourly.length}}" class="empty-data">{{copy.weatherDataEmpty}}</view>
        <scroll-view wx:else class="hourly-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="hourly-row">
            <view class="hourly-item {{item.now ? 'now' : ''}}" wx:for="{{hourly}}" wx:key="time">
              <text class="hour-time">{{item.time}}</text>
              <text class="hour-icon">{{item.icon}}</text>
              <text class="hour-temp">{{item.temp}}°</text>
              <text class="hour-rain">{{item.rainText}}</text>
              <text class="hour-wind">{{item.wind}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="section-card forecast-card">
        <view class="section-head">
          <view><text class="section-eyebrow">7 DAYS</text><text class="section-title">{{copy.futureTrend}}</text></view>
          <text class="section-time">{{copy.forecast7}}</text>
        </view>
        <view wx:if="{{!forecastDays.length}}" class="empty-data">{{copy.weatherDataEmpty}}</view>
        <view wx:else class="forecast-list">
          <view class="forecast-day {{item.isToday ? 'today' : ''}}" wx:for="{{forecastDays}}" wx:key="day">
            <text class="forecast-name">{{item.day}}</text>
            <text class="forecast-icon">{{item.icon}}</text>
            <view class="temperature-range">
              <view class="range-track"><view class="range-fill" style="{{item.barStyle}}"></view></view>
              <view class="range-numbers"><text class="low-temp">{{item.low}}°</text><text class="high-temp">{{item.high}}°</text></view>
            </view>
            <text class="forecast-wind">{{item.wind}}</text>
          </view>
        </view>
      </view>

      <view class="section-card detail-card">
        <view class="section-head">
          <view><text class="section-eyebrow">FIELD DATA</text><text class="section-title">{{copy.todayTip}}</text></view>
        </view>
        <view class="detail-grid">
          <view class="detail-item"><text class="detail-icon">🌱</text><text class="detail-value">{{weather.groundTemp}}{{weather.groundTemp === '--' ? '' : '°C'}}</text><text class="detail-label">{{weather.groundTempLabel || copy.groundTemp}}</text></view>
          <view class="detail-item"><text class="detail-icon">☀</text><text class="detail-value">{{weather.uv}}</text><text class="detail-label">{{copy.uv}}</text></view>
          <view class="detail-item"><text class="detail-icon">◉</text><text class="detail-value">{{weather.visibilityText}}</text><text class="detail-label">{{copy.visibility}}</text></view>
        </view>
        <view class="field-tip">{{tipText}}</view>
      </view>

      <view class="section-card advice-card">
        <view class="section-head">
          <view><text class="section-eyebrow">FARM ADVICE</text><text class="section-title">{{copy.aiAdvice}}</text></view>
        </view>
        <view wx:if="{{!advices.length}}" class="empty-data">{{copy.weatherDataEmpty}}</view>
        <view wx:else class="advice-list">
          <view class="advice-item" wx:for="{{advices}}" wx:key="title">
            <view class="advice-icon" style="background: {{item.bg}}">{{item.icon}}</view>
            <view class="advice-copy"><text class="advice-title">{{item.title}}</text><text class="advice-desc">{{item.sub}}</text></view>
          </view>
        </view>
      </view>

      <view wx:if="{{weatherStatistics}}" class="section-card stats-card">
        <view class="section-head"><view><text class="section-eyebrow">30 DAYS</text><text class="section-title">{{copy.climateStats}}</text></view></view>
        <view class="stats-grid">
          <view class="stat-item"><text class="stat-value">{{weatherStatistics.growingDegreeDays}}</text><text class="stat-label">{{copy.gdd}}</text></view>
          <view class="stat-item"><text class="stat-value">{{weatherStatistics.rainfallMm}}mm</text><text class="stat-label">{{copy.rain30}}</text></view>
          <view class="stat-item"><text class="stat-value">{{weatherStatistics.coverageDays}}/30</text><text class="stat-label">{{copy.coverage}}</text></view>
        </view>
        <text class="stats-note">{{statsTruthText}}</text>
      </view>

      <view class="bottom-space"></view>
    </view>
  </scroll-view>

  <view wx:if="{{showAlertDetail}}" class="modal-mask" bindtap="onCloseAlert"></view>
  <view wx:if="{{showAlertDetail}}" class="alert-sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="sheet-head">
      <view class="sheet-title-wrap">
        <view class="sheet-icon">{{alertDetail.icon}}</view>
        <view class="sheet-title-main"><text class="sheet-title">{{alertDetail.title}}</text><text class="sheet-sub">{{alertDetail.level}} · {{alertDetail.agency}}</text></view>
      </view>
      <view class="sheet-close" bindtap="onCloseAlert">×</view>
    </view>
    <view class="alert-info-grid">
      <view class="alert-info-item"><text class="info-label">{{copy.impactTime}}</text><text class="info-value">{{alertDetail.impactTime}}</text></view>
      <view class="alert-info-item"><text class="info-label">{{copy.impactArea}}</text><text class="info-value">{{alertDetail.impactArea}}</text></view>
    </view>
    <view class="alert-summary">{{alertDetail.sub}}</view>
    <text class="action-heading">{{copy.emergencyAdvice}}</text>
    <view class="action-row" wx:for="{{alertDetail.actions}}" wx:key="*this"><text class="action-dot"></text><text>{{item}}</text></view>
  </view>
</view>

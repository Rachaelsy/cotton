.learning-page{height:100vh;overflow:hidden;background:radial-gradient(circle at 12% 18%,rgba(220,239,227,.5),transparent 31%),linear-gradient(180deg,#fbfdfb 0%,#f7faf7 100%);color:#12251f}
.nav{position:relative;z-index:5;display:flex;min-height:92rpx;padding-right:28rpx;padding-left:28rpx;align-items:center;justify-content:space-between;background:rgba(255,255,255,.9);box-sizing:content-box}
.nav>text{font-size:37rpx;font-weight:900;letter-spacing:1rpx}.back,.space{display:flex;width:68rpx;height:68rpx;align-items:center;justify-content:center}.back{border-radius:50%;background:#edf4f0;color:#13241e;font-size:59rpx;font-weight:300;line-height:1}.content{height:calc(100vh - 116rpx);padding:25rpx 27rpx 54rpx;box-sizing:border-box}
.overview-card,.continue-card{padding:28rpx 25rpx 23rpx;border:1rpx solid rgba(228,235,230,.85);border-radius:29rpx;background:rgba(255,255,255,.96);box-shadow:0 12rpx 34rpx rgba(38,75,51,.07)}
.card-heading{display:flex;align-items:center}.card-heading>strong{font-size:31rpx;font-weight:900;letter-spacing:.5rpx}.heading-icon{position:relative;display:flex;width:45rpx;height:45rpx;margin-right:15rpx;align-items:center;justify-content:center;border-radius:50%;background:#e5f4eb}.leaf-icon view{width:25rpx;height:13rpx;border-radius:100% 0 100% 0;background:linear-gradient(135deg,#26aa68,#11784d);transform:rotate(-22deg)}.leaf-icon:after{position:absolute;width:23rpx;height:2rpx;background:#fff;content:"";transform:rotate(-45deg)}
.metrics{display:flex;margin-top:31rpx;align-items:center}.metric-item{display:flex;min-width:0;flex:1;align-items:center;flex-direction:column}.metric-item strong{max-width:100%;overflow:hidden;color:#102b22;font-size:43rpx;font-weight:800;line-height:1.15;text-overflow:ellipsis;white-space:nowrap}.metric-item text{margin-top:10rpx;color:#8b9490;font-size:21rpx}.metric-divider{width:1rpx;height:68rpx;background:#e3e8e5}.overview-line{height:1rpx;margin:30rpx 0 16rpx;background:#e5eae7}
.points-entry{display:flex;min-height:78rpx;padding:0 17rpx;align-items:center;justify-content:space-between;border-radius:18rpx;background:linear-gradient(95deg,#fff8e5,#fff4d5);color:#9d6d18}.points-label,.points-value{display:flex;align-items:center}.points-label>text{margin-left:16rpx;font-size:25rpx;font-weight:700}.points-star{display:flex;width:47rpx;height:47rpx;align-items:center;justify-content:center;border:3rpx solid #c99a36;border-radius:50%;color:#c99a36;font-size:28rpx}.points-value strong{font-size:38rpx}.points-value text{margin-left:18rpx;font-size:41rpx;font-weight:300}
.continue-card{margin-top:26rpx;padding-bottom:25rpx}.continue-heading{margin-bottom:25rpx}.play-icon{background:#daf1e4}.play-icon view{width:0;height:0;margin-left:4rpx;border-top:9rpx solid transparent;border-bottom:9rpx solid transparent;border-left:14rpx solid #168555}.continue-body{display:flex;align-items:flex-start}.continue-body>image{width:242rpx;height:174rpx;flex:none;border-radius:18rpx;background:#e5ece7}.continue-copy{display:flex;min-width:0;flex:1;margin-left:22rpx;flex-direction:column}.series-name{overflow:hidden;color:#919994;font-size:20rpx;line-height:1.3;text-overflow:ellipsis;white-space:nowrap}.continue-copy>strong{display:-webkit-box;overflow:hidden;min-height:64rpx;margin-top:8rpx;color:#14261f;font-size:28rpx;line-height:1.25;-webkit-box-orient:vertical;-webkit-line-clamp:2}.progress{height:10rpx;margin-top:14rpx;overflow:hidden;border-radius:10rpx;background:#e7eae8}.progress view{height:100%;border-radius:10rpx;background:linear-gradient(90deg,#23aa68,#08784a)}.progress-text{margin-top:8rpx;color:#919994;font-size:20rpx}.continue-action{display:flex;align-self:flex-end;min-width:162rpx;height:57rpx;margin-top:12rpx;padding:0 21rpx;align-items:center;justify-content:center;border-radius:999rpx;background:linear-gradient(135deg,#14905b,#08754a);box-sizing:border-box;box-shadow:0 8rpx 18rpx rgba(18,126,80,.17);color:#fff;font-size:21rpx;font-weight:700}.action-play{margin-right:11rpx;font-size:18rpx}
.section-head{display:flex;margin-top:39rpx;align-items:center;justify-content:space-between}.section-head strong{font-size:35rpx;font-weight:900}.section-head>text{color:#168052;font-size:22rpx}.section-head label{margin-left:4rpx;font-size:30rpx}.tabs{display:flex;height:74rpx;margin-top:17rpx;align-items:stretch}.tabs view{position:relative;display:flex;flex:1;align-items:center;justify-content:center;color:#969e99;font-size:24rpx;font-weight:600}.tabs .active{color:#168052;font-weight:800}.tabs .active:after{position:absolute;bottom:0;width:56rpx;height:5rpx;border-radius:6rpx;background:#138053;content:""}
.course-list{margin-top:18rpx}.series-card{display:flex;min-height:186rpx;margin-bottom:18rpx;padding:22rpx 18rpx 22rpx 22rpx;align-items:center;border:1rpx solid rgba(228,235,230,.9);border-radius:27rpx;background:#fff;box-shadow:0 10rpx 28rpx rgba(33,69,47,.06);box-sizing:border-box}.series-card>image{width:202rpx;height:166rpx;flex:none;border-radius:18rpx;background:#e5ece7}.series-copy{display:flex;min-width:0;flex:1;margin-left:21rpx;flex-direction:column}.series-badges{display:flex;gap:10rpx}.level,.status{padding:4rpx 11rpx;border-radius:7rpx;background:#e5f3ea;color:#187650;font-size:17rpx;line-height:26rpx}.status{background:#fff1d4;color:#a66d17}.status.completed{background:#e2f2e8;color:#19734e}.series-copy>strong{overflow:hidden;margin-top:8rpx;color:#13261f;font-size:27rpx;line-height:1.35;text-overflow:ellipsis;white-space:nowrap}.course-meta{margin-top:8rpx;color:#858f89;font-size:19rpx}.series-card .progress{height:9rpx;margin-top:12rpx}.series-copy small{margin-top:9rpx;color:#a0a7a3;font-size:17rpx}.arrow{margin-left:10rpx;color:#87928c;font-size:51rpx;font-weight:300}
.empty,.state{display:flex;padding:110rpx 28rpx;align-items:center;justify-content:center;flex-direction:column;color:#87938b;text-align:center}.state{height:65vh;box-sizing:border-box}.empty strong,.state strong{margin-top:20rpx;color:#46564c;font-size:28rpx}.empty>text,.state>text{margin-top:12rpx;font-size:22rpx}.empty button,.state button{width:260rpx;margin-top:28rpx;border-radius:99rpx;background:#187650;color:#fff;font-size:24rpx}.empty-book{display:flex;width:90rpx;height:90rpx;align-items:center;justify-content:center;border-radius:28rpx;background:#e5f1e9;color:#23805b;font-size:40rpx;font-weight:900}.bottom-space{height:60rpx}
.points-page{position:fixed;z-index:30;inset:0;background:#f4f7f3}.points-content{height:calc(100vh - 112rpx);padding:24rpx;box-sizing:border-box}.points-total{display:flex;padding:38rpx;align-items:center;flex-direction:column;border-radius:28rpx;background:linear-gradient(145deg,#fff2c6,#ffe39a);color:#8b5b10}.points-total>text{font-size:22rpx}.points-total strong{margin-top:8rpx;font-size:64rpx}.points-total small{margin-top:9rpx;color:#a47732;font-size:19rpx;text-align:center}.rules,.records{margin-top:20rpx;padding:26rpx;border-radius:24rpx;background:#fff}.rules>strong,.records>strong{font-size:27rpx}.rules>view{display:grid;margin-top:20rpx;grid-template-columns:1fr auto;gap:18rpx;color:#65746b;font-size:22rpx}.rules b,.record>b{color:#d58b17}.record{display:flex;padding:23rpx 0;align-items:center;justify-content:space-between;border-bottom:1rpx solid #edf1ee}.record>view{display:flex;min-width:0;flex-direction:column}.record>view strong{font-size:23rpx}.record>view text{margin-top:7rpx;color:#929c96;font-size:18rpx}.record>b{font-size:27rpx}.record-empty{padding:70rpx 0;color:#99a39c;text-align:center;font-size:21rpx}

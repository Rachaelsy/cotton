.page{height:100vh;background:#f3f6f2;color:#173b2e}.nav{display:flex;align-items:center;justify-content:space-between;padding:0 24rpx 18rpx;background:#fff;font-size:31rpx;font-weight:800}.back,.space{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx}.back{border-radius:50%;background:#eef4ee;font-size:45rpx}.content{height:calc(100vh - 100rpx);padding:24rpx;box-sizing:border-box}.hero{padding:34rpx;border-radius:28rpx;background:linear-gradient(145deg,#10523d,#218563);color:#fff}.eyebrow{font-size:20rpx;letter-spacing:3rpx;opacity:.7}.hero-title{display:block;margin-top:12rpx;font-size:34rpx;font-weight:800}.metrics{display:flex;margin-top:30rpx}.metrics view{display:flex;flex:1;flex-direction:column}.metrics text:first-child{font-size:29rpx;font-weight:800}.metrics text:last-child{margin-top:5rpx;font-size:19rpx;opacity:.68}.progress{height:10rpx;margin-top:24rpx;overflow:hidden;border-radius:10rpx;background:rgba(255,255,255,.18)}.progress view{height:100%;border-radius:10rpx;background:#f2ca6d}.level-card{display:flex;align-items:center;margin-top:20rpx;padding:25rpx;border-radius:24rpx;background:#fff}.level-card>view{display:flex;flex:1;min-width:0;flex-direction:column}.level-title{font-size:25rpx;font-weight:800}.level-sub{margin-top:7rpx;color:#87928b;font-size:20rpx}.level-card button{margin:0 0 0 16rpx;padding:0 22rpx;background:#edf6f0;color:#187554;border-radius:24rpx;font-size:21rpx;line-height:58rpx}.section{margin-top:22rpx;padding:26rpx;border-radius:26rpx;background:#fff}.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8rpx}.section-head text:first-child{font-size:27rpx;font-weight:800}.section-head text:last-child{color:#1e7a59;font-size:21rpx}.course{display:flex;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #edf0ed}.course:last-child{border-bottom:0}.course-icon{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;flex-shrink:0;border-radius:18rpx;background:#fff1d2;color:#98701d;font-size:22rpx;font-weight:800}.course-icon.done{background:#e2f3e9;color:#187554}.course-icon.locked{background:#eff1ee;color:#929a95}.course-copy{display:flex;flex:1;min-width:0;flex-direction:column;margin-left:17rpx}.tag,.level{margin-right:10rpx;color:#1c7758;font-size:18rpx}.level{color:#9a7a35}.course-title{margin-top:6rpx;font-size:24rpx;font-weight:700}.course-meta{margin-top:6rpx;color:#8b958f;font-size:18rpx}.course-state{margin-left:12rpx;color:#1d7858;font-size:19rpx}

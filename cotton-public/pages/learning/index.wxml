<view class="learning-page">
  <view class="nav" style="padding-top:{{statusBarHeight}}px">
    <view class="back" bindtap="back">‹</view>
    <text>我的学习</text>
    <view class="space"></view>
  </view>

  <view class="state" wx:if="{{loading}}">学习记录加载中…</view>
  <view class="state" wx:elif="{{error}}">
    <text>{{error}}</text>
    <button bindtap="load">重新加载</button>
  </view>
  <view class="state" wx:elif="{{loggedOut}}">
    <view class="empty-book">学</view>
    <strong>登录后查看学习成果</strong>
    <text>学习进度和积分会跟随账号同步</text>
    <button bindtap="login">去登录</button>
  </view>

  <scroll-view class="content" scroll-y wx:else>
    <view class="overview-card">
      <view class="card-heading">
        <view class="heading-icon leaf-icon"><view></view></view>
        <strong>学习概览</strong>
      </view>
      <view class="metrics">
        <view class="metric-item"><strong>{{summary.completedCount}}</strong><text>完成课时</text></view>
        <view class="metric-divider"></view>
        <view class="metric-item"><strong>{{summary.watchedText}}</strong><text>累计学习</text></view>
        <view class="metric-divider"></view>
        <view class="metric-item"><strong>{{series.length}}</strong><text>学习系列</text></view>
      </view>
      <view class="overview-line"></view>
      <view class="points-entry" bindtap="openPoints">
        <view class="points-label"><view class="points-star">★</view><text>学习积分</text></view>
        <view class="points-value"><strong>{{summary.totalPoints}}</strong><text>›</text></view>
      </view>
    </view>

    <view class="continue-card" wx:if="{{recent}}">
      <view class="card-heading continue-heading">
        <view class="heading-icon play-icon"><view></view></view>
        <strong>继续学习</strong>
      </view>
      <view class="continue-body" bindtap="openRecent">
        <image src="{{recent.cover}}" mode="aspectFill"></image>
        <view class="continue-copy">
          <text class="series-name">{{recent.seriesTitle}}</text>
          <strong>{{recent.title}}</strong>
          <view class="progress"><view style="width:{{recent.percent}}%"></view></view>
          <text class="progress-text">已学 {{recent.percent}}%</text>
          <view class="continue-action"><text class="action-play">▶</text><text>继续学习</text></view>
        </view>
      </view>
    </view>

    <view class="section-head">
      <strong>我的课程</strong>
      <text bindtap="openAcademy">进入优棉学堂 <label>›</label></text>
    </view>
    <view class="tabs">
      <view class="{{activeTab==='all'?'active':''}}" data-tab="all" bindtap="switchTab">全部</view>
      <view class="{{activeTab==='studying'?'active':''}}" data-tab="studying" bindtap="switchTab">学习中</view>
      <view class="{{activeTab==='completed'?'active':''}}" data-tab="completed" bindtap="switchTab">已完成</view>
    </view>

    <view class="course-list" wx:if="{{visibleSeries.length}}">
      <view class="series-card" wx:for="{{visibleSeries}}" wx:key="id" data-id="{{item.id}}" bindtap="openSeries">
        <image src="{{item.cover}}" mode="aspectFill"></image>
        <view class="series-copy">
          <view class="series-badges"><text class="level">{{item.levelName}}</text><text class="status {{item.status}}">{{item.statusText}}</text></view>
          <strong>{{item.title}}</strong>
          <text class="course-meta">已完成 {{item.completedCount}} / {{item.totalCount}} 节 · 已获 {{item.points}} 分</text>
          <view class="progress"><view style="width:{{item.progress}}%"></view></view>
          <small>最近学习 {{item.updatedText}}</small>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="empty" wx:else>
      <view class="empty-book">学</view>
      <strong>{{activeTab==='all'?'还没有开始学习':'这里还没有课程'}}</strong>
      <text>去优棉学堂选择适合你的农技课程</text>
      <button bindtap="openAcademy">去优棉学堂</button>
    </view>
    <view class="bottom-space"></view>
  </scroll-view>

  <view class="points-page" wx:if="{{showPoints}}">
    <view class="nav" style="padding-top:{{statusBarHeight}}px"><view class="back" bindtap="closePoints">‹</view><text>积分明细</text><view class="space"></view></view>
    <scroll-view class="points-content" scroll-y>
      <view class="points-total"><text>累计学习积分</text><strong>{{summary.totalPoints}}</strong><small>首次完成课时自动获得，重复观看不重复计分</small></view>
      <view class="rules"><strong>积分规则</strong><view><text>初级课时</text><b>+5</b><text>中级课时</text><b>+8</b><text>高级课时</text><b>+10</b></view></view>
      <view class="records">
        <strong>积分记录</strong>
        <view class="record" wx:for="{{pointRecords}}" wx:key="id"><view><strong>{{item.title}}</strong><text>{{item.reason}} · {{item.levelName}} · {{item.timeText}}</text></view><b>+{{item.points}}</b></view>
        <view class="record-empty" wx:if="{{!pointRecords.length}}">完成第一节课程后，积分会显示在这里</view>
      </view>
    </scroll-view>
  </view>
</view>

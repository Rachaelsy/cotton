<view class="page"><view class="nav" style="padding-top:{{statusBarHeight}}px"><view class="back" bindtap="back">‹</view><text>我的学习</text><view class="space"></view></view><scroll-view class="content" scroll-y>
  <view class="hero"><text class="eyebrow">学习成长</text><text class="hero-title">把知识用在每一块棉田</text><view class="metrics"><view><text>{{completed}} / {{courses.length}}</text><text>已学课程</text></view><view><text>{{points}}</text><text>学习积分</text></view><view><text>{{percent}}%</text><text>总进度</text></view></view><view class="progress"><view style="width:{{percent}}%"></view></view></view>
  <view class="level-card"><view><text class="level-title">进阶学习</text><text class="level-sub">{{level2Unlocked ? '已通过初级考试，进阶课程已解锁' : '完成初级学习并通过考试后解锁'}}</text></view><button bindtap="openExam">{{level2Unlocked ? '查看考试' : '参加考试'}}</button></view>
  <view class="section"><view class="section-head"><text>课程记录</text><text bindtap="openAcademy">进入学堂 ›</text></view>
    <view class="course" wx:for="{{courses}}" wx:key="id" data-id="{{item.id}}" data-locked="{{item.locked}}" bindtap="openCourse"><view class="course-icon {{item.done?'done':item.locked?'locked':''}}">{{item.done?'✓':item.locked?'锁':index+1}}</view><view class="course-copy"><view><text class="tag">{{item.type}}</text><text class="level">{{item.level}}</text></view><text class="course-title">{{item.title}}</text><text class="course-meta">{{item.duration}} · 完成可得 {{item.reward}} 积分</text></view><text class="course-state">{{item.done?'已完成':item.locked?'待解锁':'继续学习'}}</text></view>
  </view>
</scroll-view></view>

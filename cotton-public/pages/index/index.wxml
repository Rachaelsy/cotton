<view class="page">
  <view class="hero" style="padding-top:{{heroTop}}px">
    <view class="hero-head">
      <view class="brand-copy">
        <text class="eyebrow">喀什优棉公共服务平台</text>
        <text class="welcome">你好，{{userName}}</text>
      </view>
      <view class="hero-mark">棉</view>
    </view>

    <view class="weather-card" bindtap="openModule" data-key="weather">
      <view class="weather-copy">
        <view class="weather-location">
          <text>定位</text>
          <text class="weather-location-name">{{weatherPreview.locationLabel}}</text>
        </view>
        <view class="weather-main">
          <text class="weather-temp">{{weatherPreview.weather.temp}}{{weatherPreview.weather.temp === '--' ? '' : '°'}}</text>
          <view class="weather-detail">
            <strong>{{weatherPreview.weather.desc}}</strong>
            <view class="weather-facts">
              <text>最低 {{weatherPreview.weather.low}}{{weatherPreview.weather.low === '--' ? '' : '°'}}</text>
              <text>最高 {{weatherPreview.weather.high}}{{weatherPreview.weather.high === '--' ? '' : '°'}}</text>
              <text>{{weatherPreview.weather.wind}}</text>
            </view>
          </view>
        </view>
      </view>
      <text class="weather-icon">{{weatherPreview.weather.icon}}</text>
      <text class="weather-arrow">›</text>
    </view>
    <view class="farm-tip"><text>气象建议</text><strong>{{weatherPreview.tipText}}</strong></view>
  </view>

  <view class="plot-work-section {{plotWorkScrollable?'scrollable':''}}">
    <view class="plot-work-accent"></view>
    <view class="plot-work-head">
      <view class="plot-work-title"><view class="plot-work-mark">农</view><view><text>今日农事</text><small>{{plotWorkDate}} · 按地块安排</small></view></view>
      <view class="plot-work-head-actions">
        <text class="plot-work-count" wx:if="{{plotWorkGroups.length}}">{{plotWorkGroups.length}} 个地块</text>
        <view class="plot-work-all" bindtap="openAllPlotWork">全部任务 <text>›</text></view>
      </view>
    </view>
    <view wx:if="{{plotWorkLoading}}" class="plot-work-empty">正在加载您的地块农事...</view>
    <view wx:elif="{{plotWorkNeedsLogin}}" class="plot-work-empty">登录后查看本人地块的今日农事安排</view>
    <view wx:elif="{{plotWorkError}}" class="plot-work-empty">{{plotWorkError}}</view>
    <view wx:elif="{{!plotWorkGroups.length}}" class="plot-work-empty">今天暂无地块农事安排</view>
    <view wx:elif="{{!plotWorkScrollable}}" class="plot-work-groups">
      <view class="plot-work-group" wx:for="{{plotWorkGroups}}" wx:key="plotId">
        <view class="plot-work-group-head"><view><strong>{{item.plotName}}</strong><small>{{item.meta || '棉花地块'}}</small></view><text>地块</text></view>
        <view class="plot-work-item {{work.priority}}" wx:for="{{item.items}}" wx:for-item="work" wx:key="id">
          <view class="plot-work-dot"></view><view class="plot-work-copy"><view><strong>{{work.title}}</strong><label>{{work.priorityLabel}}</label></view><text wx:if="{{work.content}}">{{work.content}}</text><small>{{work.timeLabel || '今日完成'}}</small></view>
        </view>
      </view>
    </view>
    <scroll-view wx:else class="plot-work-groups plot-work-scroll" scroll-y="true" enhanced="true" show-scrollbar="false">
      <view class="plot-work-group" wx:for="{{plotWorkGroups}}" wx:key="plotId">
        <view class="plot-work-group-head"><view><strong>{{item.plotName}}</strong><small>{{item.meta || '棉花地块'}}</small></view><text>地块</text></view>
        <view class="plot-work-item {{work.priority}}" wx:for="{{item.items}}" wx:for-item="work" wx:key="id">
          <view class="plot-work-dot"></view><view class="plot-work-copy"><view><strong>{{work.title}}</strong><label>{{work.priorityLabel}}</label></view><text wx:if="{{work.content}}">{{work.content}}</text><small>{{work.timeLabel || '今日完成'}}</small></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="plot-work-voice-fab {{plotWorkSpeaking?'playing':''}}" style="width:94rpx;min-width:94rpx;max-width:94rpx;height:94rpx;min-height:94rpx;max-height:94rpx;border-radius:999rpx" bindtap="togglePlotWorkSpeech" role="button" aria-label="{{plotWorkSpeaking?'停止播报':'播报今日农事'}}">
    <view class="plot-work-voice-inner" style="display:flex;width:70rpx;height:70rpx;align-items:center;justify-content:center;border-radius:50%;background:rgba(255,255,255,.12);box-shadow:inset 0 0 0 2rpx rgba(255,255,255,.22)">
      <view wx:if="{{!plotWorkSpeaking}}" class="plot-work-mic"><view class="plot-work-mic-head"></view><view class="plot-work-mic-arc"></view><view class="plot-work-mic-stem"></view></view>
      <view wx:else class="plot-work-stop"></view>
    </view>
  </view>

  <view class="section quick-section">
    <view class="section-head"><view><text>常用工具</text></view></view>
    <view class="quick-grid">
      <view class="quick" bindtap="openModule" data-key="fields"><view class="tool-icon green"><image class="tool-icon-art" src="/images/home-icons/fields.png" mode="aspectFit"></image></view><text>地块管理</text></view>
      <view class="quick" bindtap="openModule" data-key="pest"><view class="tool-icon brown"><image class="tool-icon-art" src="/images/home-icons/pest.png" mode="aspectFit"></image></view><text>病虫害识别</text></view>
      <view class="quick" bindtap="openModule" data-key="weather"><view class="tool-icon blue"><image class="tool-icon-art" src="/images/home-icons/weather.png" mode="aspectFit"></image></view><text>地块气象</text></view>
      <view class="quick" bindtap="openModule" data-key="policy"><view class="tool-icon policy"><image class="tool-icon-art" src="/images/home-icons/policy.png" mode="aspectFit"></image></view><text>政策资讯</text></view>
      <view class="quick" bindtap="openModule" data-key="expert"><view class="tool-icon gold"><image class="tool-icon-art" src="/images/home-icons/expert.png" mode="aspectFit"></image></view><text>专家讲堂</text></view>
      <view class="quick" bindtap="openModule" data-key="records"><view class="tool-icon mint"><image class="tool-icon-art" src="/images/home-icons/records.png" mode="aspectFit"></image></view><text>农事记录</text></view>
      <view class="quick" bindtap="openModule" data-key="academy"><view class="tool-icon orange"><image class="tool-icon-art" src="/images/home-icons/academy.png" mode="aspectFit"></image></view><text>优棉学堂</text></view>
      <view class="quick" bindtap="openModule" data-key="finance"><view class="tool-icon finance"><image class="tool-icon-art" src="/images/home-icons/finance.png" mode="aspectFit"></image></view><text>优棉金融</text></view>
    </view>
  </view>

  <view class="section production-section">
    <view class="section-head">
      <view><text>生产服务</text></view>
    </view>
    <view class="production-grid">
      <view class="production-card machine" bindtap="openProduction" data-type="machine">
        <view class="production-icon"><image class="production-icon-art" src="/images/home-icons/machine.png" mode="aspectFit"></image></view>
        <view class="production-copy"><strong>农机服务</strong></view>
        <text class="production-arrow">›</text>
      </view>
      <view class="production-card supplies" bindtap="openProduction" data-type="supplies">
        <view class="production-icon"><image class="production-icon-art" src="/images/home-icons/supplies.png" mode="aspectFit"></image></view>
        <view class="production-copy"><strong>农资服务</strong></view>
        <text class="production-arrow">›</text>
      </view>
      <view class="production-card processing" bindtap="openProduction" data-type="processing">
        <view class="production-icon"><image class="production-icon-art" src="/images/home-icons/processing.png" mode="aspectFit"></image></view>
        <view class="production-copy"><strong>加工服务</strong></view>
        <text class="production-arrow">›</text>
      </view>
      <view class="production-card varieties" bindtap="openProduction" data-type="varieties">
        <view class="production-icon"><image class="production-icon-art" src="/images/home-icons/varieties.png" mode="aspectFit"></image></view>
        <view class="production-copy"><strong>品种优选</strong></view>
        <text class="production-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="ai-card" bindtap="openAi">
    <view class="ai-icon">AI</view>
    <view class="ai-copy"><strong>智能农技助手</strong></view>
    <text class="arrow">›</text>
  </view>

  <view class="section news-section">
    <view class="section-head"><view><text>首页推送</text></view><button bindtap="openNews">查看全部 ›</button></view>
    <view class="news" wx:for="{{news}}" wx:key="id" bindtap="openPolicy" data-id="{{item.id}}" data-url="{{item.targetUrl}}">
      <view><label>{{item.tag}}</label><strong>{{item.title}}</strong><small>{{item.source}}{{item.date ? ' · ' + item.date : ''}}</small></view><image src="{{item.image}}" mode="aspectFill"/>
    </view>
    <view class="news-empty" wx:if="{{!newsLoading && !news.length}}" bindtap="openNews"><text>暂时没有首页推送</text></view>
  </view>
</view>

.page{min-height:100vh;background:#f3f6f2;padding-bottom:48rpx;color:#17372c}.hero{padding:104rpx 30rpx 34rpx;background:linear-gradient(150deg,#0b5d45 0%,#13805e 68%,#27936d 100%);color:#fff;border-radius:0 0 48rpx 48rpx;box-shadow:0 16rpx 40rpx rgba(17,91,68,.13)}
.hero-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx}.brand-copy{display:flex;flex-direction:column}.eyebrow{font-size:22rpx;letter-spacing:3rpx;color:rgba(255,255,255,.7)}.welcome{margin-top:12rpx;font-size:34rpx;font-weight:700}.hero-mark{display:flex;align-items:center;justify-content:center;width:68rpx;height:68rpx;border-radius:22rpx;background:rgba(255,255,255,.13);border:1rpx solid rgba(255,255,255,.2);font-size:28rpx;font-weight:800}
.weather-card{display:flex;align-items:center;position:relative;padding:25rpx 52rpx 25rpx 26rpx;border-radius:28rpx;background:rgba(255,255,255,.96);color:#17372c;box-shadow:0 12rpx 32rpx rgba(2,54,39,.15)}.weather-copy{display:flex;flex:1;min-width:0;flex-direction:column}.weather-location{display:flex;align-items:center;margin-bottom:9rpx;color:#588072;font-size:20rpx}.weather-location text:first-child{margin-right:10rpx;padding:4rpx 10rpx;border-radius:999rpx;background:#e8f5ef;color:#167455;font-weight:700}.weather-main{display:flex;align-items:center}.weather-temp{font-size:62rpx;font-weight:800;line-height:1;color:#123d30}.weather-detail{display:flex;min-width:0;flex-direction:column;margin-left:18rpx}.weather-detail strong{font-size:26rpx}.weather-detail small{margin-top:7rpx;color:#7d8d86;font-size:20rpx}.weather-icon{flex-shrink:0;margin-left:18rpx;font-size:62rpx}.weather-arrow{position:absolute;right:20rpx;color:#98aaa3;font-size:38rpx}.farm-tip{display:flex;align-items:center;margin-top:18rpx;padding:0 10rpx;font-size:21rpx}.farm-tip text{flex-shrink:0;margin-right:12rpx;padding:5rpx 12rpx;border-radius:999rpx;background:rgba(255,255,255,.16);color:#d9f3e8}.farm-tip strong{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:rgba(255,255,255,.88);font-weight:500}
.section{margin:24rpx 24rpx 0;background:#fff;border-radius:30rpx;padding:28rpx;box-shadow:0 8rpx 28rpx rgba(26,65,51,.045)}.quick-section{margin-top:24rpx}.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:26rpx}.section-head>view{display:flex;flex-direction:column}.section-head text{font-size:31rpx;font-weight:750}.section-head small{margin-top:6rpx;color:#96a09b;font-size:19rpx}.section-head button{margin:0;padding:0;background:none;color:#197454;font-size:22rpx;line-height:1.5}
.quick-grid{display:flex;flex-direction:row;flex-wrap:wrap}.quick{display:flex;width:25%;box-sizing:border-box;flex-direction:column;align-items:center;margin-bottom:28rpx;font-size:21rpx;color:#2f493f}.quick i{display:flex;width:78rpx;height:78rpx;align-items:center;justify-content:center;margin-bottom:11rpx;border-radius:25rpx;font-size:28rpx;font-weight:800;font-style:normal;box-shadow:inset 0 0 0 1rpx rgba(255,255,255,.7)}.quick text{white-space:nowrap}.green{background:#e0f3e9;color:#157351}.brown{background:#f5e8dd;color:#9b592f}.blue{background:#e0eef6;color:#367aa5}.policy{background:#e9e9f8;color:#6059a0}.gold{background:#fbf0d5;color:#a67820}.mint{background:#e4f2ef;color:#337d70}.orange{background:#fde9d6;color:#b86724}
.ai-card{display:flex;align-items:center;margin:24rpx 24rpx 0;padding:27rpx 28rpx;border-radius:30rpx;background:linear-gradient(120deg,#173e34,#276f55);color:#fff;box-shadow:0 12rpx 28rpx rgba(21,76,58,.13)}.ai-icon{display:flex;align-items:center;justify-content:center;width:82rpx;height:82rpx;flex-shrink:0;border-radius:25rpx;background:linear-gradient(145deg,#f5cf77,#e6b94f);color:#173e34;font-size:27rpx;font-weight:900}.ai-copy{display:flex;flex:1;min-width:0;flex-direction:column;margin-left:20rpx}.ai-copy small{font-size:18rpx;color:#bfe2d4}.ai-copy strong{margin-top:4rpx;font-size:27rpx}.ai-copy text{margin-top:7rpx;color:rgba(255,255,255,.7);font-size:19rpx}.ai-card .arrow{font-size:42rpx;color:rgba(255,255,255,.65)}
.news-section{padding-bottom:12rpx}.news{display:flex;flex-direction:row;align-items:center;padding:22rpx 0;border-top:1rpx solid #edf0ed}.news>view{display:flex;flex:1;min-width:0;flex-direction:column;margin-right:20rpx}.news label{align-self:flex-start;padding:4rpx 10rpx;border-radius:7rpx;background:#eaf5ef;color:#177352;font-size:18rpx}.news strong{margin-top:10rpx;font-size:25rpx;line-height:1.45}.news small{margin-top:9rpx;color:#929b96;font-size:19rpx}.news image{width:166rpx;height:118rpx;flex-shrink:0;border-radius:18rpx}.notice{display:flex;align-items:center;margin:24rpx;padding:23rpx 25rpx;border-radius:24rpx;background:#fff7df}.notice-icon{display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;flex-shrink:0;margin-right:16rpx;border-radius:50%;background:#edc86e;color:#745616;font-weight:900}.notice>view:last-child{display:flex;flex-direction:column}.notice text{color:#86631d;font-weight:700}.notice small{margin-top:6rpx;color:#7c725e;font-size:20rpx}

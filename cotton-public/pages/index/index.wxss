.page{min-height:100vh;background:#f4f7f3;padding-bottom:40rpx;color:#18352b}.hero{padding:104rpx 36rpx 38rpx;background:linear-gradient(145deg,#0c654a,#178461);color:#fff;border-radius:0 0 46rpx 46rpx}.eyebrow{font-size:24rpx;opacity:.76;letter-spacing:3rpx}.welcome{font-size:28rpx;margin-top:28rpx}.hero-title{font-size:48rpx;font-weight:700;margin-top:12rpx}.hero-sub{font-size:24rpx;opacity:.78;margin-top:10rpx}.today-card{display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.13);padding:24rpx;margin-top:32rpx;border:1rpx solid rgba(255,255,255,.2);border-radius:24rpx}.today-card view{display:flex;flex-direction:column;gap:8rpx}.today-card text{font-size:21rpx;opacity:.72}.today-card strong{font-size:27rpx}.today-card button{margin:0;background:#fff;color:#13684c;border:0;border-radius:30rpx;font-size:22rpx;line-height:58rpx}.section{margin:26rpx 28rpx;background:#fff;border-radius:28rpx;padding:28rpx}.quick-section{margin-top:26rpx}.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx}.section-head>text{font-size:32rpx;font-weight:700}.section-head small{color:#89958f;font-size:22rpx}.section-head button{margin:0;padding:0;background:none;color:#27755a;font-size:23rpx;line-height:1.5}.quick-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30rpx 14rpx}.quick{display:flex;flex-direction:column;align-items:center;gap:12rpx;font-size:24rpx}.quick i{display:flex;width:86rpx;height:86rpx;align-items:center;justify-content:center;border-radius:25rpx;font-size:30rpx;font-weight:700;font-style:normal}.green{background:#e0f2e9;color:#157351}.brown{background:#f5e8dd;color:#9b592f}.blue{background:#e0eef6;color:#367aa5}.gold{background:#fbf0d5;color:#a67820}.mint{background:#e4f2ef;color:#337d70}.orange{background:#fde9d6;color:#b86724}.ai-card{display:flex;align-items:center;gap:20rpx;margin:26rpx 28rpx;padding:28rpx;border-radius:27rpx;background:linear-gradient(120deg,#173e34,#276750);color:#fff}.ai-icon{display:flex;align-items:center;justify-content:center;width:78rpx;height:78rpx;border-radius:22rpx;background:#e8bd62;color:#173e34;font-weight:800}.ai-card view:nth-child(2){display:flex;flex:1;flex-direction:column;gap:8rpx}.ai-card strong{font-size:29rpx}.ai-card text{font-size:22rpx;opacity:.75}.ai-card .arrow{font-size:50rpx}.news-section{padding-bottom:12rpx}.news{display:grid;grid-template-columns:1fr 176rpx;gap:22rpx;padding:22rpx 0;border-top:1rpx solid #edf0ed}.news:first-of-type{border-top:0}.news>view{display:flex;flex-direction:column;gap:10rpx}.news label{color:#177352;font-size:20rpx}.news strong{font-size:27rpx;line-height:1.45}.news small{color:#929b96;font-size:20rpx}.news image{width:176rpx;height:126rpx;border-radius:18rpx}.notice{margin:26rpx 28rpx;padding:25rpx 28rpx;border-radius:22rpx;background:#fff5da}.notice text,.notice small{display:block}.notice text{color:#946b19;font-weight:700}.notice small{color:#7c725e;margin-top:8rpx;font-size:22rpx}

/* Skyline 真机对 CSS Grid 支持不一致，核心排版统一使用 Flex。 */
.quick-grid{display:flex;flex-direction:row;flex-wrap:wrap;gap:0}.quick{width:33.3333%;box-sizing:border-box;margin-bottom:30rpx}.news{display:flex;flex-direction:row;align-items:center;gap:0}.news>view{flex:1;min-width:0;margin-right:22rpx}.news image{flex-shrink:0}

.policy-home{margin:26rpx 28rpx;padding:28rpx;background:#fff;border-radius:28rpx}.policy-home-head{display:flex;align-items:center}.policy-seal{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;flex-shrink:0;margin-right:18rpx;border-radius:20rpx;background:#e9f1ec;color:#176b4e;font-size:31rpx;font-weight:700}.policy-home-title{display:flex;flex:1;min-width:0;flex-direction:column}.policy-home-title text{font-size:31rpx;font-weight:700}.policy-home-title small{margin-top:6rpx;color:#86928c;font-size:19rpx}.policy-more{flex-shrink:0;margin-left:12rpx;color:#176b4e;font-size:22rpx}.policy-feature{margin-top:24rpx;padding:25rpx;border-radius:22rpx;background:linear-gradient(135deg,#123f33,#237357);color:#fff}.policy-badges{display:flex}.policy-badges text{margin-right:10rpx;padding:5rpx 12rpx;border-radius:8rpx;background:rgba(255,255,255,.14);font-size:18rpx}.policy-badges text:first-child{background:#e8bd61;color:#274d3e}.policy-feature>strong,.policy-feature>small{display:block}.policy-feature>strong{margin-top:16rpx;font-size:28rpx;line-height:1.45}.policy-feature>small{margin-top:8rpx;color:rgba(255,255,255,.72);font-size:21rpx}.policy-feature-foot{display:flex;justify-content:space-between;margin-top:20rpx;padding-top:17rpx;border-top:1rpx solid rgba(255,255,255,.14);font-size:19rpx;color:rgba(255,255,255,.72)}.policy-shortcuts{display:flex;margin-top:20rpx}.policy-shortcuts>view{display:flex;flex:1;min-width:0;flex-direction:column;align-items:center;padding:15rpx 5rpx;border-right:1rpx solid #edf0ed}.policy-shortcuts>view:last-child{border-right:0}.policy-shortcuts strong{font-size:23rpx;color:#28483c}.policy-shortcuts small{margin-top:6rpx;color:#929b96;font-size:18rpx}

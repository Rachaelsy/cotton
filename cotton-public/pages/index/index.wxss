.page{min-height:100vh;background:#f3f6f2;padding-bottom:48rpx;color:#17372c}.hero{padding:104rpx 30rpx 38rpx;background:linear-gradient(150deg,#0b5d45 0%,#13805e 68%,#27936d 100%);color:#fff;border-radius:0 0 48rpx 48rpx;box-shadow:0 16rpx 40rpx rgba(17,91,68,.13)}
.hero-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx}.brand-copy{display:flex;flex-direction:column}.eyebrow{font-size:24rpx;letter-spacing:3rpx;color:rgba(255,255,255,.7)}.welcome{margin-top:12rpx;font-size:34rpx;font-weight:700}.hero-mark{display:flex;align-items:center;justify-content:center;width:68rpx;height:68rpx;border-radius:22rpx;background:rgba(255,255,255,.13);border:1rpx solid rgba(255,255,255,.2);font-size:28rpx;font-weight:800}
.weather-card{position:relative;display:flex;min-height:184rpx;align-items:center;padding:28rpx 70rpx 28rpx 28rpx;border-radius:28rpx;background:rgba(255,255,255,.96);color:#17372c;box-shadow:0 12rpx 32rpx rgba(2,54,39,.15)}.weather-copy{display:flex;min-width:0;flex:1;flex-direction:column}.weather-location{display:flex;min-width:0;align-items:flex-start;margin-bottom:14rpx;color:#588072;font-size:22rpx;line-height:1.45}.weather-location text:first-child{flex:none;margin-right:10rpx;padding:4rpx 10rpx;border-radius:999rpx;background:#e8f5ef;color:#167455;font-weight:700}.weather-location-name{display:block;min-width:0;flex:1;word-break:break-all}.weather-main{display:flex;min-width:0;align-items:center}.weather-temp{flex:none;color:#123d30;font-size:64rpx;font-weight:800;line-height:1}.weather-detail{display:flex;min-width:0;flex:1;margin-left:20rpx;flex-direction:column}.weather-detail strong{font-size:27rpx;line-height:1.35}.weather-facts{display:flex;flex-wrap:wrap;margin-top:9rpx;gap:6rpx 14rpx}.weather-facts text{color:#71827a;font-size:20rpx;line-height:1.45;white-space:nowrap}.weather-icon{width:70rpx;flex:none;margin-left:14rpx;font-size:58rpx;text-align:center}.weather-arrow{position:absolute;right:22rpx;color:#98aaa3;font-size:38rpx}.farm-tip{display:flex;align-items:flex-start;margin-top:20rpx;padding:0 10rpx;font-size:23rpx;line-height:1.55}.farm-tip text{flex:none;margin-right:12rpx;padding:5rpx 12rpx;border-radius:999rpx;background:rgba(255,255,255,.16);color:#d9f3e8;line-height:1.4}.farm-tip strong{display:block;min-width:0;flex:1;color:rgba(255,255,255,.9);font-weight:500;white-space:normal;word-break:break-all}
.section{margin:24rpx 24rpx 0;background:#fff;border-radius:30rpx;padding:28rpx;box-shadow:0 8rpx 28rpx rgba(26,65,51,.045)}.quick-section{margin-top:24rpx}.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:26rpx}.section-head>view{display:flex;flex-direction:column}.section-head text{font-size:31rpx;font-weight:750}.section-head small{margin-top:6rpx;color:#96a09b;font-size:21rpx}.section-head button{margin:0;padding:0;background:none;color:#197454;font-size:24rpx;line-height:1.5}
.todo-section{position:relative;display:flex;height:492rpx;box-sizing:border-box;overflow:hidden;flex-direction:column;margin:24rpx 24rpx 0;padding:28rpx 28rpx 18rpx;border:1rpx solid rgba(34,122,87,.09);border-radius:32rpx;background:linear-gradient(150deg,#fff 0%,#f4faf6 72%,#ebf6f0 100%);box-shadow:0 10rpx 30rpx rgba(25,78,59,.07)}.todo-accent{position:absolute;top:0;left:0;width:150rpx;height:7rpx;border-radius:0 999rpx 999rpx 0;background:linear-gradient(90deg,#167553,#46ad83)}.todo-head{display:flex;flex:none;align-items:center;justify-content:space-between}.todo-title{display:flex;min-width:0;align-items:center}.todo-mark{display:flex;width:60rpx;height:60rpx;flex:none;align-items:center;justify-content:center;margin-right:15rpx;border-radius:20rpx;background:linear-gradient(145deg,#187a58,#35a278);color:#fff;font-size:27rpx;font-weight:900;box-shadow:0 8rpx 18rpx rgba(22,117,83,.17)}.todo-title>view:last-child{display:flex;min-width:0;flex-direction:column}.todo-title text{color:#173b2e;font-size:31rpx;font-weight:850}.todo-title small{margin-top:3rpx;color:#8b9c94;font-size:19rpx}.todo-voice{display:flex;flex:none;align-items:center;gap:7rpx;margin:0;padding:11rpx 18rpx;border:1rpx solid #d2e8dd;border-radius:999rpx;background:#edf8f2;color:#167454;font-size:22rpx;font-weight:800;line-height:1.35}.todo-voice::after{border:0}.todo-voice text{font-size:22rpx}.todo-voice.playing{border-color:#176f53;background:#176f53;color:#fff}.todo-scroll{height:330rpx;margin-top:18rpx;border-radius:22rpx;background:rgba(255,255,255,.72)}.todo-item{display:flex;align-items:flex-start;margin:0 16rpx;padding:20rpx 4rpx;border-bottom:1rpx solid #e7efea}.todo-item:last-child{border-bottom:0}.todo-order{display:flex;width:42rpx;height:42rpx;flex:none;align-items:center;justify-content:center;margin-top:2rpx;border-radius:14rpx;background:#e2f3ea;color:#177454;font-size:21rpx;font-weight:900}.todo-item.important .todo-order{background:#fff0cf;color:#a06d16}.todo-item.urgent .todo-order{background:#fde8e1;color:#aa4f3c}.todo-copy{display:flex;min-width:0;flex:1;flex-direction:column;margin-left:15rpx}.todo-row{display:flex;align-items:flex-start;justify-content:space-between;gap:14rpx}.todo-copy strong{color:#243e34;font-size:25rpx;line-height:1.45}.priority-label{flex:none;padding:4rpx 10rpx;border-radius:999rpx;background:#edf5f1;color:#5e776c;font-size:18rpx;font-weight:700}.todo-item.important .priority-label{background:#fff4dc;color:#9b6c1e}.todo-item.urgent .priority-label{background:#fff0eb;color:#a4503e}.todo-voice-text{display:block;margin-top:8rpx;color:#5f7169;font-size:22rpx;line-height:1.62;word-break:break-all}.todo-time{align-self:flex-start;margin-top:9rpx;padding:4rpx 10rpx;border-radius:8rpx;background:#f0f5f2;color:#789087;font-size:19rpx}.todo-empty{display:flex;flex:1;align-items:center;justify-content:center;padding:30rpx;color:#8d9a94;font-size:22rpx;text-align:center}.todo-summary{display:flex;flex:none;align-items:center;justify-content:space-between;padding-top:13rpx;color:#587268;font-size:20rpx}.todo-summary small{color:#99a69f;font-size:19rpx}
.quick-grid{display:flex;flex-direction:row;flex-wrap:wrap}.quick{display:flex;width:25%;box-sizing:border-box;flex-direction:column;align-items:center;margin-bottom:28rpx;font-size:23rpx;color:#2f493f}.quick .tool-icon{display:flex;width:78rpx;height:78rpx;align-items:center;justify-content:center;margin-bottom:11rpx;border-radius:25rpx;box-shadow:inset 0 0 0 1rpx rgba(255,255,255,.7),0 5rpx 12rpx rgba(24,73,55,.05)}.tool-icon-art{width:48rpx;height:48rpx}.quick text{white-space:nowrap}.green{background:#e0f3e9;color:#157351}.brown{background:#f5e8dd;color:#9b592f}.blue{background:#e0eef6;color:#367aa5}.policy{background:#e9e9f8;color:#6059a0}.gold{background:#fbf0d5;color:#a67820}.mint{background:#e4f2ef;color:#337d70}.orange{background:#fde9d6;color:#b86724}.finance{background:#e8edf7;color:#3e5f91}
.production-section{padding-bottom:26rpx}.section-badge{padding:7rpx 13rpx;border-radius:999rpx;background:#edf7f2;color:#167454;font-size:20rpx;font-weight:700}.production-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.production-card{position:relative;display:flex;align-items:center;min-width:0;flex-direction:row;padding:20rpx 24rpx;border:1rpx solid #e8eee9;border-radius:22rpx;background:linear-gradient(160deg,#f8fbf9,#f0f7f3);box-shadow:0 7rpx 18rpx rgba(29,76,58,.05)}.production-card:active{transform:scale(.98);opacity:.88}.production-icon{display:flex;align-items:center;justify-content:center;width:66rpx;height:66rpx;flex:none;border-radius:21rpx;background:#dff3e9;color:#147451}.production-icon-art{width:42rpx;height:42rpx}.production-copy{display:flex;align-items:flex-start;min-width:0;flex-direction:column}.production-copy strong{margin-left:14rpx;color:#214238;font-size:24rpx;white-space:nowrap}.production-arrow{position:absolute;right:12rpx;top:30rpx;color:#8fa69c;font-size:26rpx}.production-card.supplies{background:linear-gradient(160deg,#fffaf0,#faf3e5)}.production-card.supplies .production-icon{background:#f8eac6;color:#9b701c}.production-card.processing{background:linear-gradient(160deg,#f3f8fb,#eaf2f6)}.production-card.processing .production-icon{background:#dcecf3;color:#397592}.production-card.varieties{background:linear-gradient(160deg,#f7f3fb,#eee8f7)}.production-card.varieties .production-icon{background:#e5daf3;color:#6c4a94}
.ai-card{display:flex;align-items:center;margin:24rpx 24rpx 0;padding:27rpx 28rpx;border-radius:30rpx;background:linear-gradient(120deg,#173e34,#276f55);color:#fff;box-shadow:0 12rpx 28rpx rgba(21,76,58,.13)}.ai-icon{display:flex;align-items:center;justify-content:center;width:82rpx;height:82rpx;flex-shrink:0;border-radius:25rpx;background:linear-gradient(145deg,#f5cf77,#e6b94f);color:#173e34;font-size:27rpx;font-weight:900}.ai-copy{display:flex;flex:1;min-width:0;flex-direction:column;margin-left:20rpx}.ai-copy strong{font-size:28rpx}.ai-card .arrow{font-size:42rpx;color:rgba(255,255,255,.65)}
.news-section{padding-bottom:12rpx}.news{display:flex;flex-direction:row;align-items:center;padding:22rpx 0;border-top:1rpx solid #edf0ed}.news>view{display:flex;flex:1;min-width:0;flex-direction:column;margin-right:20rpx}.news label{align-self:flex-start;padding:4rpx 10rpx;border-radius:7rpx;background:#eaf5ef;color:#177352;font-size:20rpx}.news strong{margin-top:10rpx;font-size:25rpx;line-height:1.45}.news small{margin-top:9rpx;color:#929b96;font-size:21rpx}.news image{width:166rpx;height:118rpx;flex-shrink:0;border-radius:18rpx}.news-empty{display:flex;align-items:center;flex-direction:column;padding:48rpx 20rpx;border-top:1rpx solid #edf0ed;color:#63726b}.news-empty text{font-size:25rpx;font-weight:700}.news-empty small{margin-top:10rpx;color:#98a19c;font-size:22rpx;text-align:center}.notice{display:flex;align-items:center;margin:24rpx;padding:23rpx 25rpx;border-radius:24rpx;background:#fff7df}.notice-icon{display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;flex-shrink:0;margin-right:16rpx;border-radius:50%;background:#edc86e;color:#745616;font-weight:900}.notice>view:last-child{display:flex;flex-direction:column}.notice text{color:#86631d;font-weight:700}.notice small{margin-top:6rpx;color:#7c725e;font-size:22rpx}
.todo-voice-fab{position:fixed;z-index:40;right:28rpx;bottom:calc(126rpx + env(safe-area-inset-bottom));display:flex;width:94rpx;height:94rpx;box-sizing:border-box;align-items:center;justify-content:center;margin:0;padding:0;border:5rpx solid rgba(255,255,255,.92);border-radius:50%;background:linear-gradient(145deg,#20a676,#087050);color:#fff;line-height:1;box-shadow:0 0 0 8rpx rgba(24,139,99,.18),0 12rpx 28rpx rgba(8,77,54,.3)}.todo-voice-fab::after{border:0}.todo-voice-fab:active{transform:scale(.94)}.todo-voice-fab.playing{background:linear-gradient(145deg,#f0a14a,#d56d3d);box-shadow:0 0 0 8rpx rgba(224,126,63,.18),0 12rpx 28rpx rgba(117,57,27,.28);animation:todo-voice-pulse 1.25s ease-in-out infinite}.todo-mic{position:relative;width:40rpx;height:48rpx}.todo-mic-head{position:absolute;top:0;left:10rpx;width:20rpx;height:29rpx;box-sizing:border-box;border:4rpx solid #fff;border-radius:12rpx}.todo-mic-arc{position:absolute;top:11rpx;left:4rpx;width:32rpx;height:27rpx;box-sizing:border-box;border:4rpx solid #fff;border-top:0;border-radius:0 0 19rpx 19rpx}.todo-mic-stem{position:absolute;left:18rpx;bottom:1rpx;width:4rpx;height:12rpx;border-radius:4rpx;background:#fff}.todo-mic-stem::after{position:absolute;left:-8rpx;bottom:0;width:20rpx;height:4rpx;border-radius:4rpx;background:#fff;content:""}.todo-stop{width:25rpx;height:25rpx;border-radius:6rpx;background:#fff}@keyframes todo-voice-pulse{0%,100%{box-shadow:0 0 0 8rpx rgba(224,126,63,.16),0 12rpx 28rpx rgba(117,57,27,.25)}50%{box-shadow:0 0 0 15rpx rgba(224,126,63,.08),0 12rpx 34rpx rgba(117,57,27,.34)}}

<view class="page">
  <view class="header" style="padding-top:{{statusBarHeight}}px;">
    <view class="nav-inner" style="padding-right: {{capsuleSafeRight}}px">
      <view class="back-btn" bindtap="onBack"><text class="back-icon">&lt;</text></view>
      <view class="nav-right"></view>
    </view>

    <view wx:if="{{pest.name}}" class="pest-hero">
      <view class="pest-icon-wrap"><text class="pest-icon">{{pest.icon || '🌿'}}</text></view>
      <view class="pest-info">
        <text class="pest-name">{{pest.name}}</text>
        <view class="pest-badges"><view class="pest-type-badge"><text class="pest-type-text">{{pest.type}}</text></view></view>
      </view>
    </view>
  </view>

  <scroll-view class="scroll-body" scroll-y>
    <view wx:if="{{loading}}" class="detail-state">正在加载...</view>
    <view wx:elif="{{errorText}}" class="detail-state detail-state-error" bindtap="onRetry">{{errorText}}，点击重试</view>
    <block wx:else>
      <image wx:if="{{pest.coverUrl}}" class="pest-cover" src="{{pest.coverUrl}}" mode="aspectFill"></image>
      <view class="card">
        <text class="card-title">{{copy.descTitle}}</text>
        <text class="desc-text">{{pest.summary}}</text>
      </view>

      <view wx:if="{{pest.symptoms.length}}" class="card">
        <text class="card-title">{{copy.symptomTitle}}</text>
        <view wx:for="{{pest.symptoms}}" wx:key="*this" class="treatment-item">
          <view class="treatment-num-wrap"><text class="treatment-num">{{index + 1}}</text></view>
          <view class="treatment-content"><text class="treatment-desc">{{item}}</text></view>
        </view>
      </view>

      <view class="card"><text class="card-title">{{copy.treatmentTitle}}</text><text class="desc-text">{{pest.treatmentAdvice}}</text></view>

      <view wx:if="{{pest.medicationWarning}}" class="card warning-card">
        <text class="card-title">{{copy.warningTitle}}</text><text class="desc-text">{{pest.medicationWarning}}</text>
      </view>

      <view wx:if="{{pest.sourceName || pest.sourceUrl}}" class="card source-card">
        <text class="card-title">{{copy.sourceTitle}}</text><text class="desc-text">{{pest.sourceName || pest.sourceUrl}}</text>
      </view>
    </block>
    <view class="bottom-gap"></view>
  </scroll-view>
</view>

<view class="page">
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-inner" style="padding-right: {{capsuleSafeRight}}px;">
      <view class="back-btn cm-back-btn" bindtap="onBack"><text class="back-icon cm-back-text">‹</text></view>
      <text class="nav-title">{{copy.title}}</text>
      <view class="nav-right"></view>
    </view>
  </view>

  <scroll-view class="scroll-body" scroll-y scroll-top="{{scrollTop}}">
    <view class="hero-card">
      <image class="hero-photo" src="/images/cotton-seedling-inspection-v1.jpg" mode="aspectFill"></image>
      <view class="hero-wash"></view>
      <view class="hero-leaf hero-leaf-one"></view>
      <view class="hero-leaf hero-leaf-two"></view>
      <view class="hero-content">
        <view class="ai-badge"><text class="ai-leaf">◆</text><text>{{copy.aiBadge}}</text></view>
        <text class="hero-title">{{copy.recognize}}</text>
        <text class="hero-sub">{{copy.recognizeSub}}</text>
        <view class="hero-actions">
          <view class="hero-action primary" bindtap="onTakePhoto">
            <view class="camera-icon"><view class="camera-lens"></view></view><text>{{copy.cameraAction}}</text>
          </view>
          <view class="hero-action secondary" bindtap="onChooseAlbum">
            <view class="album-icon"><view class="album-sun"></view><view class="album-mountain"></view></view><text>{{copy.album}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="history-panel">
      <view class="panel-heading">
        <view class="heading-main"><view class="heading-icon history-icon">↶</view><text>{{copy.history}}</text></view>
        <view class="heading-link" bindtap="onHistory"><text>{{copy.viewAll}}</text><text class="heading-arrow">›</text></view>
      </view>
      <view wx:if="{{!recentHistory.length}}" class="history-empty" bindtap="onTakePhoto">
        <view class="empty-art"><view class="empty-paper"><view></view><view></view><view></view></view><view class="empty-clock">⌞</view></view>
        <text class="empty-title">{{copy.noHistoryShort}}</text><text class="empty-sub">{{copy.emptyHistoryHint}}</text>
      </view>
      <scroll-view wx:else class="history-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="history-row">
          <view wx:for="{{recentHistory}}" wx:key="id" class="history-card" bindtap="onHistoryTap" data-id="{{item.id}}">
            <image class="history-image" src="{{item.image}}" mode="aspectFill"></image>
            <view class="history-body"><text class="history-name">{{item.title}}</text><text class="history-summary">{{item.summary}}</text><view class="history-tags"><text class="history-tag">{{item.displayCategory}}</text><text class="history-tag history-tag-warn">{{item.displaySeverity}}</text></view></view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="library-heading">
      <view class="heading-main"><view class="heading-icon leaf-icon">◆</view><text>{{copy.library}}</text></view>
      <view class="heading-link" bindtap="onMorePests"><text>{{copy.viewMore}}</text><text class="heading-arrow">›</text></view>
    </view>
    <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-row"><view wx:for="{{filters}}" wx:key="*this" class="filter-tag {{filter === item ? 'filter-tag-active' : ''}}" bindtap="onFilterTap" data-val="{{item}}"><text>{{item}}</text></view></view>
    </scroll-view>

    <view wx:if="{{knowledgeLoading}}" class="knowledge-state">正在加载病虫害知识...</view>
    <view wx:elif="{{knowledgeError}}" class="knowledge-state knowledge-state-error" bindtap="onRetryKnowledge">{{knowledgeError}}，点击重试</view>
    <view wx:elif="{{!filteredPests.length}}" class="knowledge-state">暂无已发布病虫害知识，请等待管理员发布</view>
    <view wx:else class="pest-grid">
      <view wx:for="{{filteredPests}}" wx:key="id" class="pest-card" bindtap="onPestTap" data-id="{{item.id}}">
        <view class="pest-cover"><image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill"></image><view wx:else class="cover-fallback {{item.bg}}"><text>{{item.icon}}</text><view class="fallback-ring"></view></view></view>
        <view class="pest-card-body"><view class="pest-title-row"><text class="pest-name">{{item.n}}</text><view class="card-arrow">›</view></view><text class="pest-type {{item.tagClass}}">{{item.type}}</text><text class="pest-summary">{{item.summary}}</text></view>
      </view>
    </view>
    <view class="bottom-gap"></view>
  </scroll-view>
</view>

.page{min-height:100vh;background:#f4f7f3;color:#1c352d}.head{padding:94rpx 30rpx 34rpx;background:linear-gradient(145deg,#0c654a,#178461);color:#fff;border-radius:0 0 38rpx 38rpx}.nav{display:grid;grid-template-columns:90rpx 1fr 120rpx;align-items:center}.nav button{margin:0;padding:0;width:66rpx;line-height:60rpx;background:rgba(255,255,255,.14);color:#fff;border-radius:50%;font-size:46rpx}.nav view{display:flex;flex-direction:column;text-align:center}.nav strong{font-size:34rpx}.nav small{font-size:18rpx;letter-spacing:4rpx;opacity:.7}.nav>text{font-size:20rpx;text-align:right;opacity:.8}.feature{position:relative;margin:30rpx;height:330rpx;border-radius:28rpx;overflow:hidden}.feature image{width:100%;height:100%}.feature:after{content:'';position:absolute;inset:0;background:linear-gradient(transparent,rgba(5,28,19,.82))}.feature view{position:absolute;z-index:1;left:28rpx;right:28rpx;bottom:28rpx;display:flex;flex-direction:column;gap:10rpx;color:#fff}.feature label{width:max-content;background:#d7a741;padding:5rpx 14rpx;border-radius:8rpx;font-size:20rpx}.feature strong{font-size:31rpx;line-height:1.4}.tabs{white-space:nowrap;padding:0 26rpx;box-sizing:border-box}.tabs button{display:inline-block;margin-right:14rpx;background:#fff;color:#637069;border-radius:30rpx;font-size:23rpx;line-height:58rpx}.tabs .on{background:#177352;color:#fff}.list{margin:22rpx 28rpx;background:#fff;border-radius:28rpx;padding:0 25rpx}.article{display:grid;grid-template-columns:1fr 190rpx;gap:22rpx;padding:26rpx 0;border-bottom:1rpx solid #edf0ed}.article:last-child{border-bottom:0}.article>view{display:flex;flex-direction:column;gap:11rpx}.article label{font-size:20rpx;color:#177352}.article strong{font-size:27rpx;line-height:1.45}.article small{font-size:20rpx;color:#929a96}.article image{width:190rpx;height:140rpx;border-radius:17rpx}

.nav{display:flex;flex-direction:row}.nav button{flex-shrink:0;margin-right:24rpx}.nav view{flex:1;min-width:0}.nav>text{width:120rpx;flex-shrink:0}.article{display:flex;flex-direction:row;align-items:center;gap:0}.article>view{flex:1;min-width:0;margin-right:22rpx}.article image{flex-shrink:0}

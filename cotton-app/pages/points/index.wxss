.page { height: 100vh; display: flex; flex-direction: column; background: #F3F6F1; }
.nav { flex-shrink: 0; min-height: 88rpx; padding-left: 28rpx; padding-bottom: 18rpx; display: flex; align-items: center; background: #FFFFFF; border-bottom: 1rpx solid #E1E8DF; box-sizing: content-box; }
.back, .nav-space { width: 64rpx; height: 64rpx; }
.back { display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #EEF3EC; color: #1D3023; font-size: 44rpx; }
.nav-title { flex: 1; text-align: center; color: #17251B; font-size: 34rpx; font-weight: 800; }
.content { flex: 1; height: 0; }
.balance-panel { margin: 24rpx 28rpx 0; padding: 34rpx 32rpx 28rpx; border-radius: 16rpx; color: #FFFFFF; background: #1F6A43; box-shadow: 0 12rpx 30rpx rgba(29, 78, 50, .18); }
.balance-label, .balance-yuan { display: block; color: rgba(255,255,255,.78); font-size: 24rpx; }
.balance-value { display: block; margin: 8rpx 0 4rpx; font-size: 76rpx; line-height: 1; font-weight: 800; }
.balance-stats { margin-top: 28rpx; padding-top: 22rpx; display: flex; border-top: 1rpx solid rgba(255,255,255,.22); }
.balance-stats view { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.balance-stats view + view { padding-left: 24rpx; border-left: 1rpx solid rgba(255,255,255,.2); }
.balance-stats text:first-child { font-size: 30rpx; font-weight: 700; }
.balance-stats text:last-child { color: rgba(255,255,255,.7); font-size: 20rpx; }
.actions { margin: 20rpx 28rpx 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.action { min-width: 0; padding: 24rpx; display: flex; flex-direction: column; gap: 7rpx; border: 1rpx solid #DCE6DA; border-radius: 12rpx; background: #FFFFFF; color: #748078; font-size: 21rpx; }
.action.primary { border-color: #BFD7C6; background: #EAF4EC; }
.action-title { color: #203127; font-size: 27rpx; font-weight: 700; }
.rules, .ledger { margin: 20rpx 28rpx 0; padding: 28rpx; border-radius: 14rpx; background: #FFFFFF; border: 1rpx solid #E1E8DF; }
.section-title { display: block; margin-bottom: 18rpx; color: #17251B; font-size: 30rpx; font-weight: 800; }
.rule-row { min-height: 58rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid #EDF1EB; font-size: 23rpx; }
.rule-row text:first-child { color: #748078; }
.rule-row text:last-child { color: #26382C; text-align: right; font-weight: 600; }
.rule-note { display: block; margin-top: 18rpx; color: #6D786F; font-size: 21rpx; line-height: 1.6; }
.ledger-row { min-height: 110rpx; padding: 18rpx 0; display: flex; align-items: center; gap: 18rpx; border-bottom: 1rpx solid #EDF1EB; }
.ledger-row:last-child { border-bottom: 0; }
.ledger-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 5rpx; }
.ledger-title { color: #203127; font-size: 25rpx; font-weight: 700; }
.ledger-desc { overflow: hidden; color: #707B73; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.ledger-time { color: #A0A8A1; font-size: 19rpx; }
.ledger-points { flex-shrink: 0; font-size: 30rpx; font-weight: 800; }
.ledger-points.plus { color: #2F7D4A; }
.ledger-points.minus { color: #A85B32; }
.empty { padding: 36rpx 0; color: #89928B; font-size: 23rpx; text-align: center; }
.bottom-safe { height: calc(30rpx + env(safe-area-inset-bottom)); }
